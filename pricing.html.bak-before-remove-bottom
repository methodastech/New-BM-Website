<!-- mobile slider dots for each package grid -->
<script id="pgrid-dots-js">
(function(){
  function build(){
    document.querySelectorAll('#pg-pricing .price-grid').forEach(function(grid){
      var cards=grid.querySelectorAll('.ptier');
      if(cards.length<2 || grid.dataset.dots) return;
      grid.dataset.dots='1';
      var dots=document.createElement('div'); dots.className='pgrid-dots';
      cards.forEach(function(c,i){
        var b=document.createElement('button'); b.type='button';
        b.setAttribute('aria-label','Show package '+(i+1)+' of '+cards.length);
        if(i===0) b.className='on';
        b.addEventListener('click',function(){
          var stride=cards.length>1?(cards[1].offsetLeft-cards[0].offsetLeft):grid.clientWidth;
          grid.scrollTo({left:i*stride,behavior:'smooth'});
        });
        dots.appendChild(b);
      });
      grid.parentNode.insertBefore(dots, grid.nextSibling);
      var ticking=false;
      grid.addEventListener('scroll',function(){
        if(ticking) return; ticking=true;
        requestAnimationFrame(function(){
          ticking=false;
          var stride=cards.length>1?(cards[1].offsetLeft-cards[0].offsetLeft):grid.clientWidth;
          var idx=Math.max(0,Math.min(cards.length-1,Math.round(grid.scrollLeft/stride)));
          dots.querySelectorAll('button').forEach(function(d,i){ d.classList.toggle('on', i===idx); });
        });
      },{passive:true});
    });
  }
  if(document.readyState!=='loading')build(); else document.addEventListener('DOMContentLoaded',build);
})();
</script>

