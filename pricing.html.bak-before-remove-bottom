    var hint=document.getElementById('fbStarHint');
    stars.forEach(function(b){b.addEventListener('click',function(){rating=+b.getAttribute('data-v');stars.forEach(function(s){s.classList.toggle('on',(+s.getAttribute('data-v'))<=rating)});if(hint)hint.textContent='Rated '+rating+' / 5';});});
    f.querySelectorAll('.fbk-chips button').forEach(function(c){c.addEventListener('click',function(){c.classList.toggle('on');});});
    function val(n){var e=f.querySelector('[name='+n+']');return e?e.value.trim():'';}
    function collect(){
      var chips=[].map.call(f.querySelectorAll('.fbk-chips button.on'),function(c){return c.textContent.trim();});
