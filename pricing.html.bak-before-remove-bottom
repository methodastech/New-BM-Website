  });});
}
if(document.readyState!=='loading')initProc6(); else document.addEventListener('DOMContentLoaded',initProc6);
})();

/* ---- Brand Journey roadmap (replaces the proc6 rail with stops) ---- */
(function(){
  function build(){
    var rail=document.querySelector('.proc6-rail');
    if(!rail||document.querySelector('.p6road'))return;
    var tabs=[].slice.call(rail.querySelectorAll('.proc6-tab'));
    if(!tabs.length)return;
    var road=document.createElement('div'); road.className='p6road';
