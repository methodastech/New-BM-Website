<script>
(function(){
  var f=document.getElementById('bmSvcFrame');
  if(!f) return;
  var NORMAL='width:100%;border:0;display:block;min-height:640px';
  var PINNED='position:fixed;top:0;left:0;width:100vw;height:100vh;border:0;display:block;z-index:2147483647;background:transparent';
  // overlay/modal elements that toggle display:none <-> visible when opened inside the iframe
  var SEL='#jm-shell,#pm-overlay,#tn-overlay,#drawer-overlay,.fcv-veil,.pdx-ov';
  var pinned=false;
  function idoc(){ try{ return f.contentWindow && f.contentWindow.document; }catch(e){ return null; } }
  function contentH(d){
    // true content bottom, ignoring fixed/absolute overlays (drawer, modals, fcv viewer)
    var win=d.defaultView, sy=win.scrollY||win.pageYOffset||0, kids=d.body.children, max=0;
    for(var i=0;i<kids.length;i++){
      var el=kids[i], cs=win.getComputedStyle(el);
      if(cs.position==='fixed'||cs.position==='absolute'||cs.display==='none') continue;
      var b=el.getBoundingClientRect().bottom+sy;
      if(b>max) max=b;
    }
    return Math.ceil(max);
  }
  function fit(){
    if(pinned) return;
    var d=idoc(); if(!d||!d.body) return;
    var h=contentH(d);
    if(h>40 && Math.abs(h-parseInt(f.style.height||0,10))>2) f.style.height=h+'px';
  }
  function anyOpen(){
    var d=idoc(); if(!d) return false;
    var els=d.querySelectorAll(SEL), win=d.defaultView;
    for(var i=0;i<els.length;i++){
      var s=win.getComputedStyle(els[i]);
      if(s.display!=='none' && s.visibility!=='hidden' && parseFloat(s.opacity||'1')>0.02){
        var r=els[i].getBoundingClientRect();
        if(r.width>4 && r.height>4) return true;
      }
    }
    return false;
  }
  function pin(){ if(pinned) return; pinned=true; var sec=f.parentNode; if(sec) sec.style.height=f.offsetHeight+'px'; f.style.cssText=PINNED; }
  function unpin(){ if(!pinned) return; pinned=false; f.style.cssText=NORMAL; var sec=f.parentNode; if(sec) sec.style.height=''; fit(); }
  function tick(){ if(anyOpen()) pin(); else { unpin(); fit(); } }
  f.addEventListener('load',function(){fit();setTimeout(fit,250);setTimeout(fit,800);setTimeout(fit,1800);});
  window.addEventListener('resize',fit);
  setInterval(tick,250);
})();
</script>
