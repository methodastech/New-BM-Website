  if(!('IntersectionObserver' in window)){
    scope.querySelectorAll('.rv').forEach(function(el){el.classList.add('in');});
    return;
  }
  var rio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');rio.unobserve(e.target);}});},{threshold:.12,rootMargin:'0px 0px -7% 0px'});
  function observe(){scope.querySelectorAll('.rv:not(.in)').forEach(function(el){rio.observe(el);});}
  if(document.readyState!=='loading')observe(); else document.addEventListener('DOMContentLoaded',observe);
  /* re-scan after the DOM-mutating widgets below have run */
  window.addEventListener('load',observe);
