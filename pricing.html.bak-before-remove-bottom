<style>
/* ============================================================
   Details & Pricing — ported verbatim from brandmethod_site_v62.html
   Scoped variables so the v62 look is preserved on this page.
   ============================================================ */
:root{--border-2:rgba(0,0,0,.16);--ghost-grey:#ffffff;--accent:#1a26de;--accent-light:#4444ff;--accent-dark:#0000aa;--white:#0f0f0f;--off-white:#222222;--muted:#474747}
/* Match v62 typography (Fraunces display, Inter body, JetBrains mono) for the whole
   pricing page — scoped to #pg-pricing so the shared site nav keeps its own fonts. */
#pg-pricing{--font-display:'Fraunces',Georgia,serif;--font-body:'Inter',sans-serif;--font-sans:'Inter',sans-serif;--font-mono:'JetBrains Mono',ui-monospace,monospace;font-optical-sizing:auto}
#pg-pricing .amp{font-family:'EB Garamond','Georgia',serif}
body.services-overview-page{background:#ffffff}
.services-overview-page .page-wrap{position:relative}
.section-inner{width:min(var(--max-w),calc(100% - 40px));max-width:var(--max-w);margin:0 auto}

/* ===== base: page hero ===== */
.page-hero{position:relative;overflow:hidden;background:linear-gradient(180deg,#ffffff 0%,#f6f7ff 100%);padding:clamp(44px,7vh,84px) 0 clamp(30px,5vh,50px)}
.page-hero-grid{position:absolute;inset:0;z-index:0;pointer-events:none;background-image:radial-gradient(circle at center,rgba(26,38,222,.07) 1px,transparent 1.6px);background-size:24px 24px;-webkit-mask-image:linear-gradient(180deg,#000 0%,rgba(0,0,0,.55) 46%,transparent 92%);mask-image:linear-gradient(180deg,#000 0%,rgba(0,0,0,.55) 46%,transparent 92%)}
.page-hero-glow{position:absolute;left:0;right:0;top:0;height:130%;background:radial-gradient(120% 75% at 50% -10%,rgba(26,38,222,.11),rgba(26,38,222,.04) 38%,transparent 62%);z-index:0;pointer-events:none}
.page-hero-inner{position:relative;z-index:2}
.ph-photo{display:none}
.ph-eyebrow{display:inline-flex;align-items:center;gap:11px;font-family:var(--font-mono);font-size:10.5px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--white);margin-bottom:26px}
.ph-eyebrow .s{font-size:0;line-height:0;display:inline-flex}.ph-eyebrow .s::before{content:'';display:block;width:8px;height:8px;background:var(--accent)}.ph-eyebrow .rule{width:42px;height:1px;background:var(--accent)}
.ph-h1{font-family:var(--font-display);font-weight:400;font-size:clamp(46px,7vw,104px);line-height:.95;letter-spacing:-.02em;margin-bottom:28px;max-width:16ch}
.ph-h1 em{font-style:italic;font-weight:500;color:var(--accent)}
/* override the site-wide .page-hero h1 rules (more specific than .ph-h1) so the hero
   matches v62: lighter weight + blue italic "No surprises." */
#pg-pricing .page-hero h1{font-family:var(--font-display);font-weight:400}
#pg-pricing .page-hero h1 em{font-style:italic;font-weight:500;color:var(--accent)}
.ph-lead{font-family:var(--font-body);font-size:clamp(15px,1.4vw,19px);color:var(--muted);max-width:60ch;line-height:1.75}
.ph-lead b{color:var(--white);font-weight:700}
.amp{font-family:var(--font-display);font-style:normal;font-weight:500;font-size:.92em;letter-spacing:0}

/* ===== base: section heads (eyebrows hidden, matching v62) ===== */
.section-tag,.ph-eyebrow{display:none !important}
.section-tag .s{font-size:0;line-height:0;display:inline-flex}.section-tag .s::before{content:'';display:block;width:8px;height:8px;background:var(--accent)}
.section-title{font-family:var(--font-display);font-size:clamp(34px,5vw,62px);font-weight:400;line-height:1.08;letter-spacing:-.02em;margin-bottom:20px;max-width:20ch}
.section-title em{font-style:italic;color:var(--accent)}
.section-sub{font-family:var(--font-body);font-size:16px;color:var(--off-white);max-width:560px;line-height:1.8}

/* ===== base: buttons ===== */
.btn-primary{position:relative;overflow:hidden;font-family:var(--font-mono);font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;padding:18px 28px;background:var(--accent);color:#fff;display:inline-flex;border:0;cursor:pointer;transition:transform .2s var(--ease);text-decoration:none}
.btn-primary span{position:relative;z-index:1;display:inline-flex;align-items:center;gap:10px}
.btn-primary .arr{transition:transform .25s var(--ease)}
.btn-primary::before{content:"";position:absolute;inset:0;background:var(--accent-light);transform:translateX(-101%);transition:transform .35s var(--ease)}
.btn-primary:hover{transform:translateY(-2px)}.btn-primary:hover::before{transform:translateX(0)}.btn-primary:hover .arr{transform:translateX(4px)}

/* ===== base: reveal ===== */
.rv{opacity:0;transform:translateY(22px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.rv.in{opacity:1;transform:none}

/* ===== base: pricing tiers ===== */
.pr-sec{position:relative}
.price-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.price-grid.g2{grid-template-columns:repeat(2,1fr);max-width:560px}
.ptier{position:relative;border:1px solid var(--border);background:#fff;padding:24px 20px 22px;display:flex;flex-direction:column;transition:transform .25s var(--ease),box-shadow .25s var(--ease),border-color .25s}
.ptier:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(30,40,120,.06)}
.ptier.pop{border-color:var(--accent);box-shadow:0 18px 44px rgba(43,91,255,.14)}
.ptier-badge{position:absolute;top:-10px;left:18px;font-family:var(--font-mono);font-size:8.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;background:var(--accent);color:#fff;padding:5px 11px}
.ptier-name{font-family:var(--font-display);font-size:23px;font-weight:500;margin-bottom:2px}
.ptier-tag{font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.ptier-price{font-family:var(--font-display);font-size:38px;font-weight:500;line-height:1;letter-spacing:-.01em}
.ptier-price .cur{font-size:16px;color:var(--muted);margin-right:3px;letter-spacing:.04em}
.ptier-price .per{font-size:14px;color:var(--muted)}
.ptier-from{font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;margin-top:7px}
.ptier-inc{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:11px}
.ptier-inc li{display:flex;gap:10px;align-items:flex-start;font-family:var(--font-body);font-size:14.5px;color:var(--off-white);line-height:1.5}
.ptier-inc li svg{width:16px;height:16px;flex-shrink:0;margin-top:2px;stroke:var(--accent);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.ptier.pop .ptier-inc li svg{stroke:var(--accent)}

/* ===== base: tabbed pricing ===== */
.ptabs{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:clamp(22px,3vw,32px) 0 clamp(26px,3.5vw,38px)}
.ptab{font-family:var(--font-mono);font-size:10.5px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;padding:11px 18px;border:1px solid var(--border);background:#fff;color:var(--muted);cursor:pointer;transition:background .22s,color .22s,border-color .22s}
.ptab:hover{color:var(--off-white);border-color:var(--off-white)}
.ptab.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.ptab-panel{display:none}
.ptab-panel.active{display:block;animation:ptabIn .4s var(--ease)}
@keyframes ptabIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.ptab-sub{text-align:center;font-family:var(--font-body);font-size:13.5px;color:var(--muted);margin:-12px 0 26px}
@media(max-width:980px){.price-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.price-grid,.price-grid.g2{grid-template-columns:1fr;max-width:none}}

/* ===== base: trigger framework legend ===== */
.trig-legend{display:flex;flex-wrap:wrap;gap:16px;margin:22px 0 30px}
.trig-leg{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.trig-leg i{width:9px;height:9px;transform:rotate(45deg);background:var(--lc)}
/* ===== base: trigger accordion ===== */
.trig-acc{max-width:1080px;margin:clamp(26px,3.5vw,42px) auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}@media(max-width:900px){.trig-acc{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.trig-acc{grid-template-columns:1fr}}
.trig-acc-item{--tc:#3a55e8;background:#fff;border:0;box-shadow:0 2px 12px rgba(20,28,80,.05);padding:24px 22px 26px;display:flex;flex-direction:column;align-items:flex-start;transition:transform .35s var(--ease),box-shadow .35s}.trig-ico{width:34px;height:34px;color:var(--tc);margin-bottom:13px}.trig-ico svg{width:34px;height:34px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;display:block}.trig-acc-meta{display:flex;align-items:center;gap:10px;margin-bottom:9px}.trig-acc-d{font-family:var(--font-body);font-size:12.5px;line-height:1.6;color:var(--muted);margin:0}
.trig-acc-item:hover{transform:translateY(-4px);box-shadow:0 16px 38px color-mix(in srgb,var(--tc) 13%,rgba(20,28,80,.06))}
.trig-acc-num{font-family:var(--font-mono);font-size:12px;color:var(--tc);font-weight:600;min-width:20px}
.trig-acc-title{font-family:var(--font-display);font-size:clamp(16px,1.7vw,19px);font-weight:400;letter-spacing:-.01em;margin:0 0 8px;line-height:1.18;color:var(--white)}
.trig-acc-tag{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--tc);border:1px solid color-mix(in srgb,var(--tc) 42%,transparent);padding:4px 10px;border-radius:0;white-space:nowrap}
@media(max-width:560px){.trig-acc-tag{display:none}.trig-acc-title{font-size:15.5px}}

/* ===== cta-band (closing) ===== */
.cta-band{background:#fff;color:var(--white);padding:clamp(80px,10vw,124px) 20px;text-align:center;position:relative;overflow:hidden}.cta-band::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(10,14,30,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(10,14,30,.028) 1px,transparent 1px);background-size:54px 54px;-webkit-mask-image:radial-gradient(125% 95% at 50% 48%,#000 38%,transparent 80%);mask-image:radial-gradient(125% 95% at 50% 48%,#000 38%,transparent 80%);pointer-events:none;z-index:0}.cta-band .section-inner{position:relative;z-index:1}.cta-band .section-title{color:var(--white);font-size:clamp(34px,5vw,60px);margin:0 auto 26px;max-width:20ch}.cta-band .section-title em{color:var(--accent)}.cta-band p{font-family:var(--font-body);font-size:16px;color:var(--muted);margin:0 auto 26px;max-width:560px;line-height:1.8}
.btn-dark{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:18px 28px;background:var(--accent);color:#fff;border:0;cursor:pointer;text-decoration:none;transition:transform .2s var(--ease),box-shadow .25s}
.btn-dark:hover{transform:translateY(-2px);box-shadow:0 16px 32px -16px color-mix(in srgb,var(--accent) 56%,transparent)}

/* mobile compactness */
@media (max-width:640px){.pr-sec{padding:40px 0}.page-hero{padding:36px 0 26px}.section-title{font-size:clamp(27px,8.4vw,36px)!important;line-height:1.08}.section-sub{font-size:13.5px;line-height:1.55;margin-top:9px}.ph-h1{font-size:clamp(33px,10vw,46px);line-height:1.06}.ph-lead{font-size:14px;line-height:1.55}.price-grid,.price-grid.g2{gap:12px}.ptier{padding:20px 18px}}
@media (max-width:430px){.section-title{font-size:clamp(25px,8.6vw,32px)!important}}

/* ===== idle micro-animation icons (svc placeholder, shared keyframes) ===== */
@keyframes bmTwinkle{0%,100%{opacity:.25;transform:scale(.65)}50%{opacity:1;transform:scale(1)}}
@keyframes bmCore{0%,100%{opacity:.5;transform:scale(.94)}50%{opacity:1;transform:scale(1.08)}}
@keyframes bmSpark{0%,100%{opacity:.4;transform:scale(.8)}45%{opacity:1;transform:scale(1.15)}}

/* ============================================================
   bm-refine: pricing component CSS (verbatim)
   ============================================================ */
.rv{transform:translateY(15px)!important;transition:opacity 1.05s cubic-bezier(.16,1,.3,1),transform 1.05s cubic-bezier(.16,1,.3,1)!important}
.rv.in{transform:none!important}
.rv.d1{transition-delay:.12s!important}.rv.d2{transition-delay:.22s!important}.rv.d3{transition-delay:.34s!important}.rv.d4{transition-delay:.46s!important}
.ph-h1.rv{filter:blur(11px);transition:opacity 1.15s cubic-bezier(.16,1,.3,1),transform 1.15s cubic-bezier(.16,1,.3,1),filter 1.15s cubic-bezier(.16,1,.3,1)!important}
.ph-h1.rv.in{filter:blur(0)}
.ph-eyebrow.rv,.ph-lead.rv{transition:opacity 1.05s cubic-bezier(.16,1,.3,1),transform 1.05s cubic-bezier(.16,1,.3,1)!important}

.ptier-badge{display:none!important}
.ptab[data-ptab="0"]{--pc:#3a55e8}.ptab[data-ptab="1"]{--pc:#0fa67a}.ptab[data-ptab="2"]{--pc:#d63a7e}.ptab[data-ptab="3"]{--pc:#dca215}.ptab[data-ptab="4"]{--pc:#7a4ee8}.ptab[data-ptab="5"]{--pc:#0891b2}
.ptab-panel[data-ppanel="0"]{--pc:#3a55e8}.ptab-panel[data-ppanel="1"]{--pc:#0fa67a}.ptab-panel[data-ppanel="2"]{--pc:#d63a7e}.ptab-panel[data-ppanel="3"]{--pc:#dca215}.ptab-panel[data-ppanel="4"]{--pc:#7a4ee8}.ptab-panel[data-ppanel="5"]{--pc:#0891b2}
.ptab.active{background:var(--pc,var(--accent))!important;border-color:var(--pc,var(--accent))!important;color:#fff!important}
.ptab:hover:not(.active){border-color:color-mix(in srgb,var(--pc,var(--accent)) 50%,var(--border))!important;color:color-mix(in srgb,var(--pc,var(--accent)) 85%,var(--muted))!important}
.ptier{--tc:var(--pc,var(--c,var(--accent)));border-top:2px solid var(--tc)!important}
.ptier-inc{flex:1 1 auto}
.ptier-inc li svg,.ptier.pop .ptier-inc li svg{stroke:var(--tc)!important}
.ptier-price .cur{color:var(--tc)!important}
.ptier-cta{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:20px;font-family:var(--font-mono);font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:12px 16px;background:color-mix(in srgb,var(--tc) 8%,#fff);color:var(--tc);border:1px solid color-mix(in srgb,var(--tc) 28%,transparent);cursor:pointer;text-decoration:none;transition:background .25s var(--ease),color .25s var(--ease),border-color .25s var(--ease)}
.ptier-cta svg{width:14px;height:14px;transition:transform .25s var(--ease)}
.ptier-cta:hover{background:var(--tc);color:#fff;border-color:var(--tc)}
.pg,.svc-hero,.hero{overflow-x:clip}

/* comparison + real cost + FAQ */
.cmp-wrap{margin-top:42px;overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--border)}
.cmp-table{width:100%;min-width:680px;border-collapse:collapse;font-family:var(--font-body);background:#fff}
.cmp-table th,.cmp-table td{padding:14px 18px;text-align:left;font-size:13px;border-bottom:1px solid var(--border);vertical-align:top}
.cmp-table thead th{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:600;border-bottom:2px solid var(--border-2);white-space:nowrap}
.cmp-table thead th.cmp-bm{color:var(--accent)}
/* old .cmp-table comparison design removed; replaced by the v88 .cmp grid (see #cmp-css). */
.cmp-table td.cmp-bm{background:color-mix(in srgb,var(--accent) 6%,#fff);color:#0a1024;font-weight:600;border-left:1px solid color-mix(in srgb,var(--accent) 16%,transparent);border-right:1px solid color-mix(in srgb,var(--accent) 16%,transparent)}
.cmp-table thead th.cmp-bm{background:color-mix(in srgb,var(--accent) 10%,#fff);border-top:2px solid var(--accent)}
.cmp-table tbody tr:last-child td{border-bottom:none}
.cmp-table td:not(.cmp-feat):not(.cmp-bm){color:var(--muted)}
.cmp-hint{margin-top:14px;font-family:var(--font-mono);font-size:10px;letter-spacing:.06em;color:var(--muted);text-align:center}
@media(min-width:721px){.cmp-hint{display:none}}

.rcost-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:44px}
.rcost{border:1px solid var(--border);background:#fff;overflow:hidden;display:flex;flex-direction:column}
.rcost-bad{padding:26px 26px 22px;border-bottom:1px solid var(--border)}
.rcost-good{padding:24px 26px 26px;background:color-mix(in srgb,var(--accent) 5%,#fff);flex:1}
.rcost-lab{display:inline-block;font-family:var(--font-mono);font-size:9.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:10px}
.rcost-bad .rcost-lab{color:#c0506a}
.rcost-good .rcost-lab{color:var(--accent)}
.rcost h4{font-family:var(--font-display);font-size:19px;font-weight:500;margin:0 0 8px;color:#0a1024;line-height:1.2}
.rcost p{font-family:var(--font-body);font-size:13px;line-height:1.6;color:var(--muted);margin:0}
@media(max-width:720px){.rcost-grid{grid-template-columns:1fr}}

.faq-list{margin-top:42px;max-width:880px}
.faq-item{border-bottom:1px solid var(--border)}
.faq-item summary{list-style:none;cursor:pointer;padding:22px 46px 22px 2px;position:relative;font-family:var(--font-display);font-size:18px;font-weight:500;color:#0a1024;transition:color .2s;line-height:1.3}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary:hover{color:var(--accent)}
.faq-ico{position:absolute;right:6px;top:26px;width:18px;height:18px}
.faq-ico::before,.faq-ico::after{content:"";position:absolute;background:var(--accent);left:50%;top:50%}
.faq-ico::before{width:14px;height:2px;transform:translate(-50%,-50%)}
.faq-ico::after{width:2px;height:14px;transform:translate(-50%,-50%);transition:opacity .3s var(--ease),transform .3s var(--ease)}
.faq-item[open] .faq-ico::after{opacity:0;transform:translate(-50%,-50%) rotate(90deg)}
.faq-a{padding:0 46px 24px 2px;font-family:var(--font-body);font-size:14px;line-height:1.72;color:var(--muted)}
.faq-a p{margin:0}
.faq-item[open] .faq-a{animation:faqIn .4s var(--ease)}
@keyframes faqIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}

/* 6-Phase process explorer */
