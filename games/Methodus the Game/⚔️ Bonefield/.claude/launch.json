{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "python-static-server",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8001"],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "npx-serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3000", "."],
      "port": 3000
    }
  ]
}
