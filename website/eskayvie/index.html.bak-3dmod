<script>
const REDUCE=matchMedia('(prefers-reduced-motion: reduce)').matches;
// header shadow on scroll
const hdr=document.getElementById('hdr');
addEventListener('scroll',()=>hdr.classList.toggle('scrolled',scrollY>10),{passive:true});

// mobile menu
const mm=document.getElementById('mmenu');
const mtoggle=document.getElementById('mtoggle');
mtoggle.onclick=()=>{mm.classList.add('open');mtoggle.setAttribute('aria-expanded','true');};
document.getElementById('mclose').onclick=()=>{mm.classList.remove('open');mtoggle.setAttribute('aria-expanded','false');};
mm.querySelectorAll('a').forEach(a=>a.onclick=()=>{mm.classList.remove('open');mtoggle.setAttribute('aria-expanded','false');});

// reveal on scroll
const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}})},{threshold:.14});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// fill gold-star rating placeholders
const STAR='<svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>';
// duplicate each testimonial row so the marquee loops seamlessly (translateX(-50%))
document.querySelectorAll('.tm-row').forEach(r=>{r.setAttribute('aria-hidden','false');r.innerHTML+=r.innerHTML;});
document.querySelectorAll('[data-stars]').forEach(el=>el.innerHTML=STAR.repeat(5));

// hero parallax: the lifestyle banner drifts slower than the page as you scroll
const heroEl=document.querySelector('.hero');
const parallaxEl=document.querySelector('.hb-parallax');
const REDUCEM=matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!REDUCEM && parallaxEl){
  let ticking=false;
  const onScroll=()=>{ if(ticking) return; ticking=true; requestAnimationFrame(()=>{
    if(innerWidth<=880){ parallaxEl.style.transform=''; ticking=false; return; }   // photo is a static band on mobile
    const h=heroEl?heroEl.offsetHeight:800;
    const y=Math.min(scrollY, h);                 // only track while the hero is on screen
    parallaxEl.style.transform='translate3d(0,'+(y*0.16).toFixed(1)+'px,0)';
    ticking=false;
  }); };
  addEventListener('scroll',onScroll,{passive:true}); addEventListener('resize',onScroll,{passive:true}); onScroll();
}

// hero loop video: crossfade two copies near the end so the loop never hard-cuts (seamless dissolve)
(()=>{
  const vids=[...document.querySelectorAll('.hb-video')]; if(!vids.length) return;
  const play=v=>{ const p=v.play&&v.play(); if(p&&p.catch) p.catch(()=>{}); };
  if(vids.length<2){ const v=vids[0]; v.loop=true; const show=()=>v.classList.add('show'); if(v.readyState>=3)show(); v.addEventListener('canplay',show,{once:true}); play(v); return; }
  let cur=vids[0], nxt=vids[1], swapping=false; const CF=0.75;
  cur.addEventListener('canplay',()=>cur.classList.add('show'),{once:true});
  vids.forEach(v=>v.addEventListener('error',()=>v.classList.remove('show')));
  play(cur);
  function guard(){
    const v=cur; if(!v.duration || swapping) return;
    if(v.currentTime >= v.duration - CF){
      swapping=true;
      nxt.currentTime=0; play(nxt);
      nxt.classList.add('show'); cur.classList.remove('show');
      const done=cur;
      setTimeout(()=>{ try{done.pause();}catch(_){} const t=cur; cur=nxt; nxt=t; swapping=false; }, CF*1000+80);
    }
  }
  vids.forEach(v=>{ v.addEventListener('timeupdate',guard); v.addEventListener('ended',guard); });
})();

// count up
function countUp(el){
  const target=+el.dataset.count, plain=el.dataset.plain, suffix=el.dataset.suffix||'';
  if(REDUCE){ el.textContent=(plain?String(target):target.toLocaleString('en-US'))+suffix; return; }
  const dur=1500, t0=performance.now();
  function tick(now){
    const p=Math.min((now-t0)/dur,1), ease=1-Math.pow(1-p,3), val=Math.floor(ease*target);
    el.textContent=(plain?val:val.toLocaleString('en-US'))+ (p===1?suffix:'');
    if(p<1)requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}
const sio=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){countUp(e.target);sio.unobserve(e.target);}})},{threshold:.6});
document.querySelectorAll('[data-count]').forEach(el=>sio.observe(el));

// timeline fill
const tlf=document.getElementById('tlfill');
const tio=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){tlf.style.width='100%';tio.unobserve(e.target);}})},{threshold:.4});
tio.observe(document.getElementById('tl'));

// The hero 3D bottle (real label wrapped on a glossy cylinder) is rendered by the
// Three.js module at the end of <body>. pourTablets() below is called from it on click.
window.pourTablets = pourTablets;

// click-to-pour chewable tablets (Web Animations API, compositor only)
const COLORS=['','v2','v3'];
let poured=[], pourAnims=new Map(), busy=false, autoT=null;
function pourTablets(){
  const stage=document.getElementById('bottle-stage');
  if(!stage || busy) return;
  if(poured.length){ resetTablets(); return; }
  busy=true;
  const m = window.__mtMouth ? window.__mtMouth() : null;
  const rr = stage.getBoundingClientRect();
  const W = m? m.w : rr.width, H = m? m.h : rr.height;
  const mouthX = m? m.x : W*0.32, mouthY = m? m.mouthY : H*0.30, floorY = m? m.floorY : H*0.80;
  const half=11, minX=half, maxX=W-half;
  const n=12+Math.floor(Math.random()*5);
  let pending=n;
  const settleBusy=()=>{ if(--pending<=0) busy=false; };
  for(let i=0;i<n;i++){
    const t=document.createElement('div'); t.className='tablet '+COLORS[i%3]; t.setAttribute('aria-hidden','true');
    const sh=document.createElement('div'); sh.className='tablet-shadow'; sh.setAttribute('aria-hidden','true');
    stage.append(sh,t);
    const side=Math.random()<0.5?-1:1;
    let landX=mouthX+side*(12+Math.random()*W*0.17); landX=Math.max(minX,Math.min(maxX,landX));
    const landY=floorY-Math.random()*16;
    const peakY=mouthY-(34+Math.random()*64);
    const spin=(Math.random()*720-360)|0;
    const delay=i*34+Math.random()*40;
    const dur=REDUCE?1:(560+Math.random()*240);
    const settle=0.85+Math.random()*0.2;
    if(REDUCE){ t.style.transform=`translate3d(${landX}px,${landY}px,0) scale(${settle})`; t.style.opacity=1; sh.style.transform=`translate3d(${landX}px,${floorY}px,0) scale(1)`; sh.style.opacity=.8; poured.push(t,sh); settleBusy(); continue; }
    const a=t.animate([
      {transform:`translate3d(${mouthX}px,${mouthY}px,0) scale(.2) rotate(0deg)`,opacity:0,offset:0},
      {transform:`translate3d(${(mouthX+landX)/2}px,${peakY}px,0) scale(1) rotate(${spin*0.4}deg)`,opacity:1,offset:.42,easing:'cubic-bezier(.18,.7,.5,1)'},
      {transform:`translate3d(${landX}px,${landY}px,0) scale(1) rotate(${spin}deg)`,opacity:1,offset:.82,easing:'cubic-bezier(.5,0,.9,.55)'},
      {transform:`translate3d(${landX}px,${landY-6}px,0) scale(1.06,.94) rotate(${spin}deg)`,opacity:1,offset:.9},
      {transform:`translate3d(${landX}px,${landY}px,0) scale(${settle}) rotate(${spin}deg)`,opacity:1,offset:1}
    ],{duration:dur,delay,fill:'forwards',easing:'linear'});
    pourAnims.set(t,a);
    a.finished.then(settleBusy).catch(settleBusy);
    sh.animate([
      {transform:`translate3d(${mouthX}px,${floorY}px,0) scale(.2)`,opacity:0,offset:0},
      {transform:`translate3d(${landX}px,${floorY}px,0) scale(.4)`,opacity:0,offset:.42},
      {transform:`translate3d(${landX}px,${floorY}px,0) scale(1)`,opacity:.78,offset:1}
    ],{duration:dur,delay,fill:'forwards'});
    poured.push(t,sh);
  }
  clearTimeout(autoT);
  autoT=setTimeout(()=>{ if(poured.length) resetTablets(); },4500);
}
function resetTablets(){
  clearTimeout(autoT);
  if(!poured.length) return;
  busy=true;
  const nodes=poured; poured=[];
  let pending=nodes.length;
  const done=()=>{ if(--pending<=0) busy=false; };
  nodes.forEach((el,i)=>{
    const pa=pourAnims.get(el); if(pa){ try{pa.cancel();}catch(_){} pourAnims.delete(el); }
    if(REDUCE){ el.remove(); done(); return; }
    const cs=getComputedStyle(el);
    el.animate([{opacity:cs.opacity,transform:cs.transform},{opacity:0,transform:cs.transform+' translateY(8px) scale(.6)'}],{duration:240,delay:i*8,fill:'forwards',easing:'ease-in'}).finished.then(()=>{el.remove();done();}).catch(()=>{el.remove();done();});
  });
}
</script>
<script type="module">
import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

// Both bottles live in ONE WebGL scene (a single context is reliable on every
// device and lets us space the two so neither is ever blocked by the other).
(function(){
  const mount = document.getElementById('bottle-stage');
  if (!mount) return;
  const REDUCE = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const renderer = new THREE.WebGLRenderer({ antialias:true, alpha:true, powerPreference:'high-performance', preserveDrawingBuffer:true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.NeutralToneMapping;   // PBR Neutral: preserves the saturated brand blue (ACES desaturated it)
  renderer.toneMappingExposure = 1.06;
  mount.appendChild(renderer.domElement);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(26, 1, 0.1, 100);

  // Studio IBL with bright vertical softboxes -> crisp glossy highlight strips that sweep across
  // the bottle as it turns (the signature product-shot shine), over a soft studio gradient.
  const pmrem = new THREE.PMREMGenerator(renderer);
  pmrem.compileEquirectangularShader();
  const envCanvas = (()=>{
    const w=1024, h=512, c=document.createElement('canvas'); c.width=w; c.height=h; const g=c.getContext('2d');
    const bg=g.createLinearGradient(0,0,0,h);
    bg.addColorStop(0.00,'#aab0bc'); bg.addColorStop(0.34,'#787e8b'); bg.addColorStop(0.62,'#4e5460'); bg.addColorStop(1.00,'#2c303a');
    g.fillStyle=bg; g.fillRect(0,0,w,h);                                  // DARK surround: metal + gloss now throw crisp bright highlights, and it matches the dark section
    const ce=g.createLinearGradient(0,0,0,h*0.22); ce.addColorStop(0,'rgba(255,255,255,.5)'); ce.addColorStop(1,'rgba(255,255,255,0)');
    g.fillStyle=ce; g.fillRect(0,0,w,h*0.22);
    function softbox(cx, ww, top, bot, peak){
      const x0=cx-ww/2, lg=g.createLinearGradient(x0,0,x0+ww,0);
      lg.addColorStop(0,'rgba(255,255,255,0)'); lg.addColorStop(0.5,'rgba(255,255,255,'+peak+')'); lg.addColorStop(1,'rgba(255,255,255,0)');
      g.fillStyle=lg; g.fillRect(x0, top, ww, bot-top);
    }
    softbox(w*0.20, w*0.11,  h*0.03, h*0.82, 1.0);    // strong left key bar
    softbox(w*0.50, w*0.035, h*0.02, h*0.52, 0.55);   // slim centre accent (narrowed: let the L/R pair drive one clean sweep)
    softbox(w*0.80, w*0.13,  h*0.03, h*0.86, 0.96);   // broad right bar
    const wb=g.createLinearGradient(0,h*0.8,0,h); wb.addColorStop(0,'rgba(150,170,225,0)'); wb.addColorStop(1,'rgba(150,170,225,.12)');
    g.fillStyle=wb; g.fillRect(0,h*0.8,w,h*0.2);      // faint cool floor bounce
    return c;
  })();
  const gradTex = new THREE.CanvasTexture(envCanvas);
  gradTex.mapping=THREE.EquirectangularReflectionMapping; gradTex.colorSpace=THREE.SRGBColorSpace;
  gradTex.magFilter=THREE.LinearFilter; gradTex.minFilter=THREE.LinearFilter;
  const envRT = pmrem.fromEquirectangular(gradTex);   // keep envRT alive: scene.environment references its texture
  scene.environment = envRT.texture;
  gradTex.dispose(); pmrem.dispose();

  // Studio rig: one soft key, gentle fill, faint rim for edge separation on the white page, hemisphere bounce
  const ambient = new THREE.AmbientLight(0xffffff, 0.18); scene.add(ambient);
  const key  = new THREE.DirectionalLight(0xffffff, 1.95); key.position.set(8, 5.5, 5);  scene.add(key);   // proper key from the right
  const fill = new THREE.DirectionalLight(0xdbe4ff, 0.58); fill.position.set(-6, 2, 4);  scene.add(fill);  // soft left fill
  const rim  = new THREE.DirectionalLight(0xffffff, 1.15);  rim.position.set(3.5, 5, -7); scene.add(rim);
  rim.target.position.set(0, 1.2, 0); scene.add(rim.target);   // brighter back rim: separates the glossy edge from the dark section
  const rim2 = new THREE.DirectionalLight(0xdce6ff, 0.8);  rim2.position.set(-5, 3.5, -6); scene.add(rim2);   // cool left rim for the other edge
  rim2.target.position.set(0, 1.2, 0); scene.add(rim2.target);
  const hemi = new THREE.HemisphereLight(0xffffff, 0xc6cad2, 0.60); scene.add(hemi);

  const R = 1.05, rb = 0.13, BASE = -1.72, NECK = 0.72, CH = 0.92, MOUTH = 0.97;   // NECK = shoulder where the cap sits flush; MOUTH = top of the threaded neck (revealed when the cap twists off)
  function arc(cx,cy,rad,a0,a1,segs){ const o=[]; for(let i=0;i<=segs;i++){ const a=a0+(a1-a0)*i/segs; o.push(new THREE.Vector2(cx+Math.cos(a)*rad, cy+Math.sin(a)*rad)); } return o; }
  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  const capLogoTex = new THREE.TextureLoader().load('assets/cap-logo.png', t=>{ t.colorSpace=THREE.SRGBColorSpace; t.anisotropy=maxAniso; });
  const capTopTex = (()=>{                                    // "eskayvie" curved around the cap top
    const s=512, c=document.createElement('canvas'); c.width=c.height=s; const g=c.getContext('2d');
    g.translate(s/2,s/2); g.fillStyle='rgba(255,255,255,0.5)'; g.textAlign='center'; g.textBaseline='middle';
    g.font='600 46px Fraunces, Georgia, serif';
    const txt='eskayvie', rad=188, span=Math.PI*0.82;
    for(let i=0;i<txt.length;i++){ const f=(i-(txt.length-1)/2)/(txt.length-1), a=f*span;
      g.save(); g.rotate(a); g.translate(0,-rad); g.fillText(txt[i],0,0); g.restore(); }
    const t=new THREE.CanvasTexture(c); t.colorSpace=THREE.SRGBColorSpace; t.anisotropy=maxAniso; return t;
  })();
  // engraved cap-top NORMAL map: concentric ring grooves + centre dimple + embossed "eskayvie" (like the real cap top).
  // Built from a height field via Sobel so the engraving catches light cleanly without darkening the flat top.
  const capTopNormal = (()=>{
    const S=512, hc=document.createElement('canvas'); hc.width=hc.height=S; const hg=hc.getContext('2d');
    hg.fillStyle='#808080'; hg.fillRect(0,0,S,S);
    const cx=S/2, cy=S/2, R=S*0.47;
    for(let r=R;r>=0;r-=0.5){ const hh=0.5+0.5*Math.cos(r/R*Math.PI*2*11); const v=Math.round(108+hh*40);   // 11 concentric rings
      hg.beginPath(); hg.arc(cx,cy,r,0,Math.PI*2); hg.fillStyle='rgb('+v+','+v+','+v+')'; hg.fill(); }
    hg.save(); hg.translate(cx,cy); hg.fillStyle='#efefef'; hg.textAlign='center'; hg.textBaseline='middle';   // "eskayvie" embossed near the rim (strong)
    hg.font='700 40px Fraunces, Georgia, serif';
    const txt='eskayvie', rad=S*0.335, span=Math.PI*0.86;
    for(let i=0;i<txt.length;i++){ const f=(i-(txt.length-1)/2)/(txt.length-1), a=f*span; hg.save(); hg.rotate(a); hg.translate(0,-rad); hg.fillText(txt[i],0,0); hg.restore(); }
    hg.restore();
    const dg=hg.createRadialGradient(cx,cy,0,cx,cy,S*0.075); dg.addColorStop(0,'#262626'); dg.addColorStop(0.7,'#3a3a3a'); dg.addColorStop(1,'rgba(58,58,58,0)');  // deeper centre dimple
    hg.fillStyle=dg; hg.beginPath(); hg.arc(cx,cy,S*0.075,0,Math.PI*2); hg.fill();
    const src=hg.getImageData(0,0,S,S).data, nc=document.createElement('canvas'); nc.width=nc.height=S; const ng=nc.getContext('2d'), out=ng.createImageData(S,S), od=out.data;
    const Hd=(x,y)=>{ x=x<0?0:x>S-1?S-1:x; y=y<0?0:y>S-1?S-1:y; return src[(y*S+x)*4]/255; }, k=2.6;
    for(let y=0;y<S;y++)for(let x=0;x<S;x++){ const dx=(Hd(x+1,y)-Hd(x-1,y))*k, dy=(Hd(x,y+1)-Hd(x,y-1))*k;
      let nx=-dx, ny=-dy, nz=1; const l=Math.hypot(nx,ny,nz); nx/=l; ny/=l; nz/=l; const o=(y*S+x)*4;
      od[o]=(nx*0.5+0.5)*255; od[o+1]=(ny*0.5+0.5)*255; od[o+2]=(nz*0.5+0.5)*255; od[o+3]=255; }
    ng.putImageData(out,0,0);
    const t=new THREE.CanvasTexture(nc); t.colorSpace=THREE.NoColorSpace; t.anisotropy=maxAniso; return t;
  })();

  // ---- real moulded jar from a GLB (the photo turned into geometry); its smeared AI texture
  //      is discarded and the crisp brand label is cylindrically wrapped on instead ----
  const TARGET_H = 2.5, WIDEN = 1.0, JAR_CENTER_Y = BASE + TARGET_H/2;   // reverted to original uniform proportions
  let _jarTpl = null;                                       // shared template (loaded once, cloned per bottle)
  function loadJar(){
    if(_jarTpl) return _jarTpl;
    _jarTpl = new Promise((res,rej)=>{
      new GLTFLoader().load('assets/bottle-mt.glb', (g)=>{
        let mesh=null; g.scene.traverse(o=>{ if(o.isMesh && !mesh) mesh=o; });
        if(!mesh){ rej('no mesh'); return; }
        const geo=mesh.geometry; geo.computeBoundingBox();
        const bb=geo.boundingBox, yMin=bb.min.y, h=(bb.max.y-yMin)||1;   // cylindrical UVs: angle -> u, height -> v
        const pos=geo.attributes.position, uv=new Float32Array(pos.count*2);
        for(let i=0;i<pos.count;i++){ const x=pos.getX(i), y=pos.getY(i), z=pos.getZ(i);
          let u=-Math.atan2(z,x)/(2*Math.PI)+0.5; u-=Math.floor(u);
          uv[i*2]=u; uv[i*2+1]=(y-yMin)/h; }
        geo.setAttribute('uv', new THREE.BufferAttribute(uv,2));
        // Split the fused indexed GLB into {capGeo, bodyGeo} by triangle-centroid Y, so the cap can twist off.
        // Both halves SHARE the position/normal/uv buffers (read-only); only the index differs. Runs ONCE.
        const Y_CUT = yMin + 0.758 * h;                       // native ~+0.49: the cap-skirt/body radius-dip seam
        const index = geo.index ? geo.index.array : null;
        const triCount = index ? index.length/3 : pos.count/3;
        const gi = i => index ? index[i] : i;
        const capIdx = [], bodyIdx = [];
        for(let t=0; t<triCount; t++){
          const a=gi(t*3), bi=gi(t*3+1), c=gi(t*3+2);
          const cy = (pos.getY(a)+pos.getY(bi)+pos.getY(c))/3;
          if(cy >= Y_CUT){ capIdx.push(a,bi,c); } else { bodyIdx.push(a,bi,c); }
        }
        const IdxArr = pos.count > 65535 ? Uint32Array : Uint16Array;
        const half = (idxArr)=>{
          const gg = new THREE.BufferGeometry();
          gg.setAttribute('position', geo.attributes.position);   // shared by reference
          gg.setAttribute('normal',   geo.attributes.normal);
          gg.setAttribute('uv',       geo.attributes.uv);
          gg.setIndex(new THREE.BufferAttribute(new IdxArr(idxArr), 1));
          gg.computeBoundingBox(); gg.computeBoundingSphere();
          return gg;
        };
        const capGeo = half(capIdx), bodyGeo = half(bodyIdx);
        capGeo.userData.yCut = Y_CUT;                          // native cut height, for neck + cap placement
        res({ capGeo, bodyGeo, yMin, h });                    // do NOT dispose/computeVertexNormals the source: halves share its buffers
      }, undefined, rej);
    });
    return _jarTpl;
  }
  // compose the bottle "skin": brand label wrapped round the body, over a brand-blue base. The lower
  // SILVER section (per the metal3 mask) is baked to a silver-grey albedo AND given real brushed-metal
  // metalness+roughness, so it reads like the real product's brushed-silver lower body (not flat white).
  function buildSkin(opts){
    const S=2048, c=document.createElement('canvas'); c.width=c.height=S; const g=c.getContext('2d');
    g.fillStyle=opts.blue; g.fillRect(0,0,S,S);
    if(opts._lab){ const top=opts.bandTop*S, bot=opts.bandBot*S; g.drawImage(opts._lab, 0, top, S, bot-top); }
    const mk=(cv,lin)=>{ const t=new THREE.CanvasTexture(cv); t.wrapS=THREE.RepeatWrapping; t.anisotropy=maxAniso;
      t.offset.x=opts.uoff||0; t.colorSpace=lin?THREE.NoColorSpace:THREE.SRGBColorSpace; t.needsUpdate=true; return t; };
    let metalnessMap=null, roughnessMap=null;
    if(opts._metal){                                                     // metal3 mask: white = the silver band background
      const METAL=0.52, R_BAND=0.34, R_BODY=0.28, K=0.85, SR=210, SG=214, SB=221;   // SR/SG/SB = bright light brushed-silver
      const tc=document.createElement('canvas'); tc.width=tc.height=S; const tg=tc.getContext('2d');
      tg.fillStyle='#000'; tg.fillRect(0,0,S,S);
      tg.drawImage(opts._metal, 0, opts.bandTop*S, S, (opts.bandBot-opts.bandTop)*S);
      const md=tg.getImageData(0,0,S,S).data;
      const ad=g.getImageData(0,0,S,S), a=ad.data;                       // tint band albedo toward silver
      const mc=document.createElement('canvas'); mc.width=mc.height=S; const mg=mc.getContext('2d');
      const rc=document.createElement('canvas'); rc.width=rc.height=S; const rg=rc.getContext('2d');
      const mo=mg.createImageData(S,S), mod=mo.data, ro=rg.createImageData(S,S), rod=ro.data;
      for(let i=0;i<md.length;i+=4){ const m=md[i]/255, w=m*K;
        a[i]=a[i]*(1-w)+SR*w; a[i+1]=a[i+1]*(1-w)+SG*w; a[i+2]=a[i+2]*(1-w)+SB*w;   // white bg -> silver, text stays
        const mv=(m*METAL*255)|0; mod[i]=mod[i+1]=mod[i+2]=mv; mod[i+3]=255;
        const rv=((R_BODY+(R_BAND-R_BODY)*m)*255)|0; rod[i]=rod[i+1]=rod[i+2]=rv; rod[i+3]=255; }
      g.putImageData(ad,0,0); mg.putImageData(mo,0,0); rg.putImageData(ro,0,0);
      metalnessMap=mk(mc,true); roughnessMap=mk(rc,true);
    }
    return { map:mk(c,false), metalnessMap, roughnessMap };
  }
  // neck + helical screw thread + dark open mouth + shoulder, in native GLB units, parented under the body.
  // Hidden under the closed cap; revealed (the "groove to turn / thread") when the cap twists up.
  function buildNeckParts(blueHex, yCut){
    const grp = new THREE.Group();
    const bodyR = 0.557, neckR = 0.40, yTop = yCut + 0.165;               // short neck, hidden under the shorter cap
    const plastic = hex => new THREE.MeshPhysicalMaterial({ color:new THREE.Color(hex), metalness:0,
      roughness:0.28, clearcoat:1.0, clearcoatRoughness:0.05, envMapIntensity:1.5, dithering:true });
    const neckMat = plastic(blueHex);
    const shoulder = new THREE.Mesh(new THREE.CylinderGeometry(neckR, bodyR, 0.055, 96, 1, true), neckMat);
    shoulder.position.y = yCut + 0.025; grp.add(shoulder);                // closes the body's open top
    const neck = new THREE.Mesh(new THREE.CylinderGeometry(neckR, neckR*1.02, (yTop-yCut), 96, 1, true), neckMat);
    neck.position.y = (yCut+yTop)/2; grp.add(neck);
    const turns=2.2, segs=360, hR=neckR+0.013, pts=[];                    // helical thread on the short neck
    for(let i=0;i<=segs;i++){ const f=i/segs, a=f*Math.PI*2*turns;
      pts.push(new THREE.Vector3(Math.cos(a)*hR, yCut+0.035 + f*(yTop-yCut-0.06), Math.sin(a)*hR)); }
    const thread = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), segs, 0.024, 18, false),
      plastic(new THREE.Color(blueHex).multiplyScalar(0.78).getHex()));   // slightly thicker + deeper so the screw thread reads
    grp.add(thread);
    const darkMat = new THREE.MeshStandardMaterial({ color:0x0a1430, roughness:0.92, metalness:0, side:THREE.BackSide });
    const bore = new THREE.Mesh(new THREE.CylinderGeometry(neckR-0.03, neckR-0.03, (yTop-yCut), 64, 1, true), darkMat);
    bore.position.y = (yCut+yTop)/2; grp.add(bore);                       // dark interior wall
    const floor = new THREE.Mesh(new THREE.CircleGeometry(neckR-0.03, 64),
      new THREE.MeshStandardMaterial({ color:0x0a1430, roughness:0.92, metalness:0 }));
    floor.rotation.x = -Math.PI/2; floor.position.y = yCut + 0.10; grp.add(floor);
    grp.userData.neckTopY = yTop;
    return grp;
  }
  // a smooth parabolic DOME with radial subdivisions (rings of verts) + radial UVs, so it curves cleanly and the
  // concentric-ring normal map maps right. (CircleGeometry has NO radial rings, so displacing it made a cone.)
  function domeGeo(R, h, rings, segs){
    const pos=[0,h,0], uv=[0.5,0.5], idx=[];
    for(let ri=1; ri<=rings; ri++){ const r=R*ri/rings, y=h*(1-(r/R)*(r/R));
      for(let si=0; si<=segs; si++){ const a=si/segs*Math.PI*2, x=Math.cos(a)*r, z=Math.sin(a)*r;
        pos.push(x,y,z); uv.push(0.5+(x/R)*0.5, 0.5+(z/R)*0.5); } }
    for(let si=0; si<segs; si++){ idx.push(0, 1+si+1, 1+si); }                 // centre fan
    for(let ri=0; ri<rings-1; ri++){ const b0=1+ri*(segs+1), b1=1+(ri+1)*(segs+1);
      for(let si=0; si<segs; si++){ idx.push(b0+si, b0+si+1, b1+si, b1+si, b0+si+1, b1+si+1); } }
    const g=new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.Float32BufferAttribute(pos,3));
    g.setAttribute('uv', new THREE.Float32BufferAttribute(uv,2));
    g.setIndex(idx); g.computeVertexNormals(); return g;
  }
  // premium procedural screw cap matching the real product: short glossy skirt + a gently DOMED engraved top
  // (concentric ring grooves + centre dimple + "eskayvie" embossed). Replaces the GLB's cap.
  function buildCap(opts, yCut){
    const cap = new THREE.Group();
    const CR=0.561, capHnat=0.225, yb=yCut, yt=yCut+capHnat;              // short flat cap (-8% height)
    const capMat = new THREE.MeshPhysicalMaterial({ color:new THREE.Color(opts.cap), metalness:0,
      roughness:0.20, clearcoat:1.0, clearcoatRoughness:0.04, ior:1.5, specularIntensity:1.0,
      specularColor:new THREE.Color(0xeaf0ff), envMapIntensity:1.35, dithering:true });
    // short skirt with a rounded edge, then an almost-FLAT top with just a soft crown (like the real cap)
    const rimR=CR-0.020, yRim=yt-0.020, domeH=yt-yRim;
    const prof=[
      new THREE.Vector2(CR, yb),               // skirt bottom (open)
      new THREE.Vector2(CR, yRim-0.012),       // skirt side
      new THREE.Vector2(CR-0.013, yRim-0.001), // rounded top edge
      new THREE.Vector2(rimR, yRim)            // rim where the dome starts
    ];
    cap.add(new THREE.Mesh(new THREE.LatheGeometry(prof, 256), capMat));
    // gently domed engraved top (smooth, subdivided); rings/eskayvie/dimple from the normal map
    const topMat = capMat.clone(); topMat.normalMap=capTopNormal; topMat.normalScale=new THREE.Vector2(1.0,1.0);
    const dome=new THREE.Mesh(domeGeo(rimR, domeH, 48, 160), topMat); dome.position.y=yRim; cap.add(dome);
    const under=new THREE.Mesh(new THREE.CircleGeometry(CR-0.01, 64),     // dark under-disc: not hollow when lifted
      new THREE.MeshStandardMaterial({ color:0x0a1430, roughness:0.92, metalness:0, side:THREE.DoubleSide }));
    under.rotation.x=Math.PI/2; under.position.y=yb+0.006; cap.add(under);
    return cap;
  }
  // build one bottle: a spin group; body + a twist-off cap stream in from the split GLB
  function buildBottle(opts){
    const grp = new THREE.Group();
    const cap = new THREE.Group(); grp.add(cap);                          // the real cap mounts here (twist-off group)
    const b = { grp, cap, capRestY:NECK-0.02, openT:0, capOpen:false, pour:false, isGLB:true };
    const TL = new THREE.TextureLoader();
    const load = (url)=> url ? new Promise(r=>TL.load(url, t=>r(t.image), undefined, ()=>r(null))) : Promise.resolve(null);
    Promise.all([ load(opts.label), load(opts.metal) ]).then(([lab, metal])=>{
      opts._lab = lab; opts._metal = metal;
      return loadJar().then((tpl)=>{
        const sk = buildSkin(opts);
        // clearcoat-HERO glossy plastic; the silver band gets a LIGHT glossy metallic via metalness+roughness maps
        const mat = new THREE.MeshPhysicalMaterial({ map:sk.map, color:0xffffff,
          metalness: sk.metalnessMap?1.0:0.0, metalnessMap: sk.metalnessMap,
          roughness:  sk.roughnessMap?1.0:0.28, roughnessMap: sk.roughnessMap,
          clearcoat:1.0, clearcoatRoughness:0.045, ior:1.5,
          specularIntensity:1.0, specularColor:new THREE.Color(0xeaf0ff), envMapIntensity:1.5, dithering:true });
        const bodyMesh = new THREE.Mesh(tpl.bodyGeo, mat);   // GLB cap dome (capGeo) is discarded; a procedural cap replaces it
        const box = new THREE.Box3().union(tpl.capGeo.boundingBox).union(tpl.bodyGeo.boundingBox);
        const size = box.getSize(new THREE.Vector3()), ctr = box.getCenter(new THREE.Vector3());
        const s = TARGET_H/(size.y||1), sxz = s*WIDEN;   // WIDEN X/Z (sx=sz stays circular) so the jar isn't stretched tall/slim
        const seatX=-ctr.x*sxz, seatY=-ctr.y*s+JAR_CENTER_Y, seatZ=-ctr.z*sxz;
        bodyMesh.scale.set(sxz, s, sxz); bodyMesh.position.set(seatX, seatY, seatZ);
        grp.add(bodyMesh); b.jar=bodyMesh;
        bodyMesh.add( buildNeckParts(opts.blue, tpl.capGeo.userData.yCut) );   // native units -> inherits sxz/s + seat
        // procedural engraved cap rides b.cap with the SAME scale+seat; the loop twists/lifts it
        b.cap.add( buildCap(opts, tpl.capGeo.userData.yCut) );
        b.cap.scale.set(sxz, s, sxz); b.cap.position.set(seatX, seatY, seatZ);
        b.capRestY = seatY;
        b.mouthY = seatY + (tpl.capGeo.userData.yCut + 0.165) * s;   // pour origin (neck top) in grp space
      });
    }).catch(()=>{});
    return b;
  }

  // place a bottle in the scene inside an outer group; seed its play-physics state
  function place(b, x, y, s){
    const outer=new THREE.Group(); outer.position.set(x,y,0); outer.scale.setScalar(s); outer.add(b.grp); scene.add(outer);
    b.outer=outer; b.radius=R*s;
    b.homeX=x; b.homeY=y; b.px=x; b.py=y; b.rvy=0; b.rvx=0;
    return b;
  }

  const mt = place(buildBottle({ label:'assets/label-mindtropic.png?v=1', metal:'assets/label-mindtropic-metal3.png', blue:'#1c3cc6', cap:'#1c3cc6', capH:0.245, bandTop:0.255, bandBot:0.92, uoff:0.25 }), -1.35, 0.17, 1.00);
  const jr = place(buildBottle({ label:'assets/label-junior.png?v=1',     metal:'assets/label-junior-metal3.png',     blue:'#7ec2e6', cap:'#62b4e6', capH:0.245, bandTop:0.255, bandBot:0.92, uoff:0.25 }),  1.35, 0.17, 1.00);
  const bottles = [mt, jr];

  // soft contact shadows so the bottles sit on a surface instead of floating (transparent-canvas friendly)
  const FLOOR_Y = -1.56;
  const shadowTex = (()=>{
    const c=document.createElement('canvas'); c.width=c.height=256; const g=c.getContext('2d');
    const rg=g.createRadialGradient(128,128,0,128,128,128);
    rg.addColorStop(0,'rgba(54,30,10,0.62)'); rg.addColorStop(0.34,'rgba(54,30,10,0.32)'); rg.addColorStop(0.66,'rgba(54,30,10,0.09)'); rg.addColorStop(1,'rgba(54,30,10,0)');
    g.fillStyle=rg; g.fillRect(0,0,256,256);
    const t=new THREE.CanvasTexture(c); t.colorSpace=THREE.SRGBColorSpace; return t;
  })();
  function makeContactShadow(radius){
    const m=new THREE.Mesh(new THREE.PlaneGeometry(radius*2.25, radius*2.25),
      new THREE.MeshBasicMaterial({ map:shadowTex, transparent:true, depthWrite:false, toneMapped:false }));
    m.rotation.x=-Math.PI/2; m.scale.set(1,1.12,1); m.renderOrder=-1; return m;   // local Y -> world Z: slight cast elongation
  }
  const mtShadow = makeContactShadow(1.05); mtShadow.position.set(mt.outer.position.x-0.10, FLOOR_Y, -0.12); scene.add(mtShadow);
  const jrShadow = makeContactShadow(1.05); jrShadow.position.set(jr.outer.position.x-0.10, FLOOR_Y, -0.12); scene.add(jrShadow);

  // ---- real 3D chewable tablets that pour out of the mouth and tumble onto the table ----
  const pillGeo = new THREE.CylinderGeometry(0.17, 0.17, 0.085, 26);   // flat round chewable tablet, like the photos
  const pillMatMt = new THREE.MeshStandardMaterial({ color:0xa8506e, roughness:0.62, metalness:0.0 });   // dusty berry pink (Mindtropic)
  const pillMatJr = new THREE.MeshStandardMaterial({ color:0x6f4a30, roughness:0.66, metalness:0.0 });   // milk chocolate (Junior)
  const pills = [];
  function pourPills(b){
    const mat = (b===jr ? pillMatJr : pillMatMt).clone();
    const n = 11 + Math.floor(Math.random()*5);
    for(let i=0;i<n;i++){
      const m = new THREE.Mesh(pillGeo, mat);
      m.position.set(b.px + (Math.random()-0.5)*0.26, b.py + (b.mouthY ?? MOUTH) + 0.02 + Math.random()*0.28, (Math.random()-0.5)*0.24);
      m.rotation.set(Math.random()*6, Math.random()*6, Math.random()*6);
      m.scale.setScalar(0.9 + Math.random()*0.25);
      scene.add(m);
      const side = b===mt ? -1 : 1;
      pills.push({ m, b, vx:side*(0.01+Math.random()*0.03), vy:0.015+Math.random()*0.03, vz:(Math.random()-0.4)*0.03,
        rx:(Math.random()-0.5)*0.34, ry:(Math.random()-0.5)*0.34, rz:(Math.random()-0.5)*0.34, life:1, rest:0 });
    }
    while(pills.length>46){ const old=pills.shift(); scene.remove(old.m); old.m.material.dispose(); }
  }
  function clearPills(b){
    for(let i=pills.length-1;i>=0;i--){ if(!b || pills[i].b===b){ pills[i].fade=true; } }
  }
  function updatePills(){
    for(let i=pills.length-1;i>=0;i--){
      const p=pills[i];
      p.vy -= 0.0045;                                   // gravity
      p.m.position.x += p.vx; p.m.position.y += p.vy; p.m.position.z += p.vz;
      p.m.rotation.x += p.rx; p.m.rotation.y += p.ry; p.m.rotation.z += p.rz;
      if(p.m.position.y < FLOOR_Y+0.06){                // land on the table
        p.m.position.y = FLOOR_Y+0.06; p.vy = -p.vy*0.32; p.vx*=0.78; p.vz*=0.78;
        p.rx*=0.4; p.ry*=0.4; p.rz*=0.4;
        if(Math.abs(p.vy)<0.012){ p.vy=0; p.rest++; }
      }
      if(p.fade || p.rest>90){
        p.m.material.transparent=true; p.m.material.opacity = (p.m.material.opacity ?? 1) - 0.05;
        if(p.m.material.opacity<=0){ scene.remove(p.m); p.m.material.dispose(); pills.splice(i,1); }
      }
    }
  }

  function toggleCap(b){
    if(!b.cap || !b.jar || b.mouthY===undefined) return;       // not streamed in yet
    b.capOpen = !b.capOpen;
    if(!b.capOpen){ clearPills(b); b._poured=false; }           // pour happens mid-twist (in the loop), once the cap clears
  }

  // expose the Mindtropic mouth + base in stage pixels so the DOM tablet pour lands right
  const _v = new THREE.Vector3();
  window.__mtMouth = function(){
    const rect = mount.getBoundingClientRect();
    camera.updateMatrixWorld();
    mt.grp.updateWorldMatrix(true, false);
    const proj = (ly)=>{ _v.set(0,ly,0).applyMatrix4(mt.grp.matrixWorld); const p=_v.project(camera); return { x:(p.x*0.5+0.5)*rect.width, y:(-p.y*0.5+0.5)*rect.height }; };
    const mo = proj(mt.mouthY ?? MOUTH), ba = proj(BASE);
    return { x:mo.x, mouthY:mo.y, floorY:ba.y, w:rect.width, h:rect.height };
  };

  // ---- playful physics: grab a bottle, push/fling/spin it; they knock together, bounce, and drift home ----
  const ray = new THREE.Raycaster(), ndc = new THREE.Vector2();
  const dragPlane = new THREE.Plane(new THREE.Vector3(0,0,1), 0), hitPt = new THREE.Vector3();
  function setNDC(e){ const r=mount.getBoundingClientRect(); ndc.x=((e.clientX-r.left)/r.width)*2-1; ndc.y=-((e.clientY-r.top)/r.height)*2+1; }
  function planePoint(e){ setNDC(e); ray.setFromCamera(ndc,camera); ray.ray.intersectPlane(dragPlane,hitPt); return hitPt; }
  function pick(e){ setNDC(e); ray.setFromCamera(ndc,camera); let best=null,bd=Infinity; for(const b of bottles){ const h=ray.intersectObject(b.outer,true); if(h.length&&h[0].distance<bd){bd=h[0].distance;best=b;} } return best; }

  let grabbed=null, lastX=0, lastY=0, downX=0, downY=0, didDrag=false;
  mount.addEventListener('pointerdown', e=>{
    camera.updateMatrixWorld(); scene.updateMatrixWorld(true);
    const b=pick(e); if(!b) return;
    grabbed=b; lastX=e.clientX; lastY=e.clientY; downX=e.clientX; downY=e.clientY; didDrag=false; b.rvy=0; b.rvx=0;
    mount.style.cursor='grabbing'; try{ mount.setPointerCapture(e.pointerId); }catch(_){}
  });
  mount.addEventListener('pointermove', e=>{
    if(!grabbed) return;
    if(!didDrag){ if(Math.hypot(e.clientX-downX,e.clientY-downY) < 6) return; didDrag=true; }   // small move = a click, bigger = a turn
    const dx=e.clientX-lastX, dy=e.clientY-lastY; lastX=e.clientX; lastY=e.clientY;
    const K=0.011;                                                                              // grab ANYWHERE on a bottle and turn it in any direction
    grabbed.grp.rotation.y += dx*K;
    grabbed.grp.rotation.x = Math.max(-1.0, Math.min(1.0, grabbed.grp.rotation.x + dy*K));
    grabbed.rvy = dx*K; grabbed.rvx = dy*K;                                                     // carry the spin on release (inertia)
  });
  function release(){ if(grabbed && !didDrag) toggleCap(grabbed); grabbed=null; mount.style.cursor='grab'; }   // a click twists the cap open / closed and pours
  mount.addEventListener('pointerup', release);
  mount.addEventListener('pointercancel', ()=>{ grabbed=null; mount.style.cursor='grab'; });

  function collide(a,b){
    const dx=b.px-a.px, dy=b.py-a.py, d=Math.hypot(dx,dy), minD=(a.radius+b.radius)*0.9;
    if(d>0.0001 && d<minD){
      const nx=dx/d, ny=dy/d, ov=minD-d, ag=(a===grabbed), bg=(b===grabbed);
      if(!ag){ a.px-=nx*ov*(bg?1:0.5); a.py-=ny*ov*(bg?1:0.5); }
      if(!bg){ b.px+=nx*ov*(ag?1:0.5); b.py+=ny*ov*(ag?1:0.5); }
      const imp=(b.vx*nx+b.vy*ny)-(a.vx*nx+a.vy*ny);
      if(!ag){ a.vx+=nx*imp; a.vy+=ny*imp; a.av+=0.03; }
      if(!bg){ b.vx-=nx*imp; b.vy-=ny*imp; b.av-=0.03; }
    }
  }
  function updateShadow(sh,b){ const lift=Math.max(0,b.py-b.homeY); sh.position.x=b.px-0.10; const s=1+lift*0.45; sh.scale.set(s,s*1.25,1); sh.material.opacity=Math.max(0.1, 1-lift*1.1); }

  let _hw=2.95, _hv=2.15, _cy=0.12;
  function fit(){
    const w = mount.clientWidth || 520, h = mount.clientHeight || 520;
    renderer.setSize(w, h, false);
    renderer.domElement.style.width='100%'; renderer.domElement.style.height='100%';
    const aspect = w/h; camera.aspect = aspect;
    _cy=0.5; _hv=2.55; _hw=3.35;                       // original framing: both bottles low in the full-bleed stage, headroom for the title
    const tanV = Math.tan((26*Math.PI/180)/2);
    const dist = Math.max(_hv/tanV, _hw/(tanV*aspect));
    const camY = _cy + 0.6;                             // gentle downward product tilt
    const dy = camY - _cy, z = Math.sqrt(Math.max(0.01, dist*dist - dy*dy));
    camera.position.set(0, camY, z); camera.lookAt(0, _cy, 0);
    camera.updateProjectionMatrix(); camera.updateMatrixWorld();
  }
  new ResizeObserver(fit).observe(mount); fit();

  function loop(){
    requestAnimationFrame(loop);
    for(const b of bottles){
      if(b!==grabbed){
        b.grp.rotation.y += b.rvy;
        b.grp.rotation.x = Math.max(-1.0, Math.min(1.0, b.grp.rotation.x + b.rvx));
        b.rvy *= 0.95; b.rvx *= 0.95;                                  // inertia decays after a fling
        b.grp.rotation.x += (0 - b.grp.rotation.x)*0.03;               // settle upright
        if(Math.abs(b.rvy) < 0.0025){                                  // when nearly still, ease the label round to face front
          const tgt = Math.round(b.grp.rotation.y/(Math.PI*2))*(Math.PI*2);
          b.grp.rotation.y += (tgt - b.grp.rotation.y)*0.04;
        }
      }
      b.outer.position.set(b.homeX, b.homeY, 0);                        // hold position: you TURN the bottle, you don't toss it
      b.openT += ((b.capOpen?1:0) - b.openT)*0.07;                      // eased open/close progress
      const oe = b.openT<1e-3 ? 0 : b.openT;
      b.cap.rotation.y = -Math.PI*6.0 * oe;                             // ~3 full turns: it TURNS first
      const liftP = Math.max(0, (oe-0.55)/0.45);                        // stays down while it spins, THEN rises
      b.cap.position.y = b.capRestY + 0.03*oe + liftP*liftP*0.34;       // turn, turn, turn, then lift just clear of the neck (sits close, not floating high)
      if(b.capOpen && !b._poured && oe>0.92){ b._poured=true; pourPills(b); }   // pour only once the cap is off
    }
    updatePills();
    updateShadow(mtShadow,mt); updateShadow(jrShadow,jr);
    renderer.render(scene, camera);
  }
  requestAnimationFrame(loop);
  // --- verification hook: render a still to a downscaled JPEG (the compositor screenshots this WebGL blank) ---
  window.__bottleShot = function(opt){
    opt = opt||{};
    if(opt.ry!==undefined){ mt.grp.rotation.y=opt.ry; jr.grp.rotation.y=opt.ry; }
    if(opt.rx!==undefined){ mt.grp.rotation.x=opt.rx; jr.grp.rotation.x=opt.rx; }
    if(opt.open){ const b = opt.open==='jr'?jr:mt; b.capOpen=true; b.openT=1; b.cap.rotation.y=-Math.PI*6; b.cap.position.y=b.capRestY+0.38; if(!b._poured){ b._poured=true; pourPills(b);} for(let k=0;k<70;k++) updatePills(); }
    renderer.render(scene,camera);
    const src=renderer.domElement, ph=opt.px||340, sc=ph/src.height;
    const c=document.createElement('canvas'); c.width=Math.round(src.width*sc); c.height=ph;
    const g=c.getContext('2d'); g.fillStyle='#16101f'; g.fillRect(0,0,c.width,c.height); g.drawImage(src,0,0,c.width,c.height);
    return c.toDataURL('image/jpeg', opt.q||0.62);
  };
  window.__b3d = { camera, renderer, scene, mt, jr, fit, blue:null, render:()=>renderer.render(scene,camera),
    info:()=>({ cw:renderer.domElement.width, ch:renderer.domElement.height, cam:camera.position.toArray().map(n=>+n.toFixed(2)), fov:camera.fov }) };
})();
</script>
<script>
/* ===== commerce: cart drawer, sticky buy bar, email capture ===== */
(function(){
  var WHATSAPP='60123456789'; /* TODO: replace with the real Eskayvie order WhatsApp number */
  var cart={};
  var money=function(n){return 'RM'+Number(n).toLocaleString('en-US');};
  var $=function(id){return document.getElementById(id);};
  var itemsEl=$('cartItems'), subEl=$('cartSub'), countEl=$('cartCount'),
      drawer=$('cartDrawer'), overlay=$('cartOverlay'),
      shipWrap=$('cartShip'), shipFill=$('cartShipFill'), shipMsg=$('cartShipMsg');
  if(!drawer) return;
  try{
    var saved=JSON.parse(localStorage.getItem('esk_cart'));
    if(saved&&typeof saved==='object'){
      for(var sk in saved){
        if(!Object.prototype.hasOwnProperty.call(saved,sk)) continue;
        var it=saved[sk];
        if(it&&typeof it==='object'){
          var q=parseInt(it.qty,10), p=Number(it.price);
          if(q>0&&isFinite(p)) cart[sk]={name:String(it.name||''), price:p, qty:q};
        }
      }
    }
  }catch(e){}

  function totals(){var q=0,s=0;for(var k in cart){q+=cart[k].qty;s+=cart[k].qty*cart[k].price;}return {q:q,s:s};}
  function render(){
    var t=totals();
    countEl.textContent=t.q;
    countEl.classList.toggle('show', t.q>0);
    $('cartBtn').setAttribute('aria-label', t.q ? ('Open cart, '+t.q+' item'+(t.q===1?'':'s')) : 'Open cart');
    subEl.textContent=money(t.s);
    try{ localStorage.setItem('esk_cart', JSON.stringify(cart)); }catch(e){}
    var FREE=150, rem=Math.max(0,FREE-t.s), pct=Math.min(100, t.s/FREE*100);
    if(shipWrap) shipWrap.style.display = t.q? 'block':'none';
    if(shipFill) shipFill.style.width = pct+'%';
    if(shipMsg && shipWrap){ if(t.s>=FREE){ shipMsg.textContent='Free delivery unlocked'; shipWrap.classList.add('done'); } else { shipMsg.textContent='You are '+money(rem)+' away from free delivery'; shipWrap.classList.remove('done'); } }
    if(!t.q){ itemsEl.innerHTML='<p class="cart-empty">Your cart is empty.</p>'; return; }
    var html='';
    for(var k in cart){var it=cart[k];
      html+='<div class="ci"><div class="ci-main"><div class="ci-name">'+it.name+'</div>'+
        '<div class="ci-price">'+money(it.price)+' each</div>'+
        '<div class="ci-qty"><button data-dec="'+k+'" aria-label="Decrease quantity">−</button><span>'+it.qty+'</span><button data-inc="'+k+'" aria-label="Increase quantity">+</button></div></div>'+
        '<div class="ci-line">'+money(it.price*it.qty)+'</div></div>';
    }
    itemsEl.innerHTML=html;
  }
  function openCart(){drawer.classList.add('open');overlay.classList.add('open');drawer.setAttribute('aria-hidden','false');}
  function closeCart(){drawer.classList.remove('open');overlay.classList.remove('open');drawer.setAttribute('aria-hidden','true');}
  function add(id,name,price){ if(cart[id])cart[id].qty++; else cart[id]={name:name,price:+price,qty:1}; render(); openCart(); }

  document.querySelectorAll('[data-add]').forEach(function(b){
    b.addEventListener('click',function(){add(b.dataset.add,b.dataset.name,b.dataset.price);});
  });
  itemsEl.addEventListener('click',function(e){
    var inc=e.target.getAttribute('data-inc'), dec=e.target.getAttribute('data-dec');
    if(inc){cart[inc].qty++;render();}
    else if(dec){cart[dec].qty--; if(cart[dec].qty<=0)delete cart[dec]; render();}
  });
  $('cartBtn').addEventListener('click',openCart);
  $('cartClose').addEventListener('click',closeCart);
  overlay.addEventListener('click',closeCart);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')closeCart();});
  $('cartCheckout').addEventListener('click',function(e){
    e.preventDefault();
    var t=totals(); if(!t.q)return;
    var lines='Hi Eskayvie, I would like to order:%0A';
    for(var k in cart){lines+='%0A• '+cart[k].qty+'x '+cart[k].name+' ('+money(cart[k].price)+')';}
    lines+='%0A%0ASubtotal: '+money(t.s);
    window.open('https://wa.me/'+WHATSAPP+'?text='+lines,'_blank');
  });

  /* sticky buy bar: show once the hero scrolls away, hide while the range buy block is on screen */
  var bar=$('buybar'), hero=document.querySelector('.hero'), range=$('range');
  function syncBar(){
    if(!bar||!hero)return;
    var vh=window.innerHeight, past=(window.scrollY||0) > (hero.offsetHeight*0.7);
    function inView(el){ if(!el)return false; var r=el.getBoundingClientRect(); return r.top<vh && r.bottom>0; }
    var nearBuy = inView(range) || inView(document.getElementById('begin')) || inView(document.querySelector('footer'));
    var show=past && !nearBuy;
    bar.classList.toggle('show', show);
    bar.setAttribute('aria-hidden', show?'false':'true');
  }
  addEventListener('scroll',syncBar,{passive:true});
  addEventListener('resize',syncBar,{passive:true});
  syncBar();

  /* email capture: validate + success state */
  var form=$('capForm');
  if(form){
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var email=$('capEmail'), msg=$('capMsg');
      var ok=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((email.value||'').trim());
      if(!ok){ form.classList.remove('ok'); email.focus(); msg.textContent='Please enter a valid email address.'; msg.classList.remove('cap-msg-ok'); return; }
      form.style.display='none';
      msg.textContent='You are in. Watch your inbox for the brain wellness guide.';
      msg.classList.add('cap-msg-ok');
      /* TODO: POST email.value to the real mailing-list endpoint */
    });
  }
  /* range pack selector: live price, per-day and add-to-cart sync */
  (function(){
    var packs=document.getElementById('packs'); if(!packs) return;
    var addBtn=document.getElementById('pkAdd'),
        now=document.getElementById('pkNow'), was=document.getElementById('pkWas'),
        sv=document.getElementById('pkSave'), day=document.getElementById('pkDay');
    function ctaLabel(total){ return 'Add to cart · RM'+Number(total).toLocaleString('en-US'); }
    packs.querySelectorAll('.pack').forEach(function(p){
      p.addEventListener('click',function(){
        packs.querySelectorAll('.pack').forEach(function(x){x.classList.remove('sel');x.setAttribute('aria-checked','false');});
        p.classList.add('sel'); p.setAttribute('aria-checked','true');
        now.textContent=p.dataset.now; was.textContent=p.dataset.was; sv.textContent=p.dataset.save; day.textContent=p.dataset.day;
        addBtn.dataset.add=p.dataset.id; addBtn.dataset.name=p.dataset.name; addBtn.dataset.price=p.dataset.total;
        addBtn.textContent=ctaLabel(p.dataset.total);
      });
    });
    addBtn.addEventListener('click',function(){
      addBtn.textContent='Added ✓';
      setTimeout(function(){ var s=packs.querySelector('.pack.sel'); if(s) addBtn.textContent=ctaLabel(s.dataset.total); },1300);
    });
  })();
  /* header hides on scroll-down past the hero, returns on scroll-up */
  (function(){
    var hdr=document.getElementById('hdr'); if(!hdr) return;
    var lastY=window.scrollY||0;
    addEventListener('scroll',function(){
      var y=window.scrollY||0;
      if(y>640 && y>lastY+6) hdr.classList.add('hide');
      else if(y<lastY-6 || y<=640) hdr.classList.remove('hide');
      lastY=y;
    },{passive:true});
  })();
  /* 3D stage: keep the drag hint visible until the first real interaction */
  (function(){ var stg=document.querySelector('.view3d-stage'), bst=document.getElementById('bottle-stage'); if(stg&&bst) bst.addEventListener('pointerdown',function(){stg.classList.add('touched');},{once:true}); })();
  /* studied-actives carousel: arrow nav + drag-to-scroll */
  (function(){
    var track=document.getElementById('ingTrack'); if(!track) return;
    function step(){ var c=track.querySelector('.ing-card'); var gap=parseFloat(getComputedStyle(track).columnGap)||18; return c?c.getBoundingClientRect().width+gap:320; }
    document.querySelectorAll('.ing-arrow').forEach(function(b){
      b.addEventListener('click',function(){ track.scrollBy({left:(+b.dataset.dir)*step(),behavior:'smooth'}); });
    });
    var down=false,sx=0,sl=0,moved=false;
    track.addEventListener('pointerdown',function(e){ if(e.pointerType!=='touch'){ down=true;sx=e.clientX;sl=track.scrollLeft;moved=false;track.classList.add('dragging'); try{track.setPointerCapture(e.pointerId);}catch(_){} } });
    track.addEventListener('pointermove',function(e){ if(!down)return; var dx=e.clientX-sx; if(Math.abs(dx)>4)moved=true; track.scrollLeft=sl-dx; });
    function endDrag(){ if(down){down=false;track.classList.remove('dragging');} }
    track.addEventListener('pointerup',endDrag); track.addEventListener('pointercancel',endDrag); track.addEventListener('pointerleave',endDrag);
    track.addEventListener('click',function(e){ if(moved){e.preventDefault();e.stopPropagation();} },true);
  })();
  /* neutralise placeholder # links so they do not yank to the top */
  document.querySelectorAll('a[href="#"]').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();});});
  render();
})();
</script>
<script>
/* ===== PREMIUM FOOTER: leaf-dot motif + back-to-top + newsletter + region ===== */
(function(){
  var REDUCEF = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ftr = document.querySelector('.ftr');
  if(!ftr) return;
  var motif = document.getElementById('ftrMotif');
  var LEAF = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6c-3.6 0-6.4 1.9-6.4 5.7 0 4.6 6.4 11.1 6.4 11.1s6.4-6.5 6.4-11.1c0-3.8-2.8-5.7-6.4-5.7Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M12 6.6v8.6" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>';
  var DOT  = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6" fill="currentColor"/></svg>';
  var spawned = false;
  function spawnLeaves(){
    if(spawned || !motif || REDUCEF) return;
    spawned = true;
    var N = innerWidth < 600 ? 7 : 14;
    var frag = document.createDocumentFragment();
    for(var i=0;i<N;i++){
      var el = document.createElement('i');
      el.className = 'ftr-leaf';
      var leaf = Math.random() > 0.45;
      var size = leaf ? (10 + Math.random()*16) : (3 + Math.random()*5);
      el.innerHTML = leaf ? LEAF : DOT;
      el.style.left = (Math.random()*100).toFixed(2) + '%';
      el.style.bottom = (-8 - Math.random()*12).toFixed(1) + '%';
      el.style.width = size.toFixed(1) + 'px';
      el.style.height = size.toFixed(1) + 'px';
      var dur = 16 + Math.random()*16;
      el.style.animationDuration = dur.toFixed(1) + 's';
      el.style.animationDelay = (-Math.random()*dur).toFixed(1) + 's';
      el.style.setProperty('--dx', (Math.random()*60 - 30).toFixed(1) + 'px');
      el.style.setProperty('--rot', (Math.random()*120 - 60).toFixed(0) + 'deg');
      el.style.setProperty('--op', (0.28 + Math.random()*0.4).toFixed(2));
      el.style.color = leaf ? (Math.random() > 0.5 ? 'rgba(160,135,220,.55)' : 'rgba(94,196,134,.42)') : 'rgba(246,197,68,.5)';
      frag.appendChild(el);
    }
    motif.appendChild(frag);
  }
  if('IntersectionObserver' in window){
    var mio = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ spawnLeaves(); mio.disconnect(); } }); }, {rootMargin:'200px'});
    mio.observe(ftr);
  } else { spawnLeaves(); }
  var topBtn = document.getElementById('ftrTop');
  if(topBtn){ topBtn.addEventListener('click', function(){ window.scrollTo({top:0, behavior: REDUCEF ? 'auto' : 'smooth'}); }); }
  var form = document.getElementById('ftrNewsForm');
  if(form){
    var input = document.getElementById('ftrNewsEmail');
    var ok = document.getElementById('ftrNewsOk');
    form.addEventListener('submit', function(ev){
      ev.preventDefault();
      if(input && !input.checkValidity()){ input.reportValidity(); return; }
      if(ok){ ok.hidden = false; }
      form.reset();
    });
  }
  var region = document.getElementById('ftrRegion');
  if(region){
    try{ var saved = localStorage.getItem('eskv_region'); if(saved) region.value = saved; }catch(e){}
    region.addEventListener('change', function(){ try{ localStorage.setItem('eskv_region', region.value); }catch(e){} });
  }
  /* fit the sign-off tagline to the exact width of the wordmark logo, edge to edge */
  var signImg = document.querySelector('.ftr-signoff img');
  var tagline = document.querySelector('.ftr-tagline');
  if(signImg && tagline){
    var fitTag = function(){
      var target = signImg.getBoundingClientRect().width;
      if(!target){ return; }
      tagline.style.whiteSpace = 'nowrap';
      tagline.style.fontSize = '100px';
      var w100 = tagline.getBoundingClientRect().width;
      if(!w100){ return; }
      var size = 100 * (target / w100);
      tagline.style.fontSize = size + 'px';
      var actual = tagline.getBoundingClientRect().width;   // correction pass for sub-pixel/kerning
      if(actual){ size = size * (target / actual); }
      size = Math.max(14, Math.min(size, 90));
      tagline.style.fontSize = size.toFixed(2) + 'px';
    };
    fitTag();
    if(!signImg.complete){ signImg.addEventListener('load', fitTag); }
    addEventListener('resize', fitTag);
    if(document.fonts && document.fonts.ready){ document.fonts.ready.then(fitTag); }
  }
})();
</script>
<script type="module">
/* ===== FOOTER: 3D "cloth of life" particle wave ===== */
import * as THREE from 'three';
(function(){
  const canvas = document.getElementById('ftrCloth');
  if(!canvas || !THREE) return;
  const host = canvas.parentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MOBILE = innerWidth < 760;
  let renderer, scene, camera, points, geo, mat, raf=0, running=false, built=false, t=0;
  const dims = () => ({ w: host.clientWidth||innerWidth, h: host.clientHeight||1 });

  function build(){
    if(built) return true;
    try{
      THREE.ColorManagement.enabled = false;
      renderer = new THREE.WebGLRenderer({canvas, alpha:true, antialias:true, powerPreference:'low-power'});
      renderer.setClearColor(0x000000, 0);
      const dpr = Math.min(devicePixelRatio||1, 2);
      renderer.setPixelRatio(dpr);
      const {w,h} = dims(); renderer.setSize(w,h,false);
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(40, w/h, 0.1, 120);
      camera.position.set(0, 4.6, 10);
      camera.lookAt(0, -0.8, -4);

      const COLS = MOBILE ? 150 : 240, ROWS = MOBILE ? 60 : 100;
      const SX = 34, SZ = 20, ZOFF = -4, N = COLS*ROWS;
      const pos = new Float32Array(N*3), rnd = new Float32Array(N);
      let p=0,q=0;
      for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
        pos[p++] = (c/(COLS-1)-0.5)*SX;
        pos[p++] = 0;
        pos[p++] = (r/(ROWS-1)-0.5)*SZ + ZOFF;
        rnd[q++] = Math.random();
      }
      geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pos,3));
      geo.setAttribute('aRand', new THREE.BufferAttribute(rnd,1));

      mat = new THREE.ShaderMaterial({
        transparent:true, depthTest:false, depthWrite:false, blending:THREE.NormalBlending,
        uniforms:{ uTime:{value:0}, uSize:{value: MOBILE?1.4:1.7}, uDpr:{value:dpr} },
        vertexShader: `
          uniform float uTime; uniform float uSize; uniform float uDpr;
          attribute float aRand;
          varying float vElev; varying float vFade; varying float vRand;
          void main(){
            vec3 pp = position; float x=pp.x, z=pp.z, tt=uTime; float y=0.0;
            y += sin(x*0.40 + tt*0.50) * 0.50;
            y += sin(z*0.66 - tt*0.36) * 0.38;
            y += sin((x+z)*0.28 + tt*0.62) * 0.26;
            y += sin((x*0.82 - z*0.52) + tt*0.92) * 0.12;
            pp.y = y; vElev = y; vRand = aRand;
            vec4 mv = modelViewMatrix * vec4(pp,1.0);
            float dist = -mv.z;
            vFade = clamp(1.0 - (dist-3.0)/26.0, 0.0, 1.0);
            gl_Position = projectionMatrix * mv;
            gl_PointSize = uSize * uDpr * (62.0/max(dist,1.0)) * (0.55 + aRand*0.75);
          }`,
        fragmentShader: `
          precision mediump float;
          varying float vElev; varying float vFade; varying float vRand;
          void main(){
            vec2 uv = gl_PointCoord - 0.5; float d = length(uv);
            float a = smoothstep(0.5, 0.10, d); if(a < 0.02) discard;
            float e = clamp(vElev*0.5 + 0.5, 0.0, 1.0);
            vec3 deep = vec3(0.12,0.07,0.21);
            vec3 midc = vec3(0.29,0.19,0.49);
            vec3 hic  = vec3(0.55,0.44,0.81);
            vec3 col = mix(deep, midc, smoothstep(0.0,0.62,e));
            col = mix(col, hic, smoothstep(0.6,1.0,e));
            float gold = smoothstep(0.93,1.0,e) * step(0.9, vRand);
            col = mix(col, vec3(0.86,0.70,0.34), gold*0.4);
            float alpha = a * vFade * (0.05 + 0.26*e);
            gl_FragColor = vec4(col, alpha);
          }`
      });

      points = new THREE.Points(geo, mat);
      scene.add(points);
      built = true;
      addEventListener('resize', onResize, {passive:true});
      window.__ftrCloth = { renderer, mat, start:()=>start(), stop:()=>stop(), render:()=>renderer.render(scene,camera),
        coverage:()=>{ const gl=renderer.getContext(); renderer.render(scene,camera);
          const W=renderer.domElement.width,H=renderer.domElement.height,px=new Uint8Array(W*H*4);
          gl.readPixels(0,0,W,H,gl.RGBA,gl.UNSIGNED_BYTE,px); let nz=0;
          for(let k=3;k<px.length;k+=4) if(px[k]>4) nz++;
          return {W,H,nonZero:nz,frac:+(nz/(W*H)).toFixed(4)}; } };
      return true;
    }catch(e){ console.error('[ftrCloth] build failed', e); return false; }
  }
  function onResize(){ if(!renderer) return; const {w,h}=dims(); camera.aspect=w/h; camera.updateProjectionMatrix(); renderer.setSize(w,h,false); if(!running) renderer.render(scene,camera); }
  function loop(){ if(!running) return; t += 0.0065; mat.uniforms.uTime.value = t; renderer.render(scene,camera); raf = requestAnimationFrame(loop); }
  function start(){ if(!built && !build()) return; if(reduce){ mat.uniforms.uTime.value = 3.0; renderer.render(scene,camera); return; } if(running) return; running=true; raf=requestAnimationFrame(loop); }
  function stop(){ running=false; cancelAnimationFrame(raf); }

  // build + paint one static frame on load so the cloth is present even when the
  // IntersectionObserver / rAF clock is throttled (idle or embedded previews)
  function boot(){ if(build()){ mat.uniforms.uTime.value = reduce ? 3.0 : 1.5; try{ renderer.render(scene,camera); }catch(e){} } }
  if('requestIdleCallback' in window){ requestIdleCallback(boot, {timeout:600}); } else { setTimeout(boot, 150); }
  // observer only drives the animation loop (start when in view, pause when out)
  if(!reduce && 'IntersectionObserver' in window){
    const io = new IntersectionObserver(es=>es.forEach(e=> e.isIntersecting ? start() : stop()), {rootMargin:'250px'});
    io.observe(host);
  } else if(!reduce){ start(); }
})();
</script>
<script src="assets/depth-engine.js"></script>
</body>
</html>
