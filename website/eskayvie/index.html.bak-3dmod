    <div class="right">
      <span class="region">Malaysia · EN</span>
      <a href="#range" class="btn btn-solid">Shop Mindtropic</a>
      <button class="cart-btn" id="cartBtn" aria-label="Open cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.4 12.3a1.6 1.6 0 0 0 1.6 1.3h8.2a1.6 1.6 0 0 0 1.6-1.2L22 7H6"/></svg><span class="cart-count" id="cartCount" aria-hidden="true">0</span></button>
    </div>
    <button class="menu-toggle" id="mtoggle" aria-label="Menu" aria-expanded="false" aria-controls="mmenu"><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mmenu" id="mmenu">
  <button class="x" id="mclose" aria-label="Close">×</button>
  <a href="#science">The Science</a>
  <a href="#formula">Formula</a>
  <a href="#view3d">3D View</a>
  <a href="#range">Range</a>
  <a href="#story">Our Story</a>
  <a href="#opportunity">Opportunity</a>
  <a href="#range" class="btn btn-solid" style="margin-top:1.5rem;align-self:flex-start">Shop Mindtropic</a>
</div>

<svg width="0" height="0" aria-hidden="true" style="position:absolute"><defs>
  <linearGradient id="gold" x1="0" y1="0" x2=".15" y2="1">
    <stop offset="0" stop-color="#FFF3C8"/><stop offset=".38" stop-color="#FFCB45"/><stop offset=".7" stop-color="#F5A81F"/><stop offset="1" stop-color="#D17A09"/>
  </linearGradient>
  <radialGradient id="winglow" cx="50%" cy="34%" r="72%"><stop offset="0" stop-color="#FFF8E4"/><stop offset="1" stop-color="#FFE2A6"/></radialGradient>
  <linearGradient id="figfade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#A8723E"/><stop offset="1" stop-color="#875729"/></linearGradient>
  <filter id="soft" x="-25%" y="-25%" width="150%" height="150%"><feGaussianBlur stdDeviation="3.2"/></filter>
</defs></svg>
<template id="star5">
  <span class="starrow" role="img" aria-label="Rated 5 out of 5 stars">
    <svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>
    <svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>
    <svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>
    <svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>
    <svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>
  </span>
</template>

<main id="top" tabindex="-1">

<!-- ===== HERO ===== -->
<section class="hero" data-no-orb>
  <div class="hero-bg" aria-hidden="true" data-parallax-root>
    <div class="hb-parallax"><div class="hb-photo"></div><video class="hb-video" autoplay muted playsinline preload="auto"><source src="assets/hero-loop3.mp4" type="video/mp4"></video><video class="hb-video" muted playsinline preload="auto"><source src="assets/hero-loop3.mp4" type="video/mp4"></video></div>
    <div class="hb-scrim"></div>
  </div>
  <div class="wrap hero-grid">
    <div class="copy">
      <span class="eyebrow reveal"><svg class="bw-brain" width="23" height="23" viewBox="0 0 24 24" fill="none" aria-hidden="true"><defs><linearGradient id="bwBrainGrad" x1="3" y1="2" x2="21" y2="22" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#7B5FC0"/><stop offset="0.55" stop-color="#5B3FA0"/><stop offset="1" stop-color="#3A2470"/></linearGradient><radialGradient id="bwBrainSpark" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#9CF0B6"/><stop offset="0.4" stop-color="#2F8F4E"/><stop offset="1" stop-color="#2F8F4E" stop-opacity="0"/></radialGradient><filter id="bwBrainGlow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="0.9" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs><path filter="url(#bwBrainGlow)" fill="url(#bwBrainGrad)" d="M11 3.2c-1.5-.7-3.4-.4-4.5.8-.6.6-.9 1.4-.9 2.2-1 .3-1.8 1.1-2 2.2-.2 1 .1 2 .8 2.7-.5.8-.6 1.8-.2 2.7.4.9 1.2 1.5 2.1 1.7.1 1.2 1 2.2 2.2 2.5 1 .2 2-.1 2.7-.8V3.7c-.6-.3-1.3-.4-2-.5z"/><path filter="url(#bwBrainGlow)" fill="url(#bwBrainGrad)" opacity="0.92" d="M13 3.2c1.5-.7 3.4-.4 4.5.8.6.6.9 1.4.9 2.2 1 .3 1.8 1.1 2 2.2.2 1-.1 2-.8 2.7.5.8.6 1.8.2 2.7-.4.9-1.2 1.5-2.1 1.7-.1 1.2-1 2.2-2.2 2.5-1 .2-2-.1-2.7-.8V3.7c.6-.3 1.3-.4 2-.5z"/><path stroke="#FFFFFF" stroke-opacity="0.5" stroke-width="0.7" stroke-linecap="round" fill="none" d="M12 5v13M9 7.5c1 .3 1.8 1 2 2M15 9c-1 .3-1.8 1-2 2M9.5 13c1.1.1 2 .8 2.5 1.7"/><circle class="bw-brain-spark" cx="12" cy="11.5" r="2.4" fill="url(#bwBrainSpark)"/><circle class="bw-brain-core" cx="12" cy="11.5" r="0.9" fill="#EAFBEF"/></svg>Brain wellness · Since 2009</span>
      <h1 class="reveal d1">The science of<br>a <span class="gw">sharper</span> mind.</h1>
      <p class="lead reveal d2">Mindtropic is a daily chewable brain formula built on clinically studied actives, Phosphatidylserine and KSM&#8209;66 Ashwagandha, to support focus, memory and a calmer mind.</p>
      <div class="hero-cta reveal d3">
        <a href="#range" class="btn btn-solid">Shop Mindtropic</a>
        <a href="#science" class="btn-text">See the science <span class="arr">→</span></a>
        <span class="hero-price"><b>RM75</b><s>RM95</s><em>Save RM20</em></span>
      </div>
      <div class="hero-proof reveal d4">
        <span class="starrow lg" role="img" aria-label="Rated 5 out of 5 stars">
          <svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>
        </span>
        <span><b>Trusted by over 100,000</b> families across Malaysia, Singapore, Brunei &amp; Indonesia</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== TRUST STRIP ===== -->
<div class="trust">
  <div class="wrap">
    <div class="item">
      <span class="t-ico" aria-hidden="true"><img class="cert3d" src="assets/cert-halal.png" alt="" decoding="async"></span>
      <span class="t-lbl"><b>Halal Certified</b><span class="sub">JAKIM approved</span></span></div>
    <div class="item">
      <span class="t-ico kkm" aria-hidden="true"><img class="cert3d" src="assets/cert-kkm.png" alt="" decoding="async"></span>
      <span class="t-lbl"><b>KKM Notified</b><span class="sub">Ministry of Health</span></span></div>
    <div class="item">
      <span class="t-ico iso" aria-hidden="true"><img class="cert3d" src="assets/cert-iso.png" alt="" decoding="async"></span>
      <span class="t-lbl"><b>ISO 9001</b><span class="sub">Quality certified</span></span></div>
    <div class="item">
      <span class="t-ico clinical" aria-hidden="true"><img class="cert3d" src="assets/cert-clinical.png" alt="" decoding="async"></span>
      <span class="t-lbl"><b>Clinically Studied</b><span class="sub">Actives at real doses</span></span></div>
  </div>
</div>

<!-- ===== 3D VIEW ===== -->
<section id="view3d" class="view3d" data-no-orb>
  <div class="wrap view3d-head">
    <div class="shead reveal">
      <span class="eyebrow">Interactive · 3D</span>
      <h2>Turn it over. We left nothing off the label.</h2>
      <p class="lead">The real bottle, the real label. Drag to turn it, then tap to twist the cap off and tip the tablets out.</p>
    </div>
  </div>
  <div class="view3d-stage reveal d1">
    <div id="bottle-stage" tabindex="0" role="img" aria-label="Interactive 3D model of the Eskayvie Mindtropic bottle. Drag to turn it, tap to open the cap.">
      <img class="stage-fallback" src="assets/cut-mindtropic.png?v=2" alt="Eskayvie Mindtropic bottle, the real product" decoding="async">
    </div>
    <p class="stage-hint"><span aria-hidden="true">↻</span> Drag to turn · tap to open</p>
  </div>
</section>

<!-- ===== PROMISE / SCIENCE INTRO ===== -->
<section id="science" class="science" data-no-orb>
  <div class="wrap">
    <div class="shead reveal">
      <span class="eyebrow">What is inside</span>
      <h2>Studied actives, named and dosed in the open.</h2>
      <p class="lead">Most brain supplements hide behind a "proprietary blend." Mindtropic does the opposite. Its lead actives are studied ingredients, used at the doses researchers actually tested, then paired with a supporting cast for everyday focus.</p>
    </div>

    <div class="ing-carousel reveal" id="ingCarousel">
      <div class="ing-track" id="ingTrack" role="list" tabindex="0" aria-label="Studied actives. Drag or swipe to explore.">
        <!-- PS -->
        <article class="ing-card" role="listitem" data-tilt>
          <div class="ing-cmedia"><span class="ing-num">01</span><img src="assets/ing-ps.png" alt="Neural network representing brain cell membranes" loading="lazy" draggable="false"></div>
          <div class="ing-cbody">
            <div class="ing-top"><span class="ing-ico" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="#5B3FA0" stroke-width="1.6"><circle cx="14" cy="16" r="4"/><circle cx="24" cy="16" r="4"/><circle cx="34" cy="16" r="4"/><line x1="14" y1="20" x2="14" y2="34"/><line x1="24" y1="20" x2="24" y2="34"/><line x1="34" y1="20" x2="34" y2="34"/><circle cx="14" cy="32" r="4"/><circle cx="24" cy="32" r="4"/><circle cx="34" cy="32" r="4"/></svg></span><h3>Phosphatidylserine</h3></div>
            <span class="ing-evidence ev-mod">Human evidence: moderate</span>
            <p>A phospholipid that is a structural building block of your brain cell membranes. It helps support normal memory and cognitive function, and has been studied for focus and attention.</p>
            <div class="ing-dose"><span>Studied at</span> <b>100 to 300 mg</b> <span>daily, over 6 to 12 weeks</span></div>
          </div>
        </article>
        <!-- KSM-66 -->
        <article class="ing-card" role="listitem" data-tilt>
          <div class="ing-cmedia"><span class="ing-num">02</span><img src="assets/ing-ashwagandha.png" alt="Ashwagandha roots" loading="lazy" draggable="false"></div>
          <div class="ing-cbody">
            <div class="ing-top"><span class="ing-ico ing-ico--g" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="#3F8F46" stroke-width="1.6"><path d="M24 40c0-9 0-16 0-22"/><path d="M24 22c-5-1-9-5-9-11 6 0 9 4 9 11z"/><path d="M24 26c5-1 9-5 9-11-6 0-9 4-9 11z"/><path d="M24 34c-4-1-7-4-7-9 5 0 7 4 7 9z"/></svg></span><h3>KSM&#8209;66 Ashwagandha</h3></div>
            <span class="ing-evidence ev-strong">Human evidence: strong for stress</span>
            <p>The most clinically studied ashwagandha root extract. It helps the body adapt to everyday stress and supports a sense of calm, with emerging evidence for focus and mental clarity on demanding days.</p>
            <div class="ing-dose"><span>Studied at</span> <b>300 to 600 mg</b> <span>daily, standardised to withanolides</span></div>
          </div>
        </article>
        <!-- Bacopa -->
        <article class="ing-card" role="listitem" data-tilt>
          <div class="ing-cmedia"><span class="ing-num">03</span><img src="assets/ing-bacopa.png" alt="Fresh Bacopa monnieri herb" loading="lazy" draggable="false"></div>
          <div class="ing-cbody">
            <div class="ing-top"><span class="ing-ico" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="#5B3FA0" stroke-width="1.6"><path d="M24 42V14"/><ellipse cx="17" cy="20" rx="6" ry="3.4" transform="rotate(-28 17 20)"/><ellipse cx="31" cy="24" rx="6" ry="3.4" transform="rotate(28 31 24)"/><ellipse cx="19" cy="30" rx="5" ry="3" transform="rotate(-24 19 30)"/><circle cx="24" cy="11" r="3"/></svg></span><h3>Bacopa Monnieri</h3></div>
            <span class="ing-evidence ev-mod">Human evidence: moderate</span>
            <p>A traditional botanical long used for the mind and studied for memory and learning. It supports memory retention and mental clarity as part of a daily routine.</p>
            <div class="ing-dose"><span>Paired with</span> <b>Beetroot, Magnesium Glycinate &amp; Selenium</b></div>
          </div>
        </article>
      </div>
      <div class="ing-nav">
        <span class="ing-hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M5 12l4-4M5 12l4 4M19 12l-4-4M19 12l-4 4"/></svg> Drag or swipe to explore</span>
        <div class="ing-arrows">
          <button type="button" class="ing-arrow" data-dir="-1" aria-label="Previous active"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
          <button type="button" class="ing-arrow" data-dir="1" aria-label="Next active"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== FORMULA / TRANSPARENCY ===== -->
<section id="formula" class="tint" data-no-orb>
  <div class="wrap facts">
    <div class="reveal"><div class="ing-media frame" style="aspect-ratio:4/5;max-height:580px;margin:0 auto"><img src="assets/ing-berries.png" alt="Fresh mixed berries, the Mindtropic flavour" loading="lazy"></div></div>
    <div class="reveal d1">
      <span class="eyebrow">The full formula</span>
      <h2 style="margin:.7rem 0 1.3rem">Nothing hidden. Nothing wasted.</h2>
      <div class="neg" style="margin-bottom:1.9rem">
        <div class="line"><span class="neg-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4 4 9-9.5" stroke="#236B3C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span> No proprietary blends. Every active is named.</div>
        <div class="line"><span class="neg-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4 4 9-9.5" stroke="#236B3C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span> No artificial colours or flavours.</div>
        <div class="line"><span class="neg-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4 4 9-9.5" stroke="#236B3C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span> Chewable. Mixed berries. No water needed.</div>
        <div class="line"><span class="neg-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4 4 9-9.5" stroke="#236B3C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span> Halal certified and KKM notified.</div>
      </div>
      <div class="facts-list">
        <div class="facts-row"><span class="n">Phosphatidylserine</span><span class="r">Memory &amp; cognitive support</span></div>
        <div class="facts-row"><span class="n">KSM&#8209;66 Ashwagandha</span><span class="r">Stress &amp; calm</span></div>
        <div class="facts-row"><span class="n">Bacopa Monnieri</span><span class="r">Memory &amp; clarity</span></div>
        <div class="facts-row"><span class="n">Beetroot extract</span><span class="r">Circulatory support</span></div>
        <div class="facts-row"><span class="n">Magnesium Glycinate</span><span class="r">Normal nervous system function</span></div>
        <div class="facts-row"><span class="n">Selenium</span><span class="r">Antioxidant defence</span></div>
      </div>
      <p class="cap-note">Exact per serving amounts are printed on pack. Ingredient roles reflect general nutrition science, not claims to treat or prevent any condition.</p>
    </div>
  </div>
</section>

<!-- ===== STAT BAND ===== -->
<section class="band">
  <div class="wrap">
    <div class="statrow">
      <div class="s reveal"><div class="stat-num" data-count="100000" data-suffix="+">100,000+</div><div class="cap">Families served</div></div>
      <div class="s reveal d1"><div class="stat-num" data-count="2009" data-plain="1">2009</div><div class="cap">Founded in Malaysia</div></div>
      <div class="s reveal d2"><div class="stat-num" data-count="4" data-suffix="">4</div><div class="cap">Markets across SEA</div></div>
      <div class="s reveal d3"><div class="stat-num" data-count="6" data-suffix="">6</div><div class="cap">Named brain actives</div></div>
    </div>
  </div>
</section>

<!-- ===== TIMELINE ===== -->
<section class="tint">
  <div class="wrap">
    <div class="shead reveal">
      <span class="eyebrow">How it works</span>
      <h2>Built to work over weeks, not minutes.</h2>
      <p class="lead">Phosphatidylserine and ashwagandha are studied with daily use over time. Think of Mindtropic as a routine you build, the way you would any foundation worth keeping.</p>
    </div>
    <div class="tl reveal d1" id="tl">
      <div class="tl-track"><div class="tl-fill" id="tlfill"></div></div>
      <div class="tl-steps">
        <div class="tl-step"><div class="w">Week 1</div><p>A daily ritual begins. One chewable, mixed berries, no water.</p></div>
        <div class="tl-step"><div class="w">Week 4</div><p>The window where studied actives are typically measured.</p></div>
        <div class="tl-step"><div class="w">Week 12</div><p>The full study window for memory and stress support.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ===== RANGE ===== -->
<section id="range">
  <div class="wrap">
    <div class="shead center reveal" style="margin:0 auto 3rem">
      <span class="eyebrow">The flagship family</span>
      <h2 style="margin-top:.7rem">One foundation, for every age.</h2>
    </div>

    <div class="range-row reveal">
      <div class="media range-media"><img src="assets/health-wellness.png" alt="Eskayvie Mindtropic, Diffenz, Mindtropic Junior and Diffenz Junior" loading="lazy" decoding="async"></div>
      <div class="copy buycard">
        <div class="range-role">Brain wellness · For ages 2 and up</div>
        <h3>Mindtropic &amp; Mindtropic Junior</h3>
        <p>The adult chewable pairs Phosphatidylserine, KSM&#8209;66 Ashwagandha and Bacopa for focus, memory and a calmer mind. Mindtropic Junior adds Lutein and plant omega-3 for growing minds, in a chocolate chew kids ask for.</p>
        <span class="supply">30 chewables · one a day · mixed berries</span>
        <div class="price"><span class="now" id="pkNow">RM75</span><span class="was" id="pkWas">RM95</span><span class="save" id="pkSave">Save RM20</span></div>
        <p class="price-day">Just <b id="pkDay">RM2.50 a day · 1-month supply</b></p>
