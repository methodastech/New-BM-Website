          <span class="vt-dur"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>0:55</span>
          <span class="vt-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
          <span class="vt-meta">
            <span class="vt-pull">"School mornings are so much calmer now."</span>
            <span class="vt-who"><span class="nm">Amir Hakim</span><span class="dot">·</span><span class="rl">Dad of three · Kuching</span></span>
          </span>
        </button>
      </div>
    </div>

    <div class="vt-foot reveal">
      <span class="starrow lg" data-stars role="img" aria-label="Rated 4.8 out of 5"></span>
      <span class="vt-foot-note"><b>1,200+</b> tagged clips and counting · loved by <b>100,000+</b> families across SEA</span>
    </div>
  </div>

  <!-- LIGHTBOX (one instance, reused for every card) -->
  <div class="vtlb" id="vtLightbox" role="dialog" aria-modal="true" aria-labelledby="vtlbName" hidden>
    <div class="vtlb-overlay" data-vtlb-close></div>
    <div class="vtlb-dialog" role="document">
      <button type="button" class="vtlb-close" id="vtlbClose" aria-label="Close video">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <div class="vtlb-stage">
        <video id="vtlbVideo" playsinline controls preload="none"></video>
        <div class="vtlb-soon" id="vtlbSoon">
          <span class="ring" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
          <b>Clip coming soon</b>
          <span>This testimonial is being edited for the wall. Check back shortly to watch the full story.</span>
        </div>
      </div>
      <div class="vtlb-cap">
        <p class="vtlb-pull" id="vtlbPull"></p>
        <span class="vt-who"><span class="nm" id="vtlbName"></span><span class="dot">·</span><span class="rl" id="vtlbRole"></span></span>
      </div>
    </div>
  </div>
</section>

<script>
/* ===== Video testimonials: accessible lightbox (self-contained) ===== */
(function(){
  var section=document.getElementById('video-reviews');
  var lb=document.getElementById('vtLightbox');
  if(!section||!lb) return;
  var dialog=lb.querySelector('.vtlb-dialog');
  var video=document.getElementById('vtlbVideo');
  var soon=document.getElementById('vtlbSoon');
  var closeBtn=document.getElementById('vtlbClose');
  var elName=document.getElementById('vtlbName');
  var elRole=document.getElementById('vtlbRole');
  var elPull=document.getElementById('vtlbPull');
  var STAR='<svg viewBox="0 0 24 24"><path d="M12 2.2l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.3l-5.9 3.1 1.13-6.57L2.45 9.14l6.6-.96z" fill="url(#gold)"/></svg>';
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var lastFocus=null, isOpen=false;

  // fill any star placeholders local to this section (idempotent if main script already ran)
  section.querySelectorAll('[data-stars]').forEach(function(el){ if(!el.children.length) el.innerHTML=STAR.repeat(5); });

  function focusables(){
    return Array.prototype.filter.call(
      lb.querySelectorAll('button, video, [href], [tabindex]:not([tabindex="-1"])'),
      function(n){ return n.offsetParent!==null || n===video; }
    );
  }

  function open(card){
    if(isOpen) return;
    lastFocus=card;
    var src=(card.getAttribute('data-src')||'').trim();
    elName.textContent=card.getAttribute('data-name')||'';
    elRole.textContent=card.getAttribute('data-role')||'';
    elPull.textContent='“'+(card.getAttribute('data-pull')||'')+'”';

    if(src){
      soon.style.display='none';
      video.classList.add('show');
      video.setAttribute('src',src);
      video.currentTime=0;
    }else{
      // no clip yet: show the graceful "coming soon" poster state instead of erroring
      video.classList.remove('show');
      video.removeAttribute('src'); video.load();
      soon.style.display='';
    }

    lb.hidden=false;
    // next frame so the open transition runs
    requestAnimationFrame(function(){ lb.classList.add('open'); });
    document.body.style.overflow='hidden';
    isOpen=true;
    closeBtn.focus();
    if(src && !reduce){ var p=video.play&&video.play(); if(p&&p.catch) p.catch(function(){}); }
    document.addEventListener('keydown',onKey,true);
  }

  function close(){
    if(!isOpen) return;
    lb.classList.remove('open');
    try{ video.pause(); }catch(e){}
    document.body.style.overflow='';
    isOpen=false;
    document.removeEventListener('keydown',onKey,true);
    var finish=function(){
      lb.hidden=true;
      video.removeAttribute('src'); video.load();
      if(lastFocus && lastFocus.focus) lastFocus.focus();
    };
    if(reduce){ finish(); }
    else{
      var done=false;
      var onEnd=function(){ if(done) return; done=true; dialog.removeEventListener('transitionend',onEnd); finish(); };
      dialog.addEventListener('transitionend',onEnd);
      setTimeout(onEnd,360); // fallback if transitionend never fires
    }
  }

  function onKey(e){
    if(e.key==='Escape'){ e.preventDefault(); close(); return; }
    if(e.key==='Tab'){ // focus trap
      var f=focusables(); if(!f.length) return;
      var first=f[0], last=f[f.length-1];
      if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
      else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
    }
  }

  section.querySelectorAll('.vt-card').forEach(function(card){
    card.addEventListener('click',function(){ open(card); });
  });
  closeBtn.addEventListener('click',close);
  lb.querySelectorAll('[data-vtlb-close]').forEach(function(el){ el.addEventListener('click',close); });
  video.addEventListener('error',function(){ // src set but failed to load → fall back to soon state
    if(isOpen && video.getAttribute('src')){ video.classList.remove('show'); soon.style.display=''; }
  });
})();
</script>

