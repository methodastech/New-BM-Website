<!-- ===== STORY ===== -->
<section id="story" class="tint" data-no-orb>
  <div class="wrap story-grid">
    <div class="story-media reveal"><video class="story-video" autoplay muted loop playsinline preload="auto" poster="assets/this-is-eskayvie-2.png" aria-label="Eskayvie reception in Shah Alam"><source src="assets/story-loop.mp4" type="video/mp4"><img src="assets/this-is-eskayvie-2.png" alt="Eskayvie headquarters reception in Shah Alam" loading="lazy" decoding="async"></video></div>
    <div class="reveal d1">
      <span class="eyebrow">This is Eskayvie</span>
      <h2 style="margin:.7rem 0 1.2rem">A Malaysian wellness house, built on trust.</h2>
      <p class="lead">Founded in 2009 and headquartered in Shah Alam, Eskayvie formulates halal, science minded supplements for families across Malaysia, Singapore, Brunei and Indonesia. From brain wellness to immunity and Sunnah nutrition, every product is made to be trusted, and to help potential evolve at any age.</p>
      <div class="founders">
        <img src="assets/eskayvie-know-our-story-2.png" alt="Eskayvie founders" loading="lazy" decoding="async">
        <span>Founded by <b style="color:var(--ink)">Dr Syid Ayob</b> &amp; <b style="color:var(--ink)">Dr Kartika Wati Mohamed</b></span>
      </div>
    </div>
  </div>
</section>

<!-- ===== OPPORTUNITY (DARK) ===== -->
<section id="opportunity" class="dark">
  <div class="wrap">
    <div class="shead reveal">
      <span class="eyebrow">The opportunity</span>
      <h2 style="margin:.7rem 0 1.2rem">Build more than income.<br>Build a future.</h2>
      <p class="lead">Beyond the products is a community of over 100,000. Start as a customer, grow into a business, on your terms, with training and a digital toolkit behind you.</p>
    </div>
    <div class="tiers">
      <div class="tier reveal"><div class="k">Start here</div><h3>Preferred Customer</h3><p>Member pricing and birthday rewards. The simplest way in.</p><div class="entry">From RM20</div></div>
      <div class="tier reveal d1"><div class="k">Grow</div><h3>Nexus Apprentice</h3><p>Your first step as an agent, with a starter kit and the Nexus portal.</p><div class="entry">From RM80</div></div>
      <div class="tier reveal d2"><div class="k">Lead</div><h3>Agent</h3><p>Build a team and earn up to 40 percent as your monthly sales grow.</p><div class="entry">Membership kit</div></div>
    </div>
    <div class="reveal d2" style="margin-top:2.5rem"><a href="#opportunity" class="btn btn-light">Explore the opportunity</a></div>
  </div>
</section>

<!-- ===== EMAIL CAPTURE ===== -->
<section>
