/* ---- core reveal animation: .rv -> .in on scroll ---- */
(function(){
  var scope=document.getElementById('pg-pricing')||document;
  if(!('IntersectionObserver' in window)){
    scope.querySelectorAll('.rv').forEach(function(el){el.classList.add('in');});
    return;
  }
  var rio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');rio.unobserve(e.target);}});},{threshold:.12,rootMargin:'0px 0px -7% 0px'});
  function observe(){scope.querySelectorAll('.rv:not(.in)').forEach(function(el){rio.observe(el);});}
  if(document.readyState!=='loading')observe(); else document.addEventListener('DOMContentLoaded',observe);
  /* re-scan after the DOM-mutating widgets below have run */
  window.addEventListener('load',observe);
  setTimeout(observe,300);
})();

/* ---- collapsible dropdown bars (Why rebrand / six phases) ---- */
window.ddropToggle=function(key){var panel=document.getElementById('ddrop-'+key),bar=document.getElementById('ddrop-'+key+'-bar');if(!panel||!bar)return;var opening=!panel.classList.contains('open');panel.classList.toggle('open',opening);bar.classList.toggle('open',opening);bar.setAttribute('aria-expanded',opening?'true':'false');if(opening){panel.querySelectorAll('.rv').forEach(function(e){e.classList.add('in');});}};

/* ---- proc6 phase tab switching ---- */
(function(){
function initProc6(){
  var tabs=[].slice.call(document.querySelectorAll('.proc6-tab'));
  var panels=[].slice.call(document.querySelectorAll('.proc6-panel'));
  if(!tabs.length)return;
  tabs.forEach(function(t){t.addEventListener('click',function(){
    var i=t.getAttribute('data-ph');
    tabs.forEach(function(x){x.classList.remove('active');});
    panels.forEach(function(p){p.classList.toggle('active', p.getAttribute('data-pp')===i);});
    t.classList.add('active');
  });});
}
if(document.readyState!=='loading')initProc6(); else document.addEventListener('DOMContentLoaded',initProc6);
})();

/* ---- Brand Journey roadmap (replaces the proc6 rail with stops) ---- */
(function(){
  function build(){
    var rail=document.querySelector('.proc6-rail');
    if(!rail||document.querySelector('.p6road'))return;
    var tabs=[].slice.call(rail.querySelectorAll('.proc6-tab'));
    if(!tabs.length)return;
    var road=document.createElement('div'); road.className='p6road';
    var track=document.createElement('div'); track.className='p6road-track'; road.appendChild(track);
    tabs.forEach(function(t){
      var pc=((t.getAttribute('style')||'').match(/--pc:\s*(#[0-9A-Fa-f]+)/)||[])[1]||'#1a26de';
      var n=(t.querySelector('.proc6-n')||{}).textContent||'';
      var nm=(t.querySelector('.proc6-nm')||{}).textContent||'';
      var dur=(t.querySelector('.proc6-dur')||{}).textContent||'';
      var stop=document.createElement('button');
      stop.type='button'; stop.className='p6stop'+(t.classList.contains('active')?' active':'');
      stop.style.setProperty('--pc',pc);
      stop.innerHTML='<span class="p6dot">'+n+'</span><span class="p6lab"><span class="p6nm">'+nm+'</span><span class="p6dur">'+dur+'</span></span>';
      stop.addEventListener('click',function(){
        t.click();
        road.querySelectorAll('.p6stop').forEach(function(s){s.classList.remove('active');});
        stop.classList.add('active');
      });
      road.appendChild(stop);
    });
    rail.parentNode.insertBefore(road,rail);
    if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting&&e.intersectionRatio>0){road.classList.add('in');}})},{threshold:.15});io.observe(road);}
    else road.classList.add('in');
  }
  if(document.readyState!=='loading')build(); else document.addEventListener('DOMContentLoaded',build);
})();

/* ---- ptab switching (kept for direct tab activation) ---- */
(function(){
  document.addEventListener('click',function(e){
    var btn=e.target.closest('.ptab');
    if(btn){activatePTab(btn.getAttribute('data-ptab'));return}
    var lnk=e.target.closest('a[data-ptab]');
    if(lnk){var idx=lnk.getAttribute('data-ptab');setTimeout(function(){activatePTab(idx);var ps=document.querySelector('.ptabs');if(ps)ps.scrollIntoView({behavior:'smooth',block:'center'})},170)}
  });
  function activatePTab(idx){
    document.querySelectorAll('.ptab').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-ptab')===idx)});
    document.querySelectorAll('.ptab-panel').forEach(function(pn){
      var on=pn.getAttribute('data-ppanel')===idx;
      pn.classList.toggle('active',on);
      if(on) pn.querySelectorAll('.rv').forEach(function(r){r.classList.add('in')});
    });
  }
})();

/* ---- inject "Get started" CTA into each pricing tier ---- */
(function(){var t=document.querySelectorAll(".ptab-panel .ptier");t.forEach(function(c){if(c.querySelector(".ptier-cta"))return;var a=document.createElement("a");a.className="ptier-cta";a.href="contact.html";a.innerHTML='Get started <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';c.appendChild(a);});})();

/* ---- tier-level progress meters ---- */
(function(){
  function meters(){
    document.querySelectorAll('.price-grid').forEach(function(grid){
      var tiers=grid.querySelectorAll('.ptier'); var n=tiers.length;
      tiers.forEach(function(t,i){
        if(t.querySelector('.ptier-meter'))return;
        var m=document.createElement('div'); m.className='ptier-meter';
        for(var k=0;k<n;k++){var s=document.createElement('i'); if(k<=i)s.className='on'; m.appendChild(s);}
        var a=t.querySelector('.ptier-tag')||t.querySelector('.ptier-name');
        if(a&&a.parentNode) a.parentNode.insertBefore(m, a.nextSibling);
      });
    });
  }
  if(document.readyState!=='loading')meters(); else document.addEventListener('DOMContentLoaded',meters);
})();

/* ---- coloured band layout + sticky quick-jump nav ---- */
(function(){
  function init(){
    var pp=document.getElementById('pg-pricing'); if(!pp) return;
    var panels=[].slice.call(pp.querySelectorAll('.ptab-panel'));
    if(!panels.length || panels[0].getAttribute('data-banded')) return;
    var tabs=[].slice.call(pp.querySelectorAll('.ptab'));
    var labels=tabs.map(function(b){return b.innerHTML;});
    var ICONS=[
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10l3 5-8 11L4 9z"/><path d="M4 9h16" stroke-opacity=".6"/><path d="M9.5 4 8 9l4 11 4-11-1.5-5" stroke-opacity=".5"/></svg>',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="12.5" height="10"/><path d="M3 7.6h12.5" stroke-opacity=".6"/><rect x="14.5" y="10" width="6.5" height="9.5"/></svg>',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M10 8.4 16 12 10 15.6z" fill="currentColor" stroke="none"/></svg>',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16" stroke-opacity=".55"/><path d="M5 15l4-4 3 2 6-7"/><path d="M18 5h-3M18 5v3"/></svg>',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2.4"/><circle cx="5" cy="6" r="1.7"/><circle cx="19" cy="6" r="1.7"/><circle cx="5" cy="18" r="1.7"/><circle cx="19" cy="18" r="1.7"/><path d="M6.3 7.1 10 10.2M17.7 7.1 14 10.2M6.3 16.9 10 13.8M17.7 16.9 14 13.8" stroke-opacity=".55"/></svg>',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 5.1L20 9l-4 3.4L17 18l-5-2.7L7 18l1-5.6L4 9l5.8-.9z"/></svg>'
    ];
    var TAGS=['Brand OS','Build','Studio','Growth','Operations','Essentials'];
    panels.forEach(function(panel,i){
      panel.setAttribute('data-banded','1');
      panel.classList.add('pband');
      panel.id='pband-'+i;
      var sub=panel.querySelector('.ptab-sub');
      var subTxt=sub?sub.textContent:'';
      var head=document.createElement('div');
      head.className='pband-head';
      head.innerHTML='<span class="pband-ic">'+(ICONS[i]||ICONS[0])+'</span><span class="pband-tt"><span class="pband-name">'+(labels[i]||'')+'</span>'+(subTxt?'<span class="pband-sub">'+subTxt+'</span>':'')+'</span><span class="pband-tag">'+(TAGS[i]||'')+'</span>';
      if(sub) sub.remove();
      panel.insertBefore(head, panel.firstChild);
    });
    function jump(idx){var t=document.getElementById('pband-'+idx);if(t){var y=window.scrollY+t.getBoundingClientRect().top-96;window.scrollTo({top:y,behavior:'smooth'});}}
    tabs.forEach(function(b){b.addEventListener('click',function(){jump(b.getAttribute('data-ptab'));});});
    document.addEventListener('click',function(e){var a=e.target.closest('a[data-ptab]');if(a){var idx=a.getAttribute('data-ptab');setTimeout(function(){jump(idx);},230);}});
    var ticking=false;
    function spy(){ticking=false;var best=0,bestD=1e9;panels.forEach(function(p,i){var d=Math.abs(p.getBoundingClientRect().top-150);if(d<bestD){bestD=d;best=i;}});tabs.forEach(function(t,i){t.classList.toggle('active',i===best);});}
    window.addEventListener('scroll',function(){if(!ticking){ticking=true;requestAnimationFrame(spy);}},{passive:true});
  }
  if(document.readyState!=='loading')init(); else document.addEventListener('DOMContentLoaded',init);
})();

/* ---- feedback widget (stars, chips, WhatsApp / email send) ---- */
(function(){
  function init(){
    var f=document.getElementById('fbForm'); if(!f) return;
    var rating=0;
    var stars=[].slice.call(f.querySelectorAll('.fbk-stars button'));
    var hint=document.getElementById('fbStarHint');
    stars.forEach(function(b){b.addEventListener('click',function(){rating=+b.getAttribute('data-v');stars.forEach(function(s){s.classList.toggle('on',(+s.getAttribute('data-v'))<=rating)});if(hint)hint.textContent='Rated '+rating+' / 5';});});
    f.querySelectorAll('.fbk-chips button').forEach(function(c){c.addEventListener('click',function(){c.classList.toggle('on');});});
    function val(n){var e=f.querySelector('[name='+n+']');return e?e.value.trim():'';}
    function collect(){
      var chips=[].map.call(f.querySelectorAll('.fbk-chips button.on'),function(c){return c.textContent.trim();});
      var L=['BrandMethod pricing page feedback','Rating: '+(rating?rating+'/5':'not rated')];
      if(chips.length)L.push('Tags: '+chips.join(', '));
      var im=val('fbImprove'); if(im)L.push('Improve or fix: '+im);
      var ad=val('fbAdd'); if(ad)L.push('Would add: '+ad);
      var nm=val('fbName'); if(nm)L.push('Name: '+nm);
      var ct=val('fbContact'); if(ct)L.push('Contact: '+ct);
      return L.join('\n');
    }
    function done(){var w=document.createElement('div');w.className='fbk-done';w.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span>Thank you. Your feedback is on its way to the team.</span>';f.parentNode.replaceChild(w,f);}
    var em=document.getElementById('fbEm'); if(em)em.addEventListener('click',function(){
      var orig=em.textContent; em.disabled=true; em.textContent='Sending...';
      var fd=new FormData();
      fd.append('_subject','Pricing page feedback');
      fd.append('_captcha','false');
      fd.append('message',collect());
      fetch('https://formsubmit.co/ajax/bazil@brandmethod.co',{method:'POST',body:fd,headers:{Accept:'application/json'}})
        .then(function(r){ if(!r.ok) throw new Error('failed'); return r.json(); })
        .then(function(){ done(); })
        .catch(function(){ em.disabled=false; em.textContent=orig; alert('Sorry, your feedback could not be sent right now. Please try again in a moment.'); });
    });
  }
  if(document.readyState!=='loading')init(); else document.addEventListener('DOMContentLoaded',init);
})();
</script>

