          <span class="cs-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"></rect><path d="M3 9h18"></path><circle cx="6" cy="6.5" r=".6" fill="currentColor" stroke="none"></circle><circle cx="8.2" cy="6.5" r=".6" fill="currentColor" stroke="none"></circle><path d="M10 14.5l2.4-2.4 2 2 2.6-3"></path></svg></span>
          <span class="cs-nm">Product</span>
        </button>
        <button class="cs-node" data-key="ai" style="--c:#7a4ee8">
          <span class="cs-ic"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 3.5l1.5 4.4 4.4 1.6-4.4 1.6L12 15.6l-1.5-4.5L6.1 9.5l4.4-1.6z"></path><path d="M18 14l.8 2.3 2.2.8-2.2.8L18 20l-.8-2.3-2.2-.8 2.2-.8z"></path></svg></span>
          <span class="cs-nm">AI</span>
        </button>
        <button class="cs-node" data-key="growth" style="--c:#c8890d">
          <span class="cs-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l5-5 3.2 3.2L20 7"></path><path d="M15 7h5v5"></path></svg></span>
          <span class="cs-nm">Growth</span>
        </button>
      </div></div></div>`;
function build(){
  var inner=document.querySelector(".whyc-sec .section-inner");
  if(!inner||inner.querySelector(".wcs"))return;
  if(!document.getElementById("cs2-css")){var st=document.createElement("style");st.id="cs2-css";st.textContent=CSS;document.head.appendChild(st);}
  var stats=inner.querySelector(".whyc-stats"),grid=inner.querySelector(".whyc-grid");
  var statHTML='<div class="wcs-stats"><div><b>24 hrs</b><span>Work starts</span></div><div><b>7 days</b><span>Fastest delivery</span></div><div><b>15+</b><span>Years experience</span></div><div><b>100%</b><span>Money-back</span></div></div>';
  var proof=[["National-level portfolio","Tourism Malaysia &middot; Sunway Lagoon &middot; Transformer World by Hasbro","Brands Malaysians recognise on sight."],["Validated by the ecosystem","Based at MRANTI Technology Park, Bukit Jalil","Malaysia&rsquo;s leading innovation hub, not a home office."],["Cross-industry proof","Active clients: Eskayvie &middot; Ultima Markets &middot; Avisena Hospital","Fintech, wellness, healthcare. One framework, many industries."],["A guarantee with teeth","Miss the deadline? Full refund. No argument.","Not standard agency practice. We hold ourselves to it."]];
  var pf=proof.map(function(p){return '<div class="wcs-pf"><span class="k">'+p[0]+'</span><h4>'+p[1]+'</h4><p>'+p[2]+'</p></div>';}).join("");
  var CAP="The only studio connecting brand, product, AI and growth into one system. Not a logo shop, not a web agency. A system builder.";
  var wrap=document.createElement("div");wrap.className="wcs rv";
  wrap.innerHTML='<div class="wcs-diagram" style="max-width:860px">'+SCENE+'<p class="wcs-cap">'+CAP+'</p></div>'+statHTML+'<div class="wcs-proof">'+pf+'</div>';
  (stats||grid||inner).parentNode.insertBefore(wrap,stats||grid||null);
  if(stats)stats.style.display="none";if(grid)grid.style.display="none";
  if("IntersectionObserver" in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){wrap.classList.add("in");io.disconnect();}})},{threshold:.18});io.observe(wrap);}else wrap.classList.add("in");
  startEngine(wrap);
}
function startEngine(root){

  var stage=root.querySelector(".cs-stage"),core=root.querySelector(".cs-core"),svg=root.querySelector(".cs-links");
  var pName=core.querySelector(".cs-pname"),pDesc=core.querySelector(".cs-pdesc");
  var reduce=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;
  var CX=380,CY=260,FOCAL=820;
  var nodes=[
    {key:"brand",x:-160,y:-112,fs:0.50,ph:0.2,pr:["Brand","Positioning and identity people choose on sight."]},
    {key:"product",x:160,y:-112,fs:0.55,ph:1.7,pr:["Product","Websites, apps and stores built to sell."]},
    {key:"ai",x:-160,y:112,fs:0.47,ph:3.0,pr:["AI","Automations and agents that do the work for you."]},
    {key:"growth",x:160,y:112,fs:0.53,ph:4.3,pr:["Growth","Campaigns and content engineered to convert."]}
  ];
  nodes.forEach(function(n){n.el=stage.querySelector('.cs-node[data-key="'+n.key+'"]');n.line=svg.querySelector(".l-"+n.key);n.pulse=svg.querySelector(".p-"+n.key);n.grad=svg.querySelector("#g-"+n.key);});
  var focused=null;
  function setFocus(n){focused=n;nodes.forEach(function(x){x.el.classList.toggle("focus",x===n);});if(n){pName.textContent=n.pr[0];pDesc.textContent=n.pr[1];core.classList.add("show");}else core.classList.remove("show");}
  nodes.forEach(function(n){n.el.addEventListener("mouseenter",function(){setFocus(n);});n.el.addEventListener("focus",function(){setFocus(n);});n.el.addEventListener("mouseleave",function(){setFocus(null);});n.el.addEventListener("blur",function(){setFocus(null);});});
  var px=0,py=0,lastMove=-9999,yaw=0,pitch=0;
  var scene=stage.closest(".cs-scene");
  scene.addEventListener("pointermove",function(e){var r=scene.getBoundingClientRect();px=((e.clientX-r.left)/r.width-0.5)*2;py=((e.clientY-r.top)/r.height-0.5)*2;lastMove=performance.now();});
  function project(x,y,z){
    var c1=Math.cos(yaw),s1=Math.sin(yaw);var x1=x*c1+z*s1,z1=-x*s1+z*c1;
    var c2=Math.cos(pitch),s2=Math.sin(pitch);var y2=y*c2-z1*s2,z2=y*s2+z1*c2;
    var f=FOCAL/(FOCAL-z2);return{sx:CX+x1*f,sy:CY+y2*f,z:z2,f:f};
  }
  function render(t){
    nodes.forEach(function(n){
      var zf=reduce?0:Math.sin(t*n.fs+n.ph)*42, yb=reduce?0:Math.cos(t*n.fs*0.9+n.ph)*7;
      var p=project(n.x,n.y+yb,zf);
      var s=(n===focused?1.14:(focused?0.9:1))*p.f;
      n.el.style.left=p.sx.toFixed(1)+"px";n.el.style.top=p.sy.toFixed(1)+"px";
      n.el.style.transform="translate(-50%,-50%) scale("+s.toFixed(3)+")";
      n.el.style.zIndex=Math.round(100+p.z);
      n.el.style.opacity=(p.z<0?(0.6+0.4*(1+p.z/200)):1).toFixed(2);
      n.line.setAttribute("x1",CX);n.line.setAttribute("y1",CY);
      n.line.setAttribute("x2",p.sx.toFixed(1));n.line.setAttribute("y2",p.sy.toFixed(1));
      n.grad.setAttribute("x2",p.sx.toFixed(1));n.grad.setAttribute("y2",p.sy.toFixed(1));
      n.line.style.opacity=focused?(n===focused?0.95:0.14):0.6;
      n.line.style.strokeWidth=n===focused?2.8:2;
      var spd=n===focused?0.8:0.4,u=((t*spd)+n.ph*0.13)%1;
      n.pulse.setAttribute("cx",(CX+(p.sx-CX)*u).toFixed(1));n.pulse.setAttribute("cy",(CY+(p.sy-CY)*u).toFixed(1));
      n.pulse.setAttribute("opacity",((n===focused?0.95:0.6)*Math.sin(u*Math.PI)).toFixed(2));
    });
  }
  var t0=performance.now();
  function loop(now){
    var t=(now-t0)/1000,idle=(now-lastMove>1500);
    var ty=idle?Math.sin(t*0.17)*0.24:px*0.34, tp=idle?Math.sin(t*0.12+1)*0.12:-py*0.20;
    yaw+=(ty-yaw)*0.045;pitch+=(tp-pitch)*0.045;
    render(t);requestAnimationFrame(loop);
  }
  render(0);requestAnimationFrame(loop);
}
if(document.readyState!=="loading")build();else document.addEventListener("DOMContentLoaded",build);
})();</script>
