<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BrandMethod · Services &amp; Pricing</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* Kill mobile expand button globally */
.mobile-expand-btn { display: none !important; }

:root{
  --bg:#F7F8FC;--bg2:#fff;--bg3:#F1F4FB;--bg4:#E8EDF8;
  --blue:#2563EB;--bl:#EFF4FF;--bm:#DBEAFE;--bb:#93C5FD;
  --teal:#0D9488;--tl:#F0FDFA;--tb:#5EEAD4;
  --green:#059669;--gl:#ECFDF5;--gb:#6EE7B7;
  --amber:#D97706;--al:#FFFBEB;--ab:#FDE68A;
  --red:#DC2626;--rl:#FEF2F2;--rb:#FCA5A5;
  --purple:#7C3AED;--pl:#F5F3FF;--pb:#C4B5FD;
  --navy:#0F172A;--t1:#1E293B;--t2:#334155;--t3:#475569;--t4:#94A3B8;
  --br:#E2E8F0;--br2:#BFDBFE;
  --sh:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05);
  --sh2:0 4px 16px rgba(0,0,0,.09),0 2px 4px rgba(0,0,0,.06);
  --sh3:0 8px 24px rgba(0,0,0,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
.bm-conf-bar{background:#030E1C;border-bottom:1.5px solid rgba(59,130,246,.3);display:flex;align-items:center;justify-content:center;gap:10px;padding:7px 20px;position:relative;z-index:1002;}
.bm-conf-bar span:first-child{font-size:14px}
.bm-conf-bar span:nth-child(2){font-size:10.5px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#60A5FA;}
.bm-conf-bar button{position:absolute;right:14px;background:none;border:none;cursor:pointer;color:rgba(96,165,250,.45);font-size:15px;line-height:1;padding:4px;}
.bm-conf-bar button:hover{color:#60A5FA;}
.ph-chart-visual{position:absolute;right:4%;top:50%;transform:translateY(-50%);width:min(36%,340px);opacity:.65;pointer-events:none;}
.ph-chart-visual svg{width:100%;height:auto;display:block;}
@media(max-width:880px){.ph-chart-visual{display:none;}}

body{background:var(--bg);color:var(--t1);font-family:'Inter',sans-serif;font-size:14px;line-height:1.7;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-thumb{background:var(--t4);border-radius:0}

/* ═══════════════════════════════════════════════════════
   GLOBAL BANNER ANIMATIONS (shared across all pages)
═══════════════════════════════════════════════════════ */
@keyframes bmGradientShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes bmOrbFloat {
  0%,100% { transform: translate(0,0) scale(1); }
  33%     { transform: translate(-18px,-24px) scale(1.06); }
  66%     { transform: translate(14px,10px) scale(.95); }
}
@keyframes bmOrbFloat2 {
  0%,100% { transform: translate(0,0) scale(1); }
  33%     { transform: translate(20px,-14px) scale(1.04); }
  66%     { transform: translate(-10px,18px) scale(.97); }
}
@keyframes bmGridDrift {
  0%   { background-position: 0 0; }
  100% { background-position: 40px 40px; }
}
@keyframes bmParticleRise {
  0%   { transform: translateY(0) translateX(0) scale(1); opacity:0; }
  10%  { opacity:.6; }
  90%  { opacity:.2; }
  100% { transform: translateY(-80px) translateX(var(--px,12px)) scale(0); opacity:0; }
}
@keyframes bmTextReveal {
  from { opacity:0; transform: translateY(12px); }
  to   { opacity:1; transform: translateY(0); }
}
@keyframes bmCounterUp {
  from { opacity:0; transform: translateY(8px) scale(.9); }
  to   { opacity:1; transform: translateY(0) scale(1); }
}
@keyframes bmPulseRing {
  0%   { transform: scale(1); opacity:.6; }
  100% { transform: scale(2.2); opacity:0; }
}
@keyframes bmLineScan {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(300%); }
}
@keyframes bmBlink {
  0%,100% { opacity:1; } 50% { opacity:.3; }
}
@keyframes bmDotPulse {
  0%,100% { transform: scale(1); opacity:.7; }
  50%     { transform: scale(1.4); opacity:1; }
}


/* NAV */
nav{position:sticky;top:0;z-index:999;background:rgba(247,248,252,0.97);backdrop-filter:blur(16px);border-bottom:1px solid var(--br);height:54px;display:flex;align-items:center;padding:0 1.5rem;gap:1rem;box-shadow:var(--sh)}
.logo{display:flex;align-items:center;gap:7px;flex-shrink:0}.bm-nav-wm{font-family:'JetBrains Mono','Fraunces',sans-serif;font-weight:600;font-size:19px;letter-spacing:-.012em;text-transform:uppercase;color:#0000F8;line-height:1;white-space:nowrap}
.logo .b{color:var(--blue)}.logo .x{color:var(--t3);margin:0 3px}.logo .m{color:var(--teal)}
.tabs{display:flex;gap:3px;overflow-x:auto;flex:1}.tabs::-webkit-scrollbar{display:none}
.tab{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--t2);padding:5px 13px;border-radius:0;cursor:pointer;white-space:nowrap;border:1px solid transparent;background:none;font-family:'Inter',sans-serif;transition:all .15s}
.tab:hover{color:var(--t1);background:var(--bg3);border-color:var(--br)}
.tab.on{color:var(--blue);background:var(--bl);border-color:var(--bb);font-weight:600}
.chip{font-size:10px;font-weight:600;padding:2px 6px;border-radius:0;letter-spacing:.04em}
.cbm{background:var(--bm);color:var(--blue)}.cmt{background:var(--tl);color:var(--teal)}.cint{background:var(--al);color:var(--amber)}

/* PAGES */
.pg{display:none}.pg.on{display:block;animation:fi .25s ease}
@keyframes fi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.wrap{max-width:1280px;margin:0 auto;padding:2rem 2rem}

/* ════ PAGE HEADER BANNER — animated dark banners for all inner pages ════ */
.ph {
  margin: 0;
  padding: 3.5rem 2rem 2.8rem;
  border-radius:0;
  position: relative; overflow: hidden;
  /* default: navy gradient — overridden per page */
  background: linear-gradient(-45deg,#060F1E,#0A1628,#0D1F3C,#060F1E);
  background-size: 400% 400%;
  animation: phGradLoop 15s ease infinite;
}
@keyframes phGradLoop {
  0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%}
}
/* dot mesh */
.ph::before {
  content:'';
  position:absolute; inset:0; pointer-events:none;
  background-image: radial-gradient(circle, rgba(255,255,255,.07) 1px, transparent 1px);
  background-size: 30px 30px;
  animation: phDotDrift 18s linear infinite;
}
@keyframes phDotDrift { 0%{background-position:0 0} 100%{background-position:60px 60px} }
/* left glow orb */
.ph::after {
  content:'';
  position:absolute; width:480px; height:480px; border-radius:0;
  background: radial-gradient(circle, var(--ph-orb1, rgba(37,99,235,.5)) 0%, transparent 60%);
  top:-150px; left:-100px; pointer-events:none;
  animation: phOrb 8s ease-in-out infinite alternate;
}
@keyframes phOrb { 0%{transform:scale(.88);opacity:.65} 50%{transform:scale(1.22) translate(22px,-18px);opacity:1} 100%{transform:scale(.95) translate(-8px,14px);opacity:.8} }
/* right glow orb (set per page) */
.ph-orb2 {
  position:absolute; width:420px; height:420px; border-radius:0;
  background: radial-gradient(circle, var(--ph-orb2, rgba(99,102,241,.35)) 0%, transparent 60%);
  top:-100px; right:-80px; pointer-events:none;
  animation: phOrb 10s ease-in-out infinite alternate-reverse;
}
/* scan beam */
.ph-scan {
  position:absolute; inset:0; pointer-events:none; overflow:hidden;
}
.ph-scan::after {
  content:''; position:absolute; top:0; left:-50%;
  width:30%; height:100%;
  background: linear-gradient(90deg,transparent,rgba(255,255,255,.035),transparent);
  animation: phScan 8s ease-in-out infinite;
}
@keyframes phScan { 0%{left:-30%} 100%{left:130%} }
.ph-inner { position:relative; z-index:1; }
.ph-eye {
  display:inline-flex; align-items:center; gap:7px;
  font-size:10px; font-weight:600; letter-spacing:.18em; text-transform:uppercase;
  color:rgba(165,180,252,.85);
  background:rgba(99,102,241,.14); border:1px solid rgba(99,102,241,.28);
  padding:5px 14px; border-radius:0; margin-bottom:1.2rem;
}
.ph-eye::before {
  content:''; width:5px; height:5px; border-radius:0;
  background:#818CF8; flex-shrink:0;
  animation:bmBlink 2.2s ease infinite;
}
.ph-h {
  font-size:clamp(26px,3.8vw,46px); font-weight:700; letter-spacing:-.04em;
  line-height:1.05; margin-bottom:.9rem;
  color:#fff;
}
.ph-h em { font-style:normal; -webkit-text-fill-color:transparent;
  background:var(--ph-em, linear-gradient(135deg,#60A5FA,#818CF8));
  -webkit-background-clip:text; background-clip:text;
  background-size:200%; animation:phEmShift 6s ease-in-out infinite alternate;
}
@keyframes phEmShift { 0%{background-position:0%} 100%{background-position:100%} }
/* ════ BANNER MOUSE PARALLAX + CURSOR GLOW (all pages) ════ */
.bj2-hero, .ph, .p1-hero, .svc-hero, .sop-hero {
  cursor: default;
}
/* Cursor glow that follows mouse */
.bm-cursor-glow {
  position: absolute;
  width: 380px; height: 380px;
  border-radius:0;
  background: radial-gradient(circle,
    rgba(99,102,241,.18) 0%,
    rgba(99,102,241,.06) 35%,
    transparent 70%);
  pointer-events: none;
  z-index: 5;
  transform: translate(-50%, -50%);
  /* smooth lerp via CSS — no jarring jump */
  transition: left .12s ease-out, top .12s ease-out, opacity .35s ease;
  opacity: 0;
}
/* per-page colour tints */
.bj2-hero .bm-cursor-glow   { background: radial-gradient(circle, rgba(99,102,241,.22) 0%, rgba(99,102,241,.06) 38%, transparent 70%); }
.p1-hero .bm-cursor-glow    { background: radial-gradient(circle, rgba(37,99,235,.22) 0%, rgba(37,99,235,.06) 38%, transparent 70%); }
.svc-hero .bm-cursor-glow   { background: radial-gradient(circle, rgba(124,58,237,.20) 0%, rgba(124,58,237,.05) 38%, transparent 70%); }
.sop-hero .bm-cursor-glow   { background: radial-gradient(circle, rgba(99,102,241,.20) 0%, rgba(99,102,241,.05) 38%, transparent 70%); }
#p3 .ph .bm-cursor-glow     { background: radial-gradient(circle, rgba(16,185,129,.22) 0%, rgba(16,185,129,.05) 38%, transparent 70%); }
#p4 .ph .bm-cursor-glow     { background: radial-gradient(circle, rgba(245,158,11,.20) 0%, rgba(245,158,11,.05) 38%, transparent 70%); }
#p5 .ph .bm-cursor-glow     { background: radial-gradient(circle, rgba(139,92,246,.22) 0%, rgba(139,92,246,.05) 38%, transparent 70%); }

/* ── FULL-BLEED BANNER — true viewport width ── */
body, .pg { overflow-x: clip; overflow-y: visible; }
.ph, .p1-hero {
  width: 100vw;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
  margin-left: 0 !important;
  margin-right: 0 !important;
  border-radius:0!important;
}
@media(max-width:768px) {
  .ph, .p1-hero {
    width: 100vw;
  }
}

.ph-h em.t { background:linear-gradient(135deg,#34D399,#14B8A6); -webkit-background-clip:text; background-clip:text; }
.ph-h em.a { background:linear-gradient(135deg,#FBBF24,#F59E0B); -webkit-background-clip:text; background-clip:text; }
.ph-sub { font-size:14px; color:rgba(148,163,184,.8); max-width:640px; line-height:1.75; }
.ph-tag {
  display:inline-flex; align-items:center; gap:6px; font-size:10px; font-weight:600;
  padding:5px 14px; border-radius:0; margin-top:1.2rem;
}
.ph-tag.int { background:rgba(251,191,36,.12); color:rgba(251,191,36,.9); border:1px solid rgba(251,191,36,.25); }
.ph-tag.pub { background:rgba(52,211,153,.12); color:rgba(52,211,153,.9); border:1px solid rgba(52,211,153,.25); }
.ph-tag.info { background:rgba(96,165,250,.12); color:rgba(96,165,250,.9); border:1px solid rgba(96,165,250,.25); }
/* per-page stat row */
.ph-stats { display:flex; gap:2.2rem; margin-top:1.8rem; flex-wrap:wrap; }
.ph-stat { display:flex; flex-direction:column; gap:3px; }
.ph-stat-num { font-size:22px; font-weight:700; color:#fff; font-family:'Fraunces',sans-serif; letter-spacing:-.04em; line-height:1; }
.ph-stat-label { font-size:10px; font-weight:600; color:rgba(148,163,184,.5); text-transform:uppercase; letter-spacing:.12em; }

/* ─ P3: Growth Roadmap — emerald/teal, forward motion ─ */
#p3 .ph { --ph-orb1: rgba(16,185,129,.3); --ph-orb2: rgba(20,184,166,.2);
  background: linear-gradient(-45deg, #0A1F1A, #0D2420, #0F1F2E, #081A16, #0D2420);
  background-size:400% 400%;
}
#p3 .ph::after { background:radial-gradient(circle,rgba(16,185,129,.55) 0%,transparent 58%); }
#p3 .ph-eye { color:rgba(110,231,183,.9); background:rgba(16,185,129,.12); border-color:rgba(16,185,129,.28); }
#p3 .ph-eye::before { background:#34D399; }
#p3 .ph-h em { background:linear-gradient(135deg,#34D399,#059669); -webkit-background-clip:text; background-clip:text; }

/* ─ P4: Finance & Numbers — amber/gold, precision ─ */
#p4 .ph { --ph-orb1: rgba(245,158,11,.25); --ph-orb2: rgba(251,191,36,.15);
  background: linear-gradient(-45deg, #1A1200, #231800, #0F0E00, #1A1200, #231800);
  background-size:400% 400%;
}
#p4 .ph::after { background:radial-gradient(circle,rgba(245,158,11,.5) 0%,transparent 58%); }
#p4 .ph-eye { color:rgba(251,191,36,.9); background:rgba(245,158,11,.12); border-color:rgba(245,158,11,.28); }
#p4 .ph-eye::before { background:#FBBF24; }
#p4 .ph-h em { background:linear-gradient(135deg,#FBBF24,#F59E0B); -webkit-background-clip:text; background-clip:text; }

/* ─ P5: Team & Hiring — violet/people energy ─ */
#p5 .ph { --ph-orb1: rgba(139,92,246,.3); --ph-orb2: rgba(167,139,250,.15);
  background: linear-gradient(-45deg, #100A1F, #160E2A, #0F0A1E, #1A0F2E, #100A1F);
  background-size:400% 400%;
}
#p5 .ph::after { background:radial-gradient(circle,rgba(139,92,246,.55) 0%,transparent 58%); }
#p5 .ph-eye { color:rgba(196,181,253,.9); background:rgba(139,92,246,.12); border-color:rgba(139,92,246,.28); }
#p5 .ph-eye::before { background:#A78BFA; }
#p5 .ph-h em { background:linear-gradient(135deg,#C084FC,#A78BFA); -webkit-background-clip:text; background-clip:text; }

/* mobile */
@media(max-width:768px) {
  .ph { margin:-1rem -1rem 2rem; padding:2.5rem 1rem 2rem; border-radius:0; }
}

/* SECTION LABELS */
.sl{display:flex;align-items:center;gap:12px;margin:2.5rem 0 1.2rem}
.sl-ic{width:36px;height:36px;border-radius:0;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px}
.sl-ic.b{background:var(--bl);border:1px solid var(--bb)}
.sl-ic.t{background:var(--tl);border:1px solid var(--tb)}
.sl-ic.g{background:var(--gl);border:1px solid var(--gb)}
.sl-ic.a{background:var(--al);border:1px solid var(--ab)}
.sl-ic.p{background:var(--pl);border:1px solid var(--pb)}
.sl-name{font-size:15px;font-weight:600;color:var(--navy)}
.sl-desc{font-size:12px;color:var(--t3);margin-top:1px}
.sl-line{flex:1;height:1px;background:var(--br)}

/* ── SERVICE COMPARISON SIDE BY SIDE ── */
.svc-block{background:var(--bg3);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh);margin-bottom:2rem}
.svc-header{display:flex;align-items:center;gap:14px;padding:1.25rem 1.5rem;background:linear-gradient(135deg,var(--bg3),var(--bg4));border-bottom:1px solid var(--br)}
.svc-icon{width:48px;height:48px;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.svc-title{font-size:17px;font-weight:700;color:var(--navy)}
.svc-desc{font-size:12px;color:var(--t2);margin-top:2px}
.svc-panels{display:grid;grid-template-columns:repeat(3,1fr);gap:0;padding:0;background:var(--br)}
.svc-panel{display:flex;flex-direction:column;padding:1.5rem 1.5rem 1.6rem;background:var(--bg2);border-top:4px solid transparent;position:relative}
.svc-panel + .svc-panel{box-shadow:-1px 0 0 var(--br)}
.svc-panel.slam{background:linear-gradient(180deg,#FAFFFE 0%,#F0FDF4 60%,#FAFFFE 100%);border-top-color:var(--green)}
.svc-panel.growth{background:linear-gradient(180deg,#FAFBFF 0%,#EFF4FF 60%,#FAFBFF 100%);border-top-color:var(--blue)}
.svc-panel.premium{background:linear-gradient(180deg,var(--bg2) 0%,var(--bg3) 60%,var(--bg2) 100%);border-top-color:var(--t4)}
.tb-slam{background:var(--gl);color:var(--green)}
.tb-growth{background:var(--bl);color:var(--blue)}
.tb-premium{background:var(--bg4);color:var(--t2)}
.panel-grid{display:flex;flex-direction:column;gap:0}
.panel-title{font-size:17px;font-weight:700;color:var(--navy);margin-bottom:4px;line-height:1.25}
.panel-tag{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:600;padding:3px 10px;border-radius:0;margin-bottom:10px;width:fit-content}
.panel-price{font-size:26px;font-weight:700;color:var(--navy);margin-bottom:2px;line-height:1;letter-spacing:-.02em}
.panel-price-soft{font-size:15px;font-weight:600;color:var(--t2);line-height:1.2}
.panel-note{font-size:11.5px;color:var(--t3);margin-bottom:14px;line-height:1.5}
.panel-btn{display:block;width:100%;text-align:center;font-size:13px;font-weight:600;padding:11px 14px;border-radius:0;cursor:pointer;border:none;font-family:'Inter',sans-serif;letter-spacing:.02em;margin-bottom:10px;transition:all .15s}
.panel-btn:hover{transform:translateY(-1px);box-shadow:var(--sh2)}
.panel-btn.g{background:var(--green);color:#fff}.panel-btn.b{background:var(--blue);color:#fff}.panel-btn.n{background:var(--bg3);color:var(--t2);border:1px solid var(--br)}
.panel-delivery{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;color:var(--t2);background:var(--bg3);border:1px solid var(--br);padding:4px 10px;border-radius:0;margin-bottom:12px;width:fit-content}
.panel-payment{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:#7C2D12;background:linear-gradient(135deg,#FFEDD5,#FED7AA);border:1px solid #FB923C;padding:4px 10px;border-radius:0;margin-bottom:12px;width:fit-content;letter-spacing:.01em}
.panel-quality{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:600;color:#065F46;background:linear-gradient(135deg,#D1FAE5,#A7F3D0);border:1px solid var(--green);padding:3px 9px;border-radius:0;margin-bottom:10px;width:fit-content;text-transform:uppercase;letter-spacing:.05em}
.panel-quality::before{content:"✦";font-size:11px;font-weight:700}
.panel-payment{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;color:var(--t1);background:#FAFAFA;border:1px solid var(--br);padding:4px 9px;border-radius:0;margin:0 0 8px;width:fit-content;letter-spacing:.02em}
.panel-payment::before{content:"💳";font-size:11px}
.panel-payment.full{background:#ECFDF5;border-color:#A7F3D0;color:#065F46}
.panel-payment.half{background:#EFF6FF;border-color:#BFDBFE;color:#1E40AF}
.panel-payment.milestone{background:#FAF5FF;border-color:#DDD6FE;color:#5B21B6}
.pmeta-payment { display: none !important; }
.panel-payment.monthly{background:#FFFBEB;border-color:#FDE68A;color:#92400E}
.panel-quality{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;color:var(--green);margin:0 0 8px;letter-spacing:.02em}
.panel-quality::before{content:"✦";font-size:13px;color:var(--green);font-weight:700}
.panel-includes{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);margin-bottom:8px}
.pci{display:flex;align-items:flex-start;gap:8px;font-size:13px;color:var(--t1);margin-bottom:7px;line-height:1.45}
.pck{color:var(--green);font-size:14px;flex-shrink:0;margin-top:1px}
.pci strong{font-weight:600}
.panel-upsell{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--blue);padding:8px 12px;background:var(--bl);border-radius:0;margin-top:12px}
.panel-guarantee{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--green);margin-top:8px}

/* DIVIDERS */
.divl{border:none;border-top:1px solid var(--br);margin:2.5rem 0}

/* GUARANTEE BOX */
.gbox{border:1px solid var(--gb);border-radius:0;padding:1.3rem 1.5rem;background:var(--gl);margin-bottom:1.8rem;display:flex;gap:14px;align-items:flex-start}
.gbox-ic{font-size:32px;flex-shrink:0}
.gt{font-size:14px;font-weight:600;color:var(--green);margin-bottom:5px}
.gd{font-size:13px;color:#065F46;line-height:1.7}
.dbox{border:1px solid var(--br);border-radius:0;padding:1.2rem 1.4rem;background:var(--bg2);margin-top:1.5rem;box-shadow:var(--sh)}
.dtitle{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin-bottom:12px}
.di{display:flex;align-items:flex-start;gap:7px;font-size:12px;color:var(--t2);margin-bottom:6px;line-height:1.55}
.dk{flex-shrink:0;margin-top:2px}
.di.yes .dk{color:var(--green)}.di.no .dk{color:var(--red)}.di.info .dk{color:var(--blue)}

/* LEAD GEN CARDS */
.lg-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:2rem}
.lg-card{background:var(--bg2);border:1px solid var(--gb);border-radius:0;overflow:hidden;box-shadow:var(--sh);transition:all .2s}

.lg-top{height:80px;display:flex;align-items:center;justify-content:center;font-size:36px;background:linear-gradient(135deg,var(--gl),#D1FAE5)}
.lg-body{padding:1rem}
.lg-name{font-size:13px;font-weight:600;color:var(--navy);margin-bottom:4px}
.lg-desc{font-size:12px;color:var(--t2);margin-bottom:10px;line-height:1.5}
.lg-includes{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);margin-bottom:6px}
.lg-item{display:flex;align-items:flex-start;gap:6px;font-size:12px;color:var(--t2);margin-bottom:4px}
.lg-item span{color:var(--green);flex-shrink:0}
.lg-btn{display:block;width:100%;text-align:center;font-size:12px;font-weight:600;padding:8px;border-radius:0;background:var(--green);color:#fff;margin-top:10px;cursor:pointer;border:none;font-family:'Inter',sans-serif}

/* TABLE */
.tbl{overflow-x:auto;border-radius:0;border:1px solid var(--br);margin-bottom:2rem;box-shadow:var(--sh)}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:700px}
thead th{text-align:left;font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);padding:10px 14px;background:var(--bg3);border-bottom:1px solid var(--br)}
tbody td{padding:10px 14px;border-bottom:1px solid var(--br);color:var(--t2);vertical-align:top;line-height:1.5;background:var(--bg2)}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:var(--bl)}
.tdp{color:var(--green);font-weight:600}.tdw{color:var(--amber);font-weight:600}
.tdd{color:var(--t3);font-size:11px}
.tdi{color:var(--amber);font-size:10px;background:var(--al);border:1px solid var(--ab);border-radius:0;padding:2px 7px;display:inline-flex;align-items:center;gap:3px}

/* RULES */
.rule{border-left:3px solid var(--blue);padding:.85rem 1.1rem;margin-bottom:.85rem;background:var(--bl);border-radius:0;box-shadow:var(--sh)}
.rule.a{border-left-color:var(--amber);background:var(--al)}
.rt{font-size:13px;font-weight:600;color:var(--navy);margin-bottom:4px}
.rd{font-size:12px;color:var(--t2);line-height:1.65}

/* FLOW NODES */
.flow-scroll{overflow-x:auto;padding:1rem 0 .5rem}
.flow-row{display:flex;align-items:center;min-width:860px}
.fnode{display:flex;flex-direction:column;align-items:center;flex:1}
.fnode-box{background:var(--bg2);border:1px solid var(--br);border-radius:0;width:128px;box-shadow:var(--sh2);overflow:hidden;transition:all .2s}

.fnode-box.blue{border-color:var(--bb)}.fnode-box.green{border-color:var(--gb)}
.fnode-box.amber{border-color:var(--ab)}.fnode-box.purple{border-color:var(--pb)}.fnode-box.teal{border-color:var(--tb)}
.fnode-top{width:100%;height:70px;display:flex;align-items:center;justify-content:center;font-size:32px}
.fnode-top.blue{background:linear-gradient(135deg,#EFF4FF,#DBEAFE)}
.fnode-top.green{background:linear-gradient(135deg,#ECFDF5,#D1FAE5)}
.fnode-top.amber{background:linear-gradient(135deg,#FFFBEB,#FEF3C7)}
.fnode-top.purple{background:linear-gradient(135deg,#F5F3FF,#EDE9FE)}
.fnode-top.teal{background:linear-gradient(135deg,#F0FDFA,#CCFBF1)}
.fnode-inner{padding:.65rem .6rem;text-align:center}
.fnode-num{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);margin-bottom:3px}
.fnode-title{font-size:11px;font-weight:600;color:var(--navy);line-height:1.3;margin-bottom:3px}
.fnode-desc{font-size:10px;color:var(--t2);line-height:1.45}
.fnode-note{font-size:10px;font-weight:600;margin-top:4px;text-align:center}
.fconn{display:flex;align-items:center;justify-content:center;width:32px;flex-shrink:0;padding-top:40px;color:var(--bb);font-size:20px;font-weight:600}

/* PYRAMID */
.pyramid{display:flex;flex-direction:column;align-items:center;gap:4px;margin:1.5rem 0 2rem}
.py{display:flex;align-items:center;justify-content:space-between;border-radius:0;border:1px solid;padding:12px 20px;transition:all .2s;cursor:default}

.py1{background:var(--gl);border-color:var(--gb);width:100%}
.py2{background:var(--al);border-color:var(--ab);width:90%}
.py3{background:var(--bl);border-color:var(--bb);width:80%}
.py4{background:var(--pl);border-color:var(--pb);width:70%}
.py5{background:var(--tl);border-color:var(--tb);width:60%}
.py6{background:var(--al);border-color:var(--ab);width:50%}
.py-l{display:flex;align-items:center;gap:12px}
.py-em{font-size:24px;flex-shrink:0}
.py-name{font-size:13px;font-weight:600;color:var(--navy)}
.py-desc{font-size:12px;color:var(--t2);margin-top:1px;line-height:1.4}
.py-price{font-size:14px;font-weight:700;white-space:nowrap}
.py-arr{color:var(--t3);font-size:18px;text-align:center;margin:0 auto;line-height:1}

/* LADDER */
.lrow{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding:10px 14px;border-radius:0;border:1px solid var(--br);background:var(--bg2);margin-bottom:7px;box-shadow:var(--sh)}
.lstep{font-size:12px;font-weight:600;background:var(--bl);border:1px solid var(--bb);border-radius:0;padding:4px 10px;white-space:nowrap;color:var(--blue)}
.larr{color:var(--t4);font-size:14px}
.llab{font-size:11px;font-weight:600;color:var(--t3);background:var(--bg3);border-radius:0;padding:2px 8px;white-space:nowrap}

/* PRODUCT LIST */
.plist{display:flex;flex-direction:column;gap:7px;margin-bottom:2rem}
.pitem{display:flex;align-items:center;gap:14px;padding:12px 16px;border-radius:0;border:1px solid var(--br);background:var(--bg2);box-shadow:var(--sh);transition:all .18s}

.pitem-ic{width:40px;height:40px;border-radius:0;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px}
.pitem-name{font-size:13px;font-weight:600;color:var(--navy)}
.pitem-desc{font-size:12px;color:var(--t2);margin-top:1px;line-height:1.4}
.pitem-price{font-size:14px;font-weight:700;white-space:nowrap;text-align:right}
.ptag{font-size:10px;font-weight:600;padding:2px 8px;border-radius:0;white-space:nowrap;margin-left:6px}

/* FRAMEWORK CARDS */
.fwg{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:2rem}
.fw{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:1.1rem;box-shadow:var(--sh);transition:all .18s}

.fw-top{font-size:28px;margin-bottom:8px}
.fw-svc{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);margin-bottom:3px}
.fw-name{font-size:13px;font-weight:600;color:var(--navy);margin-bottom:8px}
.fw-ph{font-size:12px;color:var(--t3);font-style:italic;border:1px dashed var(--br);border-radius:0;padding:.6rem .8rem;margin-bottom:8px;line-height:1.55;background:var(--bg3)}
.fw-mod{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--t2);margin-bottom:5px}
.fw-num{width:20px;height:20px;border-radius:0;background:var(--bl);border:1px solid var(--bb);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;color:var(--blue);flex-shrink:0}

.info-box{background:var(--bl);border:1px solid var(--bb);border-radius:0;padding:1rem 1.2rem;margin-bottom:1.5rem;display:flex;gap:12px;align-items:flex-start}
.info-box p{font-size:13px;color:var(--t1);line-height:1.65}

@media(max-width:768px){
  .ph-h{font-size:20px}.wrap{padding:1.2rem .9rem}
  .ph{margin:-1rem -1rem 1.5rem;padding:2rem 1rem 1.8rem;}
  .panel-grid{grid-template-columns:1fr}
  .flow-row{min-width:700px}
  {width:100%}
  .svc-panels{padding:1rem}
  .panel-price{font-size:22px}
  .svc-header{padding:1rem}
  .svc-title{font-size:15px}
  .drawer{max-width:100%;width:100%}
  .popup-box{max-width:100%;margin:.5rem;border-radius:0}
  .prod-block{grid-template-columns:1fr}
  .fwg{grid-template-columns:1fr}
  .g2,.g3,.g4{grid-template-columns:1fr}
  .lrow{flex-wrap:wrap}
  .panel-btn{font-size:12px;padding:9px 12px}
  .know-btn,.view-full-btn{font-size:11px;padding:5px 10px}
  nav{padding:0 1rem;gap:.5rem}
  .logo{font-size:13px}
  .tab{font-size:11px;padding:4px 9px}
  .chip{display:none}
  .tbl{font-size:11px}
  table{min-width:500px}
  .svc-panel{padding:1rem}
  .drawer-body{padding:1rem}
  .milestone{padding:.7rem .8rem}
  .payment-row{font-size:12px}
}
@media(max-width:480px){
  .ph-h{font-size:18px}
  .ph{margin:-1rem -1rem 1.5rem;padding:2rem 1rem 1.8rem;}
  .pyramid{padding:0 .5rem}
  .py-name{font-size:12px}.py-desc{font-size:11px}
  .flow-row{min-width:620px}
  .fnode-box{width:110px}
  .fnode-top{height:60px;font-size:26px}
}

/* ── TEAM KNOWLEDGE POPUP ── */
.know-btn{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;padding:6px 12px;border-radius:0;cursor:pointer;border:1px solid var(--br);background:var(--bg3);color:var(--t2);font-family:'Inter',sans-serif;transition:all .15s;margin-top:10px}
.know-btn:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.know-btn span{font-size:14px}
.popup-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,0.6);z-index:9999;backdrop-filter:blur(4px);padding:1rem;align-items:center;justify-content:center}
.popup-overlay.show{display:flex}
.popup-box{background:var(--bg2);border-radius:0;width:100%;max-width:640px;max-height:90vh;overflow-y:auto;box-shadow:0 24px 60px rgba(0,0,0,.25);animation:popIn .25s ease}
@keyframes popIn{from{opacity:0;transform:scale(.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}
.popup-head{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid var(--br);position:sticky;top:0;background:var(--bg2);border-radius:0;z-index:1}
.popup-title{font-size:16px;font-weight:700;color:var(--navy)}
.popup-svc{font-size:11px;color:var(--t3);margin-top:2px}
.popup-close{width:32px;height:32px;border-radius:0;background:var(--bg3);border:1px solid var(--br);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;color:var(--t2);flex-shrink:0;font-family:'Inter',sans-serif}
.popup-close:hover{background:var(--red);color:#fff;border-color:var(--red)}
.popup-body{padding:1.25rem 1.5rem}
.popup-tag{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:600;padding:3px 10px;border-radius:0;margin-bottom:1rem;background:var(--al);color:var(--amber);border:1px solid var(--ab)}
.qa-block{margin-bottom:1rem;border:1px solid var(--br);border-radius:0;overflow:hidden}
.qa-q{display:flex;align-items:center;gap:8px;padding:.75rem 1rem;background:var(--bg3);cursor:pointer;font-size:13px;font-weight:600;color:var(--navy);user-select:none}
.qa-q .qa-ico{font-size:16px;flex-shrink:0}
.qa-q .qa-arr{margin-left:auto;color:var(--t3);font-size:12px;transition:transform .2s}
.qa-block.open .qa-arr{transform:rotate(180deg)}
.qa-a{display:none;padding:.85rem 1rem;font-size:13px;color:var(--t2);line-height:1.7;border-top:1px solid var(--br);background:var(--bg2)}
.qa-block.open .qa-a{display:block}
.qa-script{background:var(--gl);border:1px solid var(--gb);border-radius:0;padding:.75rem 1rem;margin-top:.5rem;font-size:12px;color:#065F46;line-height:1.7;font-style:italic}
.qa-script::before{content:'💬 Script: ';font-weight:600;font-style:normal}
.popup-section{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin:1.25rem 0 .75rem;display:flex;align-items:center;gap:8px}
.popup-section::after{content:'';flex:1;height:1px;background:var(--br)}

/* ── PRODUCT CARDS ── */
.prod-block{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-bottom:2rem}
.prod-card{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:1.2rem;display:flex;flex-direction:column;box-shadow:var(--sh);transition:all .2s}

.free-prod{border-color:var(--gb);background:linear-gradient(160deg,#fff,var(--gl))}
.micro-prod{border-color:var(--ab);background:linear-gradient(160deg,#fff,var(--al))}
.course-prod{border-color:var(--bb);background:linear-gradient(160deg,#fff,var(--bl))}
.prod-top{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.prod-icon{width:44px;height:44px;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.prod-name{font-size:14px;font-weight:600;color:var(--navy);line-height:1.3}
.prod-price{font-size:16px;font-weight:700;margin-top:2px}
.prod-badge{display:inline-block;font-size:10px;font-weight:600;padding:3px 10px;border-radius:0;margin-bottom:10px;background:var(--gl);color:var(--green);border:1px solid var(--gb)}
.prod-badge.course{background:var(--bl);color:var(--blue);border-color:var(--bb)}
.prod-desc{font-size:12px;color:var(--t2);line-height:1.6;margin-bottom:10px}
.prod-section{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);margin:10px 0 6px;display:flex;align-items:center;gap:6px}
.prod-item{display:flex;align-items:flex-start;gap:7px;font-size:12px;color:var(--t2);margin-bottom:5px;line-height:1.45}
.prod-item span{flex-shrink:0;font-size:13px}
.fw-download{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--t1);margin-bottom:7px;padding:7px 10px;background:var(--bg3);border-radius:0;border:1px solid var(--br);line-height:1.45}
.fw-download span{flex-shrink:0;font-size:14px}
.fw-download strong{font-weight:600;color:var(--navy)}
.prod-cta{display:block;width:100%;text-align:center;font-size:12px;font-weight:600;padding:9px;border-radius:0;background:var(--green);color:#fff;margin-top:auto;padding-top:12px;cursor:pointer;border:none;font-family:'Inter',sans-serif}
.prod-cta.free{background:var(--green)}
.prod-cta.amber{background:var(--amber)}
.prod-cta.blue{background:var(--blue)}

/* ── SERVICE FULL BREAKDOWN DRAWER ── */
.drawer-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,0.5);z-index:8888;backdrop-filter:blur(3px)}
.drawer-overlay.show{display:block}
.drawer{position:fixed;top:0;right:-100%;width:100%;max-width:520px;height:100vh;background:var(--bg2);z-index:8889;box-shadow:-8px 0 40px rgba(0,0,0,.15);transition:right .3s cubic-bezier(.4,0,.2,1);overflow-y:auto;display:flex;flex-direction:column}
.drawer.show{right:0}
.drawer-head{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid var(--br);position:sticky;top:0;background:var(--bg2);z-index:1}
.drawer-title{font-size:16px;font-weight:700;color:var(--navy)}
.drawer-sub{font-size:11px;color:var(--t3);margin-top:2px}
.drawer-close{width:32px;height:32px;border-radius:0;background:var(--bg3);border:1px solid var(--br);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;color:var(--t2);flex-shrink:0}
.drawer-close:hover{background:var(--red);color:#fff;border-color:var(--red)}
.drawer-body{padding:1.25rem 1.5rem;flex:1}
.drawer-section{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin:1.25rem 0 .75rem;display:flex;align-items:center;gap:8px}
.drawer-section::after{content:'';flex:1;height:1px;background:var(--br)}
.drawer-section:first-child{margin-top:0}
.ds-item{display:flex;align-items:flex-start;gap:8px;font-size:13px;color:var(--t1);margin-bottom:8px;line-height:1.55}
.ds-item .di{flex-shrink:0;font-size:15px;margin-top:1px}
.ds-item strong{font-weight:600;color:var(--navy)}
.milestone{background:var(--bg3);border:1px solid var(--br);border-radius:0;padding:.85rem 1rem;margin-bottom:8px;display:flex;gap:12px;align-items:flex-start}
.milestone-num{width:28px;height:28px;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0;margin-top:1px}
.mn-blue{background:var(--bl);color:var(--blue);border:1px solid var(--bb)}
.mn-green{background:var(--gl);color:var(--green);border:1px solid var(--gb)}
.mn-amber{background:var(--al);color:var(--amber);border:1px solid var(--ab)}
.mn-teal{background:var(--tl);color:var(--teal);border:1px solid var(--tb)}
.milestone-title{font-size:13px;font-weight:600;color:var(--navy);margin-bottom:2px}
.milestone-desc{font-size:12px;color:var(--t2);line-height:1.5}
.milestone-time{font-size:10px;font-weight:600;color:var(--t3);margin-top:3px}
.payment-block{border-radius:0;overflow:hidden;border:1px solid var(--br);margin-bottom:1rem}
.payment-row{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--br)}
.payment-row:last-child{border-bottom:none}
.payment-row.head{background:var(--bg3);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--t3)}
.payment-label{font-size:13px;font-weight:600;color:var(--navy);display:flex;align-items:center;gap:7px}
.payment-pct{font-size:13px;font-weight:600;color:var(--blue)}
.payment-when{font-size:12px;color:var(--t2)}
.payment-online{background:var(--gl);border:1px solid var(--gb);border-radius:0;padding:.85rem 1rem;text-align:center;margin-bottom:1rem}
.payment-online-title{font-size:13px;font-weight:600;color:var(--green);margin-bottom:3px}
.payment-online-desc{font-size:12px;color:#065F46}
.expect-item{display:flex;align-items:flex-start;gap:8px;padding:8px 0;border-bottom:1px solid var(--br);font-size:12px;color:var(--t2);line-height:1.5}
.expect-item:last-child{border-bottom:none}
.expect-item .ei{font-size:16px;flex-shrink:0}
.sop-step{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--br);align-items:flex-start}
.sop-step:last-child{border-bottom:none}
.sop-num{width:22px;height:22px;border-radius:0;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;flex-shrink:0;margin-top:2px}
.sop-title{font-size:12px;font-weight:600;color:var(--navy);margin-bottom:1px}
.sop-desc{font-size:11px;color:var(--t2);line-height:1.5}
.drawer-btn-area{padding:1.25rem 1.5rem;border-top:1px solid var(--br);background:var(--bg2);position:sticky;bottom:0}
.drawer-cta{display:block;width:100%;text-align:center;font-size:13px;font-weight:600;padding:11px;border-radius:0;background:var(--green);color:#fff;cursor:pointer;border:none;font-family:'Inter',sans-serif}
.view-full-btn{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;padding:6px 12px;border-radius:0!important;cursor:pointer;border:1px solid var(--br2);background:var(--bl);color:var(--blue);font-family:'Inter',sans-serif;transition:all .15s;margin-top:8px}
.view-full-btn:hover{background:var(--blue);color:#fff;border-color:var(--blue)}

