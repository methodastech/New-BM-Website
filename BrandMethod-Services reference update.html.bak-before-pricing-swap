.bj2-hero-h1 em { font-style:normal; background:linear-gradient(135deg,#4F46E5,#9333EA); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
.bj2-hero-sub { font-size: 14px; color: var(--t3); line-height: 1.7; max-width: 500px; }
.bj2-hero-outcomes { display:flex; flex-direction:column; gap:7px; margin: 1.2rem 0 1.5rem; }
.bj2-hero-outcome {
  display:flex; align-items:center; gap:8px;
  font-size:12.5px; color:var(--t2); font-weight:500;
}
.bj2-hero-outcome svg { color:#059669; flex-shrink:0; }
.bj2-hero-graphic { display:flex; flex-direction:column; align-items:center; gap:6px; }
.bj2-hero-graphic-note { font-size:10px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--t4); text-align:center; }
.bj2-hero-pip-note { font-size:10px; color:var(--t4); text-align:center; line-height:1.5; margin-top:6px; }
.bj2-hero-stats { display:flex; gap:2.5rem; margin-top:2rem; flex-wrap:wrap; }
.bj2-hero-stat { display:flex; flex-direction:column; gap:3px; }
.bj2-hero-stat-num { font-size:24px; font-weight:700; color:var(--navy); font-family:'Fraunces',sans-serif; letter-spacing:-.04em; line-height:1; }
.bj2-hero-stat-label { font-size:10px; font-weight:600; color:var(--t4); text-transform:uppercase; letter-spacing:.12em; }
.bj2-hero-phases { display:flex; flex-direction:column; gap:10px; }
.bj2-hero-phase-row { display:flex; gap:10px; }
.bj2-hero-pip {
  width:40px; height:40px; border-radius:0;
  display:flex; align-items:center; justify-content:center;
  font-size:13px; font-weight:700; color:var(--t2);
  font-family:'Fraunces',sans-serif; letter-spacing:-.03em;
  background:rgba(15,23,42,.04); border:1px solid rgba(15,23,42,.10);
  transition:transform .2s, background .2s;
  backdrop-filter:blur(4px);
}
.bj2-hero-pip:hover { transform:translateY(-3px) scale(1.05); background:rgba(99,102,241,.12); }

/* ── 6-PHASE JOURNEY (premium stepper) ── */
.bj2-flow { position:relative; margin-top:2.75rem; display:flex; justify-content:space-between; gap:8px; }
.bj2-flow::before { /* gradient track */
  content:""; position:absolute; left:6%; right:6%; top:26px; height:3px; border-radius:0;
  background:linear-gradient(90deg,#3B82F6,#8B5CF6,#EC4899,#14B8A6,#F59E0B,#6366F1);
}
.bj2-flow::after { /* travelling light beam */
  content:""; position:absolute; top:24.5px; height:6px; width:70px; border-radius:0; left:4%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.95),transparent); filter:blur(1px);
  animation:bjBeam 3.4s cubic-bezier(.45,0,.55,1) infinite;
}
@keyframes bjBeam { 0%{left:2%;opacity:0} 10%{opacity:1} 90%{opacity:1} 100%{left:90%;opacity:0} }
.bj2-step {
  position:relative; z-index:1; flex:1 1 0; display:flex; flex-direction:column; align-items:center; text-align:center;
  opacity:0; transform:translateY(16px); animation:bjStepIn .6s cubic-bezier(.22,1,.36,1) forwards;
}
.bj2-step:nth-child(1){animation-delay:.1s}.bj2-step:nth-child(2){animation-delay:.24s}
.bj2-step:nth-child(3){animation-delay:.38s}.bj2-step:nth-child(4){animation-delay:.52s}
.bj2-step:nth-child(5){animation-delay:.66s}.bj2-step:nth-child(6){animation-delay:.8s}
@keyframes bjStepIn { to{opacity:1;transform:none} }
.bj2-step-dot {
  width:52px; height:52px; border-radius:0; display:flex; align-items:center; justify-content:center;
  background:radial-gradient(circle at 35% 28%, var(--c2), var(--c)); color:#fff; position:relative; margin-bottom:15px;
  box-shadow:0 8px 20px color-mix(in srgb, var(--c) 42%, transparent), 0 0 0 6px color-mix(in srgb, var(--c) 11%, transparent);
  transition:transform .25s ease, box-shadow .25s ease;
}
.bj2-step-dot svg { width:22px; height:22px; }
.bj2-step:hover .bj2-step-dot { transform:translateY(-4px) scale(1.07); box-shadow:0 14px 30px color-mix(in srgb, var(--c) 55%, transparent), 0 0 0 7px color-mix(in srgb, var(--c) 15%, transparent); }
.bj2-step-no {
  position:absolute; top:-7px; right:-7px; width:20px; height:20px; border-radius:0;
  background:#fff; color:var(--cd); font-size:10.5px; font-weight:700; display:flex; align-items:center; justify-content:center;
  box-shadow:0 2px 7px rgba(15,23,42,.2);
}
.bj2-step-name { font-size:14px; font-weight:700; color:var(--cd); letter-spacing:-.015em; line-height:1.15; }
.bj2-step-desc { font-size:11px; color:var(--t2); margin-top:4px; line-height:1.4; max-width:130px; }
.bj2-step-dur {
  margin-top:10px; font-size:10.5px; font-weight:600; color:var(--cd);
  background:color-mix(in srgb, var(--c) 9%, var(--bg2)); border:1px solid color-mix(in srgb, var(--c) 24%, transparent);
  padding:3px 10px; border-radius:0; white-space:nowrap;
}
.bj2-step:last-child .bj2-step-dot::after {
  content:""; position:absolute; inset:-7px; border-radius:0;
  border:2px solid color-mix(in srgb, var(--c) 55%, transparent); animation:bjPulse 2.4s ease-out infinite;
}
@keyframes bjPulse { 0%{transform:scale(.8);opacity:.85} 100%{transform:scale(1.55);opacity:0} }
@media (max-width:760px) {
  .bj2-flow { flex-direction:column; gap:0; margin-top:1.75rem; }
  .bj2-flow::before { left:25px; right:auto; top:2%; bottom:2%; width:3px; height:auto;
    background:linear-gradient(180deg,#3B82F6,#8B5CF6,#EC4899,#14B8A6,#F59E0B,#6366F1); }
  .bj2-flow::after { display:none; }
  .bj2-step { flex-direction:row; align-items:center; text-align:left; gap:15px; padding:9px 0; }
  .bj2-step-dot { width:44px; height:44px; margin-bottom:0; flex-shrink:0; }
  .bj2-step-dot svg { width:19px; height:19px; }
  .bj2-step-body { display:flex; flex-direction:column; }
  .bj2-step-desc { max-width:none; margin-top:2px; }
  .bj2-step-dur { margin-top:0; margin-left:auto; align-self:center; }
}
@media (prefers-reduced-motion: reduce) {
  .bj2-flow::after, .bj2-step:last-child .bj2-step-dot::after { animation:none !important; }
  .bj2-step { opacity:1 !important; transform:none !important; animation:none !important; }
}

/* ── WHY RE-BRAND BAR ── */
.bj2-why-wrap {
  margin: 0 0 1.75rem;
  border: 1px solid #E2E8F0;
  border-radius:0;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 8px 24px rgba(15,23,42,.04);
}
.bj2-why-toggle {
  display: flex; align-items: center; gap: 16px;
  padding: 1.1rem 1.5rem; cursor: pointer; user-select: none;
  transition: background .2s;
}
.bj2-why-toggle:hover { background: #FAFBFE; }
.bj2-why-icon-box {
  width: 42px; height: 42px; border-radius:0;
  background: linear-gradient(135deg,#2563EB,#7C3AED);
  display: flex; align-items: center; justify-content: center;
  font-size: 19px; flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(99,102,241,.32);
  transition: transform .35s cubic-bezier(.34,1.56,.64,1);
}
.bj2-why-wrap .bj2-why-icon-box { transform: rotate(180deg) scale(1.05); }
.bj2-why-wrap.closed .bj2-why-icon-box { transform: rotate(0deg) scale(1); }
.bj2-why-label { flex: 1; }
.bj2-why-title { font-size: 15px; font-weight:700; color: #0F172A; letter-spacing: -.01em; }
.bj2-why-sub { font-size: 12px; color: #94A3B8; margin-top: 2px; }
.bj2-why-meta { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.bj2-why-count {
  font-size: 11px; font-weight:600; color: #6366F1;
  background: rgba(99,102,241,.1);
  border: 1px solid rgba(99,102,241,.2);
  padding: 4px 11px; border-radius:0; letter-spacing: .03em;
}
.bj2-why-chevron {
  width: 30px; height: 30px; border-radius:0;
  background: #F1F5F9; border: 1px solid #E2E8F0;
  display: flex; align-items: center; justify-content: center;
  color: #64748B;
  transition: all .3s cubic-bezier(.34,1.56,.64,1);
}
.bj2-why-wrap .bj2-why-chevron { transform: rotate(180deg); background: linear-gradient(135deg,#2563EB,#7C3AED); border-color: transparent; color: #fff; }
.bj2-why-wrap.closed .bj2-why-chevron { transform: rotate(0deg); background: #F1F5F9; border-color: #E2E8F0; color: #64748B; }

.bj2-why-panel { max-height: none; overflow: visible; transition: max-height .5s cubic-bezier(.4,0,.2,1); }
.bj2-why-wrap.closed .bj2-why-panel { max-height: 0; overflow: hidden; }
.bj2-why-wrap.open .bj2-why-panel { max-height: none; overflow: visible; }
.bj2-why-panel-inner { padding: 0 1.5rem 1.5rem; border-top: 1px solid #F1F5F9; }
.bj2-why-note { font-size: 12.5px; color: #64748B; line-height: 1.65; padding: 1rem 0 1.1rem; }
/* ── Why Brand Diagram ── */

/* ── Phase board process title strip ── */
.bj2-process-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.1rem 1.6rem;
  margin-bottom: .75rem;
  background: linear-gradient(135deg, #F8FAFC 0%, #EEF2FF 50%, #F0FDF4 100%);
  border: 1px solid #E2E8F0;
  border-radius:0;
  position: relative;
  overflow: hidden;
}
.bj2-process-title::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6px;
  background: linear-gradient(180deg, #3B82F6, #8B5CF6, #EC4899, #14B8A6, #F59E0B, #6366F1);
}
/* subtle shimmer */
.bj2-process-title::after {
  content:'';
  position:absolute; inset:0;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,.5) 50%, transparent 60%);
  animation: procShimmer 4s ease-in-out infinite;
}
@keyframes procShimmer { 0%,100%{opacity:0} 50%{opacity:1} }
.bj2-process-name {
  font-size: 22px;
  font-weight:700;
  color: #0F172A;
  letter-spacing: -.03em;
  padding-left: 10px;
  position: relative; z-index:1;
}
.bj2-process-name span {
  background: linear-gradient(135deg, #3B82F6, #8B5CF6, #EC4899);
  background-size: 200%;
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  animation: procNameShift 5s ease-in-out infinite alternate;
}
@keyframes procNameShift { 0%{background-position:0%} 100%{background-position:100%} }
.bj2-process-byline {
  font-size: 11px;
  color: #64748B;
  font-weight: 500;
  padding-left: 10px;
  letter-spacing: -.01em;
  position: relative; z-index: 1;
}
.bj2-process-byline strong {
  color: #1E293B;
  font-weight:600;
}
.bj2-process-tm {
  font-size: 9px;
  font-weight:600;
  letter-spacing: .12em;
  color: #64748B;
  text-transform: uppercase;
  border: 1px solid #CBD5E1;
  padding: 5px 12px;
  border-radius:0;
  background: #fff;
  position: relative; z-index:1;
  white-space: nowrap;
}
.bj2-process-steps {
  display: flex;
  gap: 5px;
  align-items: center;
  position: relative; z-index:1;
}
.bj2-process-step-dot {
  width: 8px; height: 8px;
  border-radius:0;
}
@media(max-width:1080px) { .bj2-process-title { display:none; } }

.bj2-diag-wrap {
  margin: 0 0 1.5rem;
  padding: 1.5rem 1.5rem 1.2rem;
  background: linear-gradient(135deg,#F8FAFC 0%,#F1F5F9 100%);
  border: 1px solid #E2E8F0;
  border-radius:0;
  position: relative;
  overflow: hidden;
}
.bj2-diag-wrap::before {
  content:'';
  position:absolute; inset:0;
  background-image: radial-gradient(circle, #CBD5E1 1px, transparent 1px);
  background-size: 18px 18px;
  opacity:.25;
  pointer-events:none;
}

/* ── Flow Diagram root ── */
.fd-root {
  display: flex;
  align-items: center;
  gap: 10px;
  position: relative;
  min-height: 180px;
}

/* Trigger boxes column */
.fd-triggers {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex-shrink: 0;
  width: 186px;
}
.fd-trig {
  background: var(--tb);
  border: 1.5px solid var(--tbo);
  border-radius:0;
  padding: 6px 9px;
  display: flex; flex-direction: row; align-items: center; gap: 8px;
}
.fd-trig-ic {
  width: 27px; height: 27px; flex-shrink: 0;
  border-radius:0;
  background: #fff;
  border: 1.5px solid var(--tbo);
  color: var(--tc);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 1px 3px rgba(15,23,42,.06);
}
.fd-trig-ic svg { width: 14px; height: 14px; display: block; }
.fd-trig-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.fd-trig-label {
  font-size: 8px; font-weight:700; letter-spacing: .1em; text-transform: uppercase;
  font-family: 'Inter', sans-serif;
}
.fd-trig-sub {
  font-size: 8.5px; color: #475569; font-family: 'Inter', sans-serif;
}

/* Arrow connectors */
.fd-arrow-col { flex-shrink: 0; display: flex; align-items: center; }
.fd-arrow-in  { width: 44px; align-self: stretch; }
.fd-arrow-mid { width: 48px; }
.fd-svg-conn  { width: 44px; height: 100%; display: block; }
.fd-svg-h     { width: 48px; height: 20px; display: block; overflow: visible; }

/* Animated flowing dashes */
@keyframes fdDash { to { stroke-dashoffset: -18; } }
@keyframes fdLine { to { stroke-dashoffset: -24; } }
.fd-dash-flow { animation: fdDash 1s linear infinite; }
.fd-line-flow { stroke-dasharray: 6 4; animation: fdLine 1s linear infinite; }

/* Centre: Brand Problem circle — soft white glass */
.fd-centre {
  flex-shrink: 0;
  position: relative;
  width: 94px; height: 94px;
  display: flex; align-items: center; justify-content: center;
  overflow: visible; /* allow ring to extend beyond box without clipping */
}
.fd-problem-ring {
  position: absolute; inset: -6px;
  border-radius:0;
  border: 1.5px dashed rgba(99,102,241,.25);
  animation: fdRingPulse 3s ease-in-out infinite;
}
@keyframes fdRingPulse { 0%,100%{opacity:.4;transform:scale(1)} 50%{opacity:.9;transform:scale(1.04)} }
.fd-problem {
  width: 94px; height: 94px; border-radius:0;
  background: linear-gradient(135deg,#EEF2FF 0%,#E0E7FF 50%,#C7D2FE 100%);
  border: 2px solid #A5B4FC;
  box-shadow: 0 4px 18px rgba(99,102,241,.18), inset 0 1px 0 rgba(255,255,255,.9);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0;
  position: relative; z-index: 1;
}
.fd-prob-title {
  font-size: 8.5px; font-weight:700; letter-spacing: .14em; color: #3730A3;
  font-family: 'Fraunces', sans-serif; line-height: 1.35;
}
.fd-prob-sub {
  font-size: 7px; color: #6366F1; margin-top: 3px; font-weight: 500;
  font-family: 'Inter', sans-serif;
}

/* BrandMethod logo pill */
.fd-bm-pill {
  flex-shrink: 0;
  background: #fff;
  border: 1.5px solid #C7D2FE;
  border-radius:0;
  padding: 7px 14px 7px 12px;
  font-size: 11px; font-weight:700; letter-spacing: -.02em;
  color: #1E1B4B; white-space: nowrap;
  box-shadow: 0 2px 12px rgba(99,102,241,.14);
  display: flex; align-items: center; gap: 2px;
  font-family: 'Inter', sans-serif;
}
.fd-bm-b { color: #2563EB; }
.fd-bm-star {
  font-size: 14px;
  margin-left: 4px;
  color: #2563EB;
  animation: logo-spin 6s linear infinite;
  display: inline-block;
}

/* Right solution boxes */
.fd-solutions {
  flex-shrink: 0;
  display: flex; flex-direction: column; gap: 6px;
  width: 192px;
}
.fd-sol {
  background: #fff;
  border: 1px solid #E2E8F0;
  border-radius:0;
  padding: 7px 9px;
  display: flex; align-items: center; gap: 9px;
  box-shadow: 0 1px 4px rgba(0,0,0,.05);
}
.fd-sol-bar {
  width: 4px; border-radius:0; flex-shrink: 0;
  background: var(--sc);
  align-self: stretch;
}
.fd-sol-ic {
  width: 27px; height: 27px; flex-shrink: 0;
  border-radius:0;
  background: color-mix(in srgb, var(--sc) 13%, #fff);
  color: var(--sc);
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sc) 22%, transparent);
}
.fd-sol-ic svg { width: 14px; height: 14px; display: block; }
.fd-sol-text { display: flex; flex-direction: column; gap: 1px; }
.fd-sol-text strong {
  font-size: 9.5px; font-weight:600; color: #0F172A;
  font-family: 'Inter', sans-serif;
}
.fd-sol-text span {
  font-size: 8px; color: #64748B;
  font-family: 'Inter', sans-serif;
}

/* Result box — light gradient, NOT dark */
.fd-result {
  flex-shrink: 0;
  background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 60%, #C7D2FE 100%);
  border: 1.5px solid #A5B4FC;
  border-radius:0;
  padding: 14px 16px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  min-width: 110px;
  box-shadow: 0 4px 18px rgba(99,102,241,.15), 0 0 0 3px rgba(165,180,252,.2);
  position: relative; overflow: hidden;
}
.fd-result-bar {
  position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, #6366F1, #A5B4FC);
}
.fd-result-ic {
  width: 30px; height: 30px; border-radius:0;
  background: rgba(99,102,241,.13);
  color: #4F46E5;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 3px;
  box-shadow: inset 0 0 0 1px rgba(99,102,241,.22);
}
.fd-result-ic svg { width: 16px; height: 16px; display: block; }
.fd-result-top {
  font-size: 11px; font-weight:600; color: #1E1B4B;
  font-family: 'Fraunces', sans-serif;
}
.fd-result-big {
  font-size: 18px; font-weight:700; color: #4F46E5; letter-spacing: -.03em;
  font-family: 'Fraunces', sans-serif; line-height: 1;
}
.fd-result-sub {
  font-size: 7.5px; color: #6366F1; text-align: center; margin-top: 4px;
  font-family: 'Inter', sans-serif; line-height: 1.5;
}

/* ── MOBILE: vertical stacked layout ── */
@media (max-width: 720px) {
  .fd-root {
    flex-direction: column;
    align-items: center;   /* centre all children horizontally */
    gap: 0;
    min-height: unset;
  }
  .fd-arrow-in, .fd-arrow-mid { display: none; }

  /* Triggers: 2-col grid */
  .fd-triggers {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 0;
    animation: fdMobSlideDown .5s cubic-bezier(.22,.61,.36,1) both;
  }
  @keyframes fdMobSlideDown { from{opacity:0;transform:translateY(-14px)} to{opacity:1;transform:translateY(0)} }
  .fd-trig-label { font-size: 7.5px; }
  .fd-trig-sub   { font-size: 8px; }
  .fd-trig { gap: 6px; padding: 6px 7px; }
  .fd-trig-ic { width: 23px; height: 23px; border-radius:0; }
  .fd-trig-ic svg { width: 12px; height: 12px; }
  .fd-sol-ic { width: 25px; height: 25px; }

  /* Shared vertical connector — appears ABOVE each element */
  .fd-centre, .fd-bm-pill, .fd-solutions, .fd-result {
    position: relative;
  }
  .fd-centre::before, .fd-bm-pill::before,
  .fd-solutions::before, .fd-result::before {
    content: '';
    position: absolute;
    top: -14px; left: 50%; transform: translateX(-50%);
    width: 2px; height: 14px; border-radius:0;
    animation: fdConnPulse 2s ease-in-out infinite;
  }
  @keyframes fdConnPulse { 0%,100%{opacity:.45} 50%{opacity:1} }
  .fd-centre::before   { background: linear-gradient(to bottom, #C7D2FE, #6366F1); }
  .fd-bm-pill::before  { background: linear-gradient(to bottom, #6366F1, #A5B4FC); animation-delay:.3s; }
  .fd-solutions::before{ background: linear-gradient(to bottom, #A5B4FC, #6366F1); animation-delay:.6s; }
  .fd-result::before   { background: linear-gradient(to bottom, #6366F1, #4F46E5); animation-delay:.9s; }

  /* Circle — centred, overflow visible so ring doesn't clip */
  .fd-centre {
    align-self: center;
    margin: 14px auto 10px;
    overflow: visible;
    animation: fdMobSlideDown .5s .1s cubic-bezier(.22,.61,.36,1) both;
  }
  .fd-problem-ring { animation: fdRingPulse 2.5s ease-in-out infinite; }
  .fd-problem::after {
    content: '';
    position: absolute;
    inset: -12px; border-radius:0;
    border: 1px dashed rgba(99,102,241,.15);
    animation: fdRingOrbit 8s linear infinite;
  }
  @keyframes fdRingOrbit { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }

  /* BrandMethod pill — centred, breathing glow */
  .fd-bm-pill {
    align-self: center;
    margin: 14px auto 10px;
    animation: fdMobSlideDown .5s .2s cubic-bezier(.22,.61,.36,1) both,
               fdPillBreathe 3s 1s ease-in-out infinite;
  }
  @keyframes fdPillBreathe {
    0%,100% { box-shadow: 0 2px 12px rgba(99,102,241,.14); }
    50%     { box-shadow: 0 4px 22px rgba(99,102,241,.34), 0 0 0 3px rgba(165,180,252,.18); }
  }

  /* Solution cards — full width, staggered slide-in */
  .fd-solutions { width: 100%; margin: 14px 0 10px; }
  .fd-sol { animation: fdCardIn .45s cubic-bezier(.22,.61,.36,1) both; }
  .fd-sol:nth-child(1) { animation-delay:.30s; }
  .fd-sol:nth-child(2) { animation-delay:.42s; }
  .fd-sol:nth-child(3) { animation-delay:.54s; }
  .fd-sol:nth-child(4) { animation-delay:.66s; }
  @keyframes fdCardIn { from{opacity:0;transform:translateX(-10px)} to{opacity:1;transform:translateX(0)} }

  /* Result box — centred, shimmer on the accent bar only */
  .fd-result {
    align-self: center;
    width: 100%;
    margin-top: 14px;
    overflow: visible;  /* allow connector line to show above */
    animation: fdMobSlideDown .5s .75s cubic-bezier(.22,.61,.36,1) both;
  }
  .fd-result-bar {
    position: relative;
    overflow: hidden;
  }
  .fd-result-bar::after {
    content: '';
    position: absolute; top: 0; left: -80%; width: 60%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent);
    animation: fdBarShimmer 3.5s ease-in-out 1.5s infinite;
  }
  @keyframes fdBarShimmer { 0%{left:-80%} 40%{left:120%} 100%{left:120%} }
}
