<script>
(function(){
  var fbRating = 0;
  var hints = ['', 'Not useful', 'Could be better', 'It is okay', 'Pretty good', 'Very useful'];
  var rate = document.getElementById('fb-rate');
  if(rate){
    rate.addEventListener('click', function(e){
      var b = e.target.closest('.fb-star'); if(!b) return;
      fbRating = parseInt(b.getAttribute('data-v'), 10);
      [].forEach.call(rate.querySelectorAll('.fb-star'), function(s){
        s.classList.toggle('on', parseInt(s.getAttribute('data-v'),10) <= fbRating);
      });
      document.getElementById('fb-rate-hint').textContent = hints[fbRating] || 'Tap a star to rate';
    });
  }
  var chips = document.getElementById('fb-chips');
  if(chips){
    chips.addEventListener('click', function(e){
      var c = e.target.closest('.fb-chip'); if(!c) return;
      c.classList.toggle('on');
    });
  }
  window.sendFeedback = function(mode){
    var picked = [].map.call(document.querySelectorAll('#fb-chips .fb-chip.on'), function(c){ return c.getAttribute('data-c'); });
    var improve = (document.getElementById('fb-improve').value || '').trim();
    var add = (document.getElementById('fb-add').value || '').trim();
    var name = (document.getElementById('fb-name').value || '').trim();
    var contact = (document.getElementById('fb-contact').value || '').trim();
    if(!fbRating && !picked.length && !improve && !add){
      var hint = document.getElementById('fb-rate-hint');
      hint.textContent = 'Add a rating or a quick note first 🙂';
      hint.style.color = '#DC2626';
      return;
    }
    var lines = ['BrandMethod services page feedback', ''];
    lines.push('Rating: ' + (fbRating ? fbRating + '/5' : 'not given'));
    if(picked.length) lines.push('Tags: ' + picked.join(', '));
    if(improve) lines.push('', 'Improve / fix:', improve);
    if(add) lines.push('', 'Would like added:', add);
    if(name || contact) lines.push('', 'From: ' + [name, contact].filter(Boolean).join(' · '));
    var body = lines.join('\n');
    if(mode === 'email'){
      window.location.href = 'mailto:bazil@brandmethod.co?subject=' + encodeURIComponent('Services page feedback') + '&body=' + encodeURIComponent(body);
    } else {
      window.open('https://wa.me/60122826371?text=' + encodeURIComponent(body), '_blank', 'noopener');
    }
    var card = document.getElementById('fb-card');
    if(card){
      card.innerHTML = '<div class="fb-thanks"><div class="fb-th-ic">🙏</div><h3>Thank you, that really helps</h3><p>Your ' + (mode === 'email' ? 'email' : 'WhatsApp message') + ' is ready to send in the window that just opened. If it did not open, reach us at wa.me/60122826371 or bazil@brandmethod.co.</p></div>';
    }
  };
})();
