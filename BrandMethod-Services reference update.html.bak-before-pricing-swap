/* ── 4+ panel blocks: horizontal scroll ── */
.svc-panels {
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none;
}
.svc-panels::-webkit-scrollbar { display: none; }

/* ── 4-panel carousel with peek effect ── */
.has-four-wrap {
  position: relative;
}
/* Fade-out right edge to signal more content */
.has-four-wrap::after {
  content: '';
  position: absolute;
  top: 0; right: 0; bottom: 0;
  width: 80px;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.92));
  pointer-events: none;
  z-index: 10;
  border-radius:0;
}
.svc-panels.has-four {
  display: flex !important;
  overflow-x: auto !important;
  scroll-snap-type: x mandatory !important;
  gap: 16px !important;
  cursor: grab !important;
  scrollbar-width: none;
  -ms-overflow-style: none;
  background: transparent !important;
  /* Show 3 panels + peek of 4th */
  padding: 4px 60px 4px 0 !important;
}
.svc-panels.has-four::-webkit-scrollbar { display: none; }
.svc-panels.has-four:active { cursor: grabbing !important; }
.svc-panels.has-four .svc-panel {
  flex: 0 0 calc((100% - 32px) / 3) !important;
  min-width: 240px !important;
  scroll-snap-align: start !important;
  border-radius:0!important;
  overflow: hidden !important;
  margin: 0 !important;
  box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 6px 20px rgba(15,23,42,.05) !important;
}
/* gap between floating cards */
.svc-panels.has-four { gap: 16px !important; }
.svc-panels.has-four .svc-panel + .svc-panel { box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 6px 20px rgba(15,23,42,.05) !important; }

/* Scroll nav dots */
.svc-scroll-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 0 4px;
}
.ssc-dot {
  width: 6px; height: 6px; border-radius:0;
  background: #CBD5E1; transition: all .25s; cursor: pointer;
}
.ssc-dot.active { width: 20px; border-radius:0; background: var(--navy); }

/* Scroll hint */
.svc-scroll-hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
  font-size: 11.5px;
  color: #94A3B8;
  padding: 0 4px 8px;
  font-weight: 600;
  letter-spacing: .03em;
  animation: hint-pulse 2s ease-in-out 1s 3;
}
.svc-scroll-hint::before { content: ''; display: block; width: 20px; height: 1.5px; background: #CBD5E1; }
@keyframes hint-pulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }

/* Mobile */
@media(max-width: 768px) {
  .svc-panels.has-four .svc-panel {
    flex: 0 0 82% !important;
    min-width: 0 !important;
  }
  .has-four-wrap::after { width: 50px; }
}
@media(min-width: 769px) and (max-width: 1000px) {
  .svc-panels.has-four .svc-panel { flex: 0 0 50% !important; }
}
}
@media(max-width: 768px) {
