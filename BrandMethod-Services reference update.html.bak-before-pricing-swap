  min-width: 0 !important;
  border-radius:0!important;
  box-shadow: none !important;
  scroll-snap-align: none !important;
  margin: 0 !important;
}
.svc-block .svc-panels.has-four .svc-panel + .svc-panel {
  box-shadow: -1px 0 0 var(--br) !important;
}
