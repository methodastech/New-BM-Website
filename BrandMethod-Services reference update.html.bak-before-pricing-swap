  var max = body.scrollHeight - body.clientHeight;
  document.getElementById('jm-progline').style.width = (max > 0 ? (body.scrollTop / max) * 100 : 0) + '%';
  var lightLine = body.scrollTop + body.clientHeight * 0.9;
  var probe = body.scrollTop + 120, idx = -1;
  _jmSecs.forEach(function(sec, si){
    if (sec.offsetTop < lightLine) sec.classList.add('on');
    if (sec.offsetTop <= probe) idx = si;
  });
  Array.prototype.forEach.call(document.querySelectorAll('#jm-body-pad .jm-static'), function(st){
    if (st.offsetTop < lightLine) st.classList.add('on');
  });
  if (idx !== _jmActive) {
    _jmActive = idx;
    var chipsEls = document.querySelectorAll('#jm-nav .jm-navchip');
    Array.prototype.forEach.call(chipsEls, function(c, ci){ c.classList.toggle('act', ci === idx); });
  }
}
function jmGo(i){
  var sec = _jmSecs[i];
  if (!sec) return;
  var body = document.getElementById('jm-body');
  if (_jmAnim) cancelAnimationFrame(_jmAnim);
  var nav = document.getElementById('jm-nav');
  var off = nav ? nav.offsetHeight : 0;
  var from = body.scrollTop, to = Math.max(sec.offsetTop - off - 4, 0), t0 = null, D = 480;
  function ease(t){ return t < .5 ? 2*t*t : 1 - Math.pow(-2*t + 2, 2) / 2; }
  function frame(ts){
    if (t0 === null) t0 = ts;
    var k = Math.min((ts - t0) / D, 1);
    body.scrollTop = from + (to - from) * ease(k);
    if (k < 1) { _jmAnim = requestAnimationFrame(frame); }
    else { _jmAnim = null; }
  }
  _jmAnim = requestAnimationFrame(frame);
}
