  var atEnd = row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
  var canScroll = row.scrollWidth > row.clientWidth + 8;
  document.getElementById('bm-scroll-l').classList.toggle('show', canScroll && !atStart);
