/* ── MOBILE ── */
.bj2-mobile-hint { display: none; }
/* Mobile progress stepper — hidden on desktop, shown ≤1080px */
.bj2-mprog { display: none; }
@media (max-width: 1080px) {
  .bj2-mprog {
    display: block;
    position: relative;
    margin: 0 0 1.2rem;
