.play-hook{margin-top:8px;padding:8px 12px;background:#FFFBEB;border-left:3px solid #FBBF24;border-radius:0;font-size:12px;color:#78350F;font-style:italic;line-height:1.5}
.play-hook::before{content:"💬 ";font-style:normal}
.play-metric{margin-top:6px;font-size:11px;color:var(--green);font-weight:600;display:inline-flex;align-items:center;gap:4px}
.play-metric::before{content:"📊";font-size:12px}

/* ── MILLION RINGGIT ROADMAP ── */
.mrm-intro{font-size:14px;color:var(--t1);line-height:1.7;background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--br);border-radius:0;padding:1.3rem 1.5rem;margin-bottom:2rem;box-shadow:var(--sh)}
.mrm-section{margin-bottom:2.5rem}
.mrm-head{font-size:18px;font-weight:700;color:var(--navy);margin-bottom:6px;display:flex;align-items:center;gap:10px;letter-spacing:-.01em}
.mrm-tag{font-size:10px;font-weight:700;letter-spacing:.1em;background:var(--navy);color:#fff;padding:4px 10px;border-radius:0}
.mrm-sub{font-size:13px;color:var(--t2);margin-bottom:1.2rem;line-height:1.5}

/* Sequence */
.mrm-seq{display:flex;flex-direction:column;gap:14px}
.mrm-seq-item{display:grid;grid-template-columns:48px 1fr;gap:18px;background:var(--bg2);border:1px solid var(--br);border-left:4px solid var(--blue);border-radius:0;padding:1.2rem 1.4rem;box-shadow:var(--sh)}
.mrm-seq-num{width:44px;height:44px;border-radius:0;background:linear-gradient(135deg,var(--blue),#2563EB);color:#fff;font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 10px rgba(59,130,246,.25)}
.mrm-seq-body{display:flex;flex-direction:column;gap:6px}
.mrm-seq-title{font-size:15.5px;font-weight:700;color:var(--navy);line-height:1.3}
.mrm-seq-meta{display:flex;flex-wrap:wrap;gap:6px;margin:2px 0 6px}
.mrm-pill{display:inline-flex;align-items:center;font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:0;letter-spacing:.02em}
.mrm-pill.green{background:var(--gl);color:var(--green)}
.mrm-pill.blue{background:var(--bl);color:var(--blue)}
.mrm-pill.purple{background:#F3E8FF;color:#7C3AED}
.mrm-pill.grey{background:var(--bg3);color:var(--t2);border:1px solid var(--br)}
.mrm-seq-desc{font-size:13px;color:var(--t1);line-height:1.6;margin-top:2px}
.mrm-seq-why{margin-top:8px;padding:8px 12px;background:#ECFDF5;border-left:3px solid var(--green);border-radius:0;font-size:12.5px;color:#065F46;line-height:1.55}
.mrm-seq-why strong{color:#064E3B;font-weight:600}
.mrm-seq-warn{margin-top:6px;padding:8px 12px;background:#FEF2F2;border-left:3px solid var(--red);border-radius:0;font-size:12.5px;color:#7F1D1D;line-height:1.55}
.mrm-seq-warn strong{color:#991B1B;font-weight:600}

/* Stages */
.mrm-stages{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}

/* Journey progress bar */
.mrm-journey{background:linear-gradient(135deg,#FAFBFF,#F0F4FF,#FAFFFE);border:1px solid var(--bb);border-radius:0;padding:1.4rem 1.6rem 1.6rem;margin-bottom:1.8rem;box-shadow:0 4px 20px rgba(59,130,246,.08);position:relative;overflow:hidden}
.mrm-journey::before{content:"";position:absolute;top:0;right:0;width:200px;height:200px;background:radial-gradient(circle,rgba(245,158,11,.08),transparent 70%);pointer-events:none}
.mrm-journey-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-bottom:1.4rem;position:relative;z-index:1}
.mrm-journey-label{font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--t3)}
.mrm-journey-current{font-size:15px;font-weight:700;color:var(--navy);background:linear-gradient(135deg,#FEF3C7,#FDE68A);border:1px solid #F59E0B;padding:6px 14px;border-radius:0;letter-spacing:-.01em}
.mrm-journey-track{position:relative;padding:30px 0 60px;margin:0 6px}
.mrm-journey-fill{position:absolute;top:42px;left:0;height:6px;background:linear-gradient(90deg,#10B981 0%,#10B981 14%,#E5E7EB 14%);border-radius:0;width:100%;box-shadow:inset 0 1px 2px rgba(0,0,0,.06)}
.mrm-journey-marker{position:absolute;top:0;left:14%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;animation:journey-bounce 2.4s ease-in-out infinite}
@keyframes journey-bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-4px)}}
.mrm-journey-marker-flag{font-size:11px;font-weight:700;color:#fff;background:linear-gradient(135deg,#F59E0B,#D97706);padding:5px 12px;border-radius:0;letter-spacing:.02em;box-shadow:0 4px 10px rgba(245,158,11,.35);position:relative;margin-bottom:10px}
.mrm-journey-marker-flag::after{content:"";position:absolute;bottom:-5px;left:50%;transform:translateX(-50%) rotate(45deg);width:10px;height:10px;background:#D97706}
.mrm-journey-marker-dot{width:22px;height:22px;border-radius:0;background:radial-gradient(circle,#F59E0B,#D97706);border:3px solid #fff;box-shadow:0 0 0 3px #F59E0B,0 4px 12px rgba(245,158,11,.4);position:relative}
.mrm-journey-marker-dot::before{content:"";position:absolute;top:50%;left:50%;width:100%;height:100%;border-radius:0;background:#F59E0B;transform:translate(-50%,-50%);opacity:.5;animation:journey-pulse 1.8s ease-out infinite}
@keyframes journey-pulse{0%{transform:translate(-50%,-50%) scale(1);opacity:.5}100%{transform:translate(-50%,-50%) scale(2.4);opacity:0}}
.mrm-journey-stops{position:absolute;top:38px;left:0;right:0;display:flex;justify-content:space-between;pointer-events:none}
.mrm-journey-stop{display:flex;flex-direction:column;align-items:center;width:24%;text-align:center}
.mrm-journey-stop:first-child{align-items:flex-start;text-align:left}
.mrm-journey-stop:last-child{align-items:flex-end;text-align:right}
.mrm-journey-stop-dot{width:14px;height:14px;border-radius:0;background:#E5E7EB;border:3px solid #fff;box-shadow:0 0 0 2px #D1D5DB,0 2px 4px rgba(0,0,0,.08);margin-bottom:8px}
.mrm-journey-stop-dot.green{background:#10B981;box-shadow:0 0 0 2px #10B981,0 2px 6px rgba(16,185,129,.25)}
.mrm-journey-stop-dot.blue{background:#fff;box-shadow:0 0 0 2px #3B82F6,0 2px 4px rgba(0,0,0,.08)}
.mrm-journey-stop-dot.purple{background:#fff;box-shadow:0 0 0 2px #8B5CF6,0 2px 4px rgba(0,0,0,.08)}
.mrm-journey-stop-dot.gold{background:#fff;box-shadow:0 0 0 2px #F59E0B,0 2px 4px rgba(0,0,0,.08)}
.mrm-journey-stop-label{font-size:10.5px;font-weight:700;color:var(--navy);line-height:1.4;letter-spacing:-.01em}
.mrm-journey-stop-label span{font-size:10px;font-weight:600;color:var(--t3);letter-spacing:0}
.mrm-journey-note{font-size:12.5px;color:var(--t1);line-height:1.65;background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:12px 14px;position:relative;z-index:1}
@media(max-width:768px){
  .mrm-journey-stop-label{font-size:10px}
  .mrm-journey-track{padding:30px 0 80px}
  .mrm-journey-stops{flex-wrap:nowrap}
}
.mrm-stage{background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh);display:flex;flex-direction:column}
.mrm-stage-head{padding:1.1rem 1.3rem;color:#fff}
.mrm-stage-head.green{background:linear-gradient(135deg,#10B981,#059669)}
.mrm-stage-head.blue{background:linear-gradient(135deg,#3B82F6,#2563EB)}
.mrm-stage-head.purple{background:linear-gradient(135deg,#8B5CF6,#7C3AED)}
.mrm-stage-head.gold{background:linear-gradient(135deg,#F59E0B,#D97706);position:relative;overflow:hidden}
.mrm-stage-head.gold::after{content:"";position:absolute;top:-50%;right:-30%;width:140px;height:140px;background:radial-gradient(circle,rgba(255,255,255,.25),transparent 70%);pointer-events:none}
.mrm-stage-label{font-size:10px;font-weight:700;letter-spacing:.12em;opacity:.85}
.mrm-stage-revenue{font-size:20px;font-weight:700;letter-spacing:-.01em;margin-top:2px}
.mrm-stage-name{font-size:12.5px;font-weight:600;opacity:.92;margin-top:2px}
.mrm-stage-body{padding:1.2rem 1.3rem;display:flex;flex-direction:column;gap:14px;flex:1}
.mrm-stage-block-title{font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--navy);margin-bottom:6px}
.mrm-list{margin:0;padding-left:1.2rem;font-size:12.5px;color:var(--t1);line-height:1.65}
.mrm-list li{margin-bottom:4px}
.mrm-stage-body-text{font-size:12.5px;color:var(--t1);line-height:1.6}
.mrm-stage-target{margin-top:auto;padding:10px 12px;background:var(--bg3);border:1px solid var(--br);border-radius:0;font-size:12px;color:var(--t1);line-height:1.5}
.mrm-stage-target strong{color:var(--navy);font-weight:600}

/* Kills */
.mrm-kills{display:flex;flex-direction:column;gap:10px}
.mrm-kill{display:grid;grid-template-columns:40px 1fr;gap:14px;background:var(--bg2);border:1px solid var(--br);border-left:4px solid var(--red);border-radius:0;padding:.95rem 1.1rem;box-shadow:var(--sh)}
.mrm-kill-num{width:32px;height:32px;border-radius:0;background:var(--red);color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mrm-kill-title{font-size:13.5px;font-weight:600;color:var(--navy);margin-bottom:3px;line-height:1.3}
.mrm-kill-desc{font-size:12.5px;color:var(--t1);line-height:1.6}
.mrm-kill-desc strong{color:var(--navy);font-weight:600}

/* Principles */
.mrm-principles{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
.mrm-prin{display:grid;grid-template-columns:38px 1fr;gap:12px;background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--br);border-radius:0;padding:1rem 1.1rem;box-shadow:var(--sh);align-items:start}
.mrm-prin-icon{font-size:24px;line-height:1}
.mrm-prin-title{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:4px;line-height:1.3}
.mrm-prin-desc{font-size:12px;color:var(--t2);line-height:1.55}

@media(max-width:768px){
  .mrm-seq-item{grid-template-columns:40px 1fr;gap:12px;padding:1rem 1.1rem}
  .mrm-seq-num{width:36px;height:36px;font-size:15px}
  .mrm-stages{grid-template-columns:1fr}
  .mrm-principles{grid-template-columns:1fr}
}

/* ─────────────────────────────────────────────────────── */
/* PREMIUM ANIMATIONS & MICRO-INTERACTIONS                 */
/* ─────────────────────────────────────────────────────── */

/* Fade-in-on-scroll baseline */
.fade-in{opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.22,.61,.36,1),transform .7s cubic-bezier(.22,.61,.36,1)}
.fade-in.is-visible{opacity:1;transform:none}
.fade-in.delay-1{transition-delay:.08s}
.fade-in.delay-2{transition-delay:.16s}
.fade-in.delay-3{transition-delay:.24s}

/* Honour reduced-motion preference */
@media(prefers-reduced-motion: reduce){
  .fade-in,.fade-in.is-visible{opacity:1;transform:none;transition:none}
  .mrm-journey-marker,.mrm-journey-marker-dot::before{animation:none}
  .svc-panel,.mrm-seq-item,.mrm-stage,.mrm-kill,.mrm-prin,.play-block{transition:none}
  .svc-panel:hover,.mrm-seq-item:hover,.mrm-stage:hover,.mrm-kill:hover,.mrm-prin:hover{transform:none}
}

/* Tier card hover lift: whole card is clickable, lights up in its tier colour */
