.play-step{transition:transform .2s, background .2s}


/* Market analysis block subtle reveal */
.mkt-block{transition:box-shadow .3s, transform .3s}


/* Quality badge sparkle on tier hover */



/* Payment chip subtle hover */



/* Button micro-interactions (already had transform on hover, just enhance) */
.panel-btn{transition:transform .2s cubic-bezier(.22,.61,.36,1), box-shadow .2s, background .2s}
.panel-btn:active{transform:translateY(0);box-shadow:none}

/* Slam-dunk tier subtle attention pulse on entry */
.svc-panel.slam .panel-tag{position:relative}
.svc-panel.slam .panel-tag::after{content:"";position:absolute;top:-2px;left:-2px;right:-2px;bottom:-2px;border-radius:0;border:2px solid var(--green);opacity:0;animation:slam-attention 3s ease-out 1s 2}
