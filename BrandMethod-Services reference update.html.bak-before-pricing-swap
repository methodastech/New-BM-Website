// ── PROCESS JOURNEY (from original) ──
(function(){
  window.bj2RbToggle = function(forceOpen) {
    var wrap = document.getElementById('bj2-rb-bar');
    if (!wrap) return;
    var isClosed = wrap.classList.contains('closed');
    if (forceOpen === true) {
      // force open: remove closed, add open for chevron styling
      wrap.classList.remove('closed');
      wrap.classList.add('open');
      return;
    }
    if (isClosed) {
      wrap.classList.remove('closed');
      wrap.classList.add('open');
    } else {
      wrap.classList.remove('open');
      wrap.classList.add('closed');
    }
  };

  // Phase metadata for the travelling marker
  var BJ2_PHASES = [
    { c:'#3B82F6', label:'1 · Audit' },
    { c:'#8B5CF6', label:'2 · Strategy' },
    { c:'#EC4899', label:'3 · Identity' },
    { c:'#14B8A6', label:'4 · Playbook' },
    { c:'#F59E0B', label:'5 · Conversion' },
    { c:'#6366F1', label:'6 · Engage' }
  ];
  // Node centre positions (%) — match the markup
  var BJ2_POS = [8.33, 25, 41.66, 58.33, 75, 91.66];

  var BJ2_COLORS = ['#3B82F6','#8B5CF6','#EC4899','#14B8A6','#F59E0B','#6366F1'];

  function bj2SyncRail(idx) {
    var fill  = document.getElementById('bj2-rail-fill');
    var trav  = document.getElementById('bj2-traveller');
    var bub   = document.getElementById('bj2-traveller-bubble');
    var ph = BJ2_PHASES[idx] || BJ2_PHASES[0];

    if (fill) {
      fill.style.width = BJ2_POS[idx] + '%';
      var activeColor = BJ2_COLORS[idx] || BJ2_COLORS[0];
      var startColor  = BJ2_COLORS[0];
      fill.style.setProperty('--rf', activeColor);
      fill.style.setProperty('--rf-start', startColor);
    }
    if (trav) {
      trav.style.left = BJ2_POS[idx] + '%';
      trav.style.setProperty('--tc', ph.c);
    }
    if (bub) bub.textContent = ph.label;
    var star = document.getElementById('bj2-traveller-star');
    if (star) star.style.color = ph.c;
    // keep mobile progress bar in sync
    if (typeof bj2MobSyncProgress === 'function') bj2MobSyncProgress(idx);
  }

  window.bj2ColClick = function(col, idx) {
    var cols = document.querySelectorAll('.bj2-c');
    cols.forEach(function(c, i) {
      c.classList.remove('bj2-active', 'bj2-done', 'bj2-pulse', 'bj2-prev', 'bj2-next');
      if (i < idx) c.classList.add('bj2-done');
      // mark immediately adjacent cards for edge blur
      if (i === idx - 1) c.classList.add('bj2-prev');
      if (i === idx + 1) c.classList.add('bj2-next');
    });
    col.classList.add('bj2-active');
    void col.offsetWidth;
    col.classList.add('bj2-pulse');
    setTimeout(function() { col.classList.remove('bj2-pulse'); }, 600);
    bj2SyncRail(idx);

    // On mobile: scroll carousel to this card AND scroll body to show board
    if (window.innerWidth <= 1080) {
      // Scroll the horizontal carousel to bring this card into view
      var colsEl = document.querySelector('.bj2-cols');
      if (colsEl) {
        colsEl.scrollTo({ left: col.offsetLeft - colsEl.offsetLeft, behavior: 'smooth' });
      }
      // Also scroll body so the board top is just below nav
      var board = document.querySelector('.bj2-board');
      if (board) {
        var boardTop = board.getBoundingClientRect().top + window.scrollY;
        var navH = document.querySelector('nav') ? document.querySelector('nav').offsetHeight : 54;
        window.scrollTo({ top: boardTop - navH - 8, behavior: 'smooth' });
      }
    }
  };

  window.bj2RailClick = function(idx) {
    var cols = document.querySelectorAll('.bj2-c');
    if (cols[idx]) bj2ColClick(cols[idx], idx);
  };

  // Mobile: next-phase scroll button
  window.bj2MobScrollNext = function() {
    var cols = document.querySelector('.bj2-cols');
    if (!cols) return;
    // find current scroll position and advance by one card width
    var cardW = cols.querySelector('.bj2-c') ? cols.querySelector('.bj2-c').offsetWidth + 10 : 280;
    cols.scrollBy({ left: cardW, behavior: 'smooth' });
  };

  // Mobile: jump to a specific phase card (from progress-bar dot)
  window.bj2MobGo = function(idx) {
    var cols = document.querySelector('.bj2-cols');
    if (!cols) return;
    var cards = cols.querySelectorAll('.bj2-c');
    if (!cards[idx]) return;
    cols.scrollTo({ left: cards[idx].offsetLeft - cols.offsetLeft, behavior: 'smooth' });
    bj2ColClick(cards[idx], idx);
  };

  // Mobile: update the progress stepper to a given active phase index
  var BJ2_MPF = ['#3B82F6','#8B5CF6','#EC4899','#14B8A6','#F59E0B','#6366F1'];
  function bj2MobSyncProgress(idx) {
    var dots = document.querySelectorAll('.bj2-mprog-dot');
    if (!dots.length) return;
    dots.forEach(function(d, i){
      d.classList.remove('active','done');
      if (i < idx) d.classList.add('done');
      else if (i === idx) d.classList.add('active');
    });
    // sync label active/done states
    var labels = document.querySelectorAll('.bj2-mprog-label');
    labels.forEach(function(l, i){
      l.classList.remove('active','done');
      if (i < idx) l.classList.add('done');
      else if (i === idx) l.classList.add('active');
    });
    var fill = document.getElementById('bj2-mprog-fill');
    if (fill) {
      var pct = dots.length > 1 ? (idx / (dots.length - 1)) * 100 : 0;
      fill.style.width = pct + '%';
      fill.style.setProperty('--mpf', BJ2_MPF[idx] || BJ2_MPF[0]);
    }
  }
  window.bj2MobSyncProgress = bj2MobSyncProgress;

  // Mobile: keep progress bar in sync while the user swipes the cards
  (function(){
    var cols = document.querySelector('.bj2-cols');
    if (!cols) return;
    var raf = null;
    cols.addEventListener('scroll', function(){
      if (raf) return;
      raf = requestAnimationFrame(function(){
        raf = null;
        var cards = cols.querySelectorAll('.bj2-c');
        if (!cards.length) return;
        var best = 0, bestDist = Infinity;
        cards.forEach(function(c, i){
          var d = Math.abs((c.offsetLeft - cols.offsetLeft) - cols.scrollLeft);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        bj2MobSyncProgress(best);
        // apply blur classes based on scroll position
        cards.forEach(function(c, i){
          c.classList.remove('bj2-prev', 'bj2-next');
          if (i === best - 1) c.classList.add('bj2-prev');
          if (i === best + 1) c.classList.add('bj2-next');
        });
      });
    }, { passive: true });
  })();

  // Init: auto-walk 1→6 once when page first opens, then settle on 1.
  var _bj2Walked = false;
  function bj2InitJourney() {
    // always ensure columns are visible (no stale opacity:0 from animation)
    document.querySelectorAll('.bj2-c').forEach(function(c){ c.style.opacity='1'; });

    if (_bj2Walked) {
      // re-opening the tab: just reactivate phase 1, no walk
      var cols = document.querySelectorAll('.bj2-c');
      if (cols[0]) bj2ColClick(cols[0], 0);
      bj2RbToggle(true);
      return;
    }
    var cols = document.querySelectorAll('.bj2-c');
    if (!cols.length) return;
    _bj2Walked = true;

    bj2ColClick(cols[0], 0);
    // open why brand panel on first load
    bj2RbToggle(true);

    var seq = [1,2,3,4,5,0];
    var t = 420;
    seq.forEach(function(i) {
      setTimeout(function(){ if (cols[i]) bj2ColClick(cols[i], i); }, t);
      t += 420;
    });
  }
  window.bj2InitJourney = bj2InitJourney;
})();

var _bmpdOpened = false;
(function(){
  var bar=document.getElementById('bmpd-toggle');
  if(bar&&'IntersectionObserver' in window){
    var done=false;
