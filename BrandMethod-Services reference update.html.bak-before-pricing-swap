}
.p1-hero-stat-label {
  font-size:10px; font-weight:600; color:rgba(148,163,184,.55);
  text-transform:uppercase; letter-spacing:.12em;
}

/* Section wrapper */
/* Sections flow free on the page (no card chrome) — separated by space + the numbered header rule */
.p1-section {
  background: transparent;
  border: none;
  border-radius:0;
  padding: 0;
  margin-bottom: 2.9rem;
  box-shadow: none;
}
@media(max-width:768px){ .p1-section{ margin-bottom: 2.1rem; } }
/* connective tissue between sections — a full-width labeled divider: separates clearly AND bridges */
.sec-link{display:flex;align-items:center;gap:14px;margin:-.3rem 0 1.9rem;width:100%;animation:secLinkIn .5s ease both}
.sec-link::before,.sec-link::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--br) 22%,var(--br) 78%,transparent)}
