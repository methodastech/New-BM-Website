  margin-top: auto !important;
  background: rgba(0,0,0,0.02) !important;
}
/* The CTA panel-btn inside footer — full width */
.panel-view-footer .panel-btn {
  display: block !important;
  width: 100% !important;
  margin-bottom: 0 !important;
}
/* Tier-specific footer backgrounds */
.svc-panel.bespoke .panel-view-footer { background: #FEFCE8 !important; border-top-color: rgba(184,151,10,0.2) !important; }
.svc-panel.premium .panel-view-footer { background: #FEF6ED !important; border-top-color: rgba(180,83,9,0.15) !important; }
