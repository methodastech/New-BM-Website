<script id="bmref-logo-fix">
/* Recolour the monochrome BRAND METHOD logo to exactly #2536F5 (same blue as "Maximum quality") via alpha mask */
(function(){
  function fix(){
    var img=document.querySelector('#bmref-hd .nav-logo img');
    if(!img||!img.src||img.dataset.recoloured) return;
    var w=img.offsetWidth||img.getBoundingClientRect().width, h=img.offsetHeight||img.getBoundingClientRect().height;
    if(!w||!h){ return setTimeout(fix,120); }
    var a=img.closest('.nav-logo')||img.parentNode;
    var span=document.createElement('span');
    span.style.cssText='display:inline-block;width:'+w+'px;height:'+h+'px;background:#2536F5;-webkit-mask:url("'+img.src+'") left center/contain no-repeat;mask:url("'+img.src+'") left center/contain no-repeat;';
    img.style.display='none'; img.dataset.recoloured='1';
    a.appendChild(span);
  }
  if(document.readyState!=='loading') setTimeout(fix,60); else document.addEventListener('DOMContentLoaded',function(){setTimeout(fix,60);});
})();
</script>

