/* Phase toggle button */
.sop-phase-toggle{display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none}
.sop-toggle-btn{width:30px;height:30px;border-radius:0;background:rgba(0,0,0,.05);border:1px solid var(--br);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s;color:var(--t3)}
.sop-toggle-btn svg{transition:transform .3s ease}
.sop-phase.sop-collapsed .sop-toggle-btn svg{transform:rotate(-90deg)}
.sop-toggle-btn:hover{background:var(--navy);color:#fff;border-color:var(--navy)}

/* Phase entrance animation */
@keyframes sopPhaseIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.sop-phase{animation:sopPhaseIn .35s ease both}
.sop-phase:nth-child(1){animation-delay:.05s}
.sop-phase:nth-child(2){animation-delay:.1s}
.sop-phase:nth-child(3){animation-delay:.15s}
.sop-phase:nth-child(4){animation-delay:.2s}
.sop-phase:nth-child(5){animation-delay:.25s}
.sop-phase:nth-child(6){animation-delay:.3s}
.sop-phase:nth-child(7){animation-delay:.35s}
.sop-phase:nth-child(8){animation-delay:.4s}
.sop-phase:nth-child(9){animation-delay:.45s}

/* Collapsed state */
.sop-phase.sop-collapsed .sop-steps{display:none}
.sop-phase.sop-collapsed .sop-checklist-block{display:none}

/* Phase icon badge */
.sop-phase-icon{width:44px;height:44px;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}

/* Step icon column */
.sop-step-icon{width:36px;height:36px;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;background:var(--bg3);border:1px solid var(--br);margin-bottom:8px}

/* Timing badge */
.sop-timing-badge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;padding:3px 8px;border-radius:0;background:var(--bg3);border:1px solid var(--br);color:var(--t3);white-space:nowrap;margin-top:4px}
.sop-timing-badge svg{flex-shrink:0}

/* Script copy button */
.sop-script-wrap{position:relative}
.sop-copy-btn{position:absolute;top:8px;right:8px;font-size:10px;font-weight:600;padding:4px 10px;border-radius:0;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.6);cursor:pointer;font-family:'Inter',sans-serif;transition:all .15s;letter-spacing:.02em}
.sop-copy-btn:hover{background:rgba(255,255,255,.22);color:#fff}
.sop-copy-btn.copied{background:rgba(16,185,129,.25);border-color:rgba(16,185,129,.4);color:#6EE7B7}

/* Progress bar inside checklist block */
.sop-progress-wrap{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.sop-progress-bar-bg{flex:1;height:4px;background:var(--br);border-radius:0;overflow:hidden}
.sop-progress-bar{height:4px;background:linear-gradient(to right,var(--green),#34D399);border-radius:0;transition:width .4s ease;width:0%}
.sop-progress-label{font-size:11px;font-weight:600;color:var(--green);min-width:32px;text-align:right}

/* Check item done state */
.sop-check-label.sop-done{background:var(--gl);border-color:var(--gb)}
.sop-check-label.sop-done input:checked+span{text-decoration:line-through;color:var(--t3)}

/* Objection accordion */
.sop-obj{border-radius:0;overflow:hidden;border:1px solid var(--br);transition:border-color .15s,box-shadow .15s}

.sop-obj-q{display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:pointer;user-select:none;padding:.75rem 1rem;background:var(--rl);border-bottom:1px solid var(--rb);font-size:13px;font-weight:600;color:#991B1B}
.sop-obj-q-text{display:flex;align-items:center;gap:8px}
.sop-obj-arrow{font-size:12px;color:#991B1B;transition:transform .2s;flex-shrink:0}
.sop-obj.sop-obj-open .sop-obj-arrow{transform:rotate(180deg)}
.sop-obj-a{display:none;background:var(--bg2);padding:.85rem 1rem;font-size:13px;color:var(--t1);line-height:1.7;border-top:none}
.sop-obj.sop-obj-open .sop-obj-a{display:block;animation:sopPhaseIn .2s ease}

/* Upsell path cards */
.sop-upsell-path{border-radius:0;overflow:hidden;border:1px solid var(--bb);background:var(--bg2);transition:box-shadow .15s}


/* Rule card hover */
.sop-rule-card{transition:all .2s}


/* Nav pill active state */
.sop-pill.sop-pill-active{background:var(--bl);border-color:var(--bb);color:var(--blue);font-weight:600}

/* Hero stat row */
.sop-stats-row{display:flex;gap:12px;flex-wrap:wrap;margin:1.5rem 0 2rem}
.sop-stat{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:.85rem 1.2rem;display:flex;align-items:center;gap:10px;box-shadow:var(--sh);flex:1;min-width:140px}
.sop-stat-icon{font-size:24px;flex-shrink:0}
.sop-stat-val{font-size:20px;font-weight:700;color:var(--navy);line-height:1}
.sop-stat-lbl{font-size:11px;color:var(--t3);margin-top:2px}

/* Phase color accents */
.sop-phase-header.green .sop-phase-icon{background:var(--gl);border:1px solid var(--gb)}
.sop-phase-header.blue .sop-phase-icon{background:var(--bl);border:1px solid var(--bb)}
.sop-phase-header.amber .sop-phase-icon{background:var(--al);border:1px solid var(--ab)}
.sop-phase-header.purple .sop-phase-icon{background:var(--pl);border:1px solid var(--pb)}
.sop-phase-header.red .sop-phase-icon{background:var(--rl);border:1px solid var(--rb)}

/* Step hover */
.sop-step{transition:background .15s}

.sop-step:hover .sop-step-num{color:var(--navy)}


