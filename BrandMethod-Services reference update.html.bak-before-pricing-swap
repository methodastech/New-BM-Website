    scroll-snap-align: start;
    border: 1px solid #E2E8F0;
    border-radius:0;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 20px rgba(15,23,42,.07);
    animation: none; opacity: 1;
    transition: filter .35s ease, opacity .35s ease, transform .35s cubic-bezier(.22,.61,.36,1);
    user-select: none; /* prevent text selection on tap */
    -webkit-user-select: none;
  }
  /* Cards behind: subtle scale + opacity only — no blur so content stays readable */
  .bj2-c.bj2-done {
    opacity: .6;
    transform: scale(.97);
  }
  .bj2-c.bj2-prev {
    opacity: .75;
