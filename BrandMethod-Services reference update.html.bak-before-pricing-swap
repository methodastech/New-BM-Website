.svc-panel:hover{z-index:3;filter:brightness(1.02)}
@media(prefers-reduced-motion: no-preference){
  .svc-panel:hover{transform:translateY(-3px)}
}
.svc-panel.slam:hover{box-shadow:0 18px 40px -16px rgba(5,150,105,.45),0 0 0 2px rgba(5,150,105,.32)}
.svc-panel.growth:hover{box-shadow:0 18px 40px -16px rgba(37,99,235,.45),0 0 0 2px rgba(37,99,235,.32)}
.svc-panel.premium:hover{box-shadow:0 18px 40px -16px rgba(15,23,42,.38),0 0 0 2px rgba(100,116,139,.38)}
.svc-panel:hover .view-full-btn{border-color:currentColor}



/* Premium tier shimmer on hover */
.svc-panel{position:relative;overflow:hidden}



/* Tier price subtle scale on card hover */


/* Sequence item hover */
.mrm-seq-item{transition:transform .3s cubic-bezier(.22,.61,.36,1), box-shadow .3s cubic-bezier(.22,.61,.36,1), border-left-color .3s}

.mrm-seq-num{transition:transform .3s cubic-bezier(.22,.61,.36,1)}


/* Stage card hover */
.mrm-stage{transition:transform .3s cubic-bezier(.22,.61,.36,1), box-shadow .3s cubic-bezier(.22,.61,.36,1)}


/* Kill card hover */
.mrm-kill{transition:transform .25s cubic-bezier(.22,.61,.36,1), box-shadow .25s, border-left-color .25s}


/* Principle card hover */
.mrm-prin{transition:transform .25s cubic-bezier(.22,.61,.36,1), box-shadow .25s}

