@keyframes sfE {
  0%   { transform: translate(0,0) rotate(-7deg) scale(1); }
  30%  { transform: translate(-12px,-16px) rotate(10deg) scale(1.08); }
  60%  { transform: translate(9px,-30px) rotate(-4deg) scale(.94); }
  100% { transform: translate(0,0) rotate(-7deg) scale(1); }
}
@keyframes sfF {
  0%   { transform: translate(0,0) rotate(3deg) scale(1); }
  45%  { transform: translate(-7px,-24px) rotate(-11deg) scale(1.11); }
  75%  { transform: translate(11px,-10px) rotate(6deg) scale(.96); }
  100% { transform: translate(0,0) rotate(3deg) scale(1); }
}
@keyframes sfG {
  0%   { transform: translate(0,0) rotate(-5deg) scale(1); }
  25%  { transform: translate(10px,-12px) rotate(12deg) scale(1.06); }
  55%  { transform: translate(-6px,-28px) rotate(-9deg) scale(.92); }
  85%  { transform: translate(3px,-16px) rotate(5deg) scale(1.03); }
  100% { transform: translate(0,0) rotate(-5deg) scale(1); }
}
@keyframes sfH {
  0%   { transform: translate(0,0) rotate(8deg) scale(1); }
  38%  { transform: translate(-14px,-20px) rotate(-6deg) scale(1.13); }
  68%  { transform: translate(6px,-32px) rotate(10deg) scale(.91); }
  100% { transform: translate(0,0) rotate(8deg) scale(1); }
}
/* Inner span handles the float rotation/scale so position and float compose independently */
.sop-float-icon .sop-icon-inner {
  display: inline-block;
  animation: var(--kf, sfA) var(--dur,8s) ease-in-out infinite var(--delay,0s);
}

/* ── TIMELINE NAV ── */
.sop-timeline-nav{
  display:flex;align-items:flex-start;gap:0;
  padding:0 1.5rem 0;margin-bottom:2.5rem;
  overflow-x:auto;scrollbar-width:none;
  -webkit-overflow-scrolling:touch;position:relative;
}
.sop-timeline-nav::-webkit-scrollbar{display:none}
.sop-timeline-nav::before{
  content:'';position:absolute;top:19px;left:1.5rem;right:1.5rem;
  height:2px;background:linear-gradient(to right,var(--bg4),var(--bg4));z-index:0;
}
.sop-tn-item{
  display:flex;flex-direction:column;align-items:center;gap:7px;
  flex:1;min-width:72px;cursor:pointer;position:relative;z-index:1;
  text-decoration:none;transition:opacity .2s;
}
.sop-tn-item:hover{opacity:.85}
.sop-tn-dot{
  width:38px;height:38px;border-radius:0;
  display:flex;align-items:center;justify-content:center;font-size:17px;
  background:#fff;border:2px solid var(--br);
  box-shadow:0 2px 6px rgba(0,0,0,.07);
  transition:all .25s ease;position:relative;z-index:1;
}
.sop-tn-item.active .sop-tn-dot{
  border-color:var(--blue);
  box-shadow:0 0 0 4px rgba(59,130,246,.12),0 4px 12px rgba(0,0,0,.1);
  transform:scale(1.12);
}
.sop-tn-label{font-size:10px;font-weight:600;letter-spacing:.03em;color:var(--t3);text-align:center;white-space:nowrap;transition:color .2s}
.sop-tn-item.active .sop-tn-label{color:var(--navy)}
/* per-phase dot colours */
.sop-tn-item[data-phase="lead"] .sop-tn-dot{background:linear-gradient(135deg,#D1FAE5,#A7F3D0);border-color:#6EE7B7}
.sop-tn-item[data-phase="close"] .sop-tn-dot{background:linear-gradient(135deg,#DBEAFE,#BFDBFE);border-color:#93C5FD}
.sop-tn-item[data-phase="onboard"] .sop-tn-dot{background:linear-gradient(135deg,#FEF9C3,#FDE68A);border-color:#FCD34D}
.sop-tn-item[data-phase="deliver"] .sop-tn-dot{background:linear-gradient(135deg,#EDE9FE,#DDD6FE);border-color:#C4B5FD}
.sop-tn-item[data-phase="signoff"] .sop-tn-dot{background:linear-gradient(135deg,#CCFBF1,#99F6E4);border-color:#5EEAD4}
.sop-tn-item[data-phase="upsell"] .sop-tn-dot{background:linear-gradient(135deg,#DBEAFE,#93C5FD);border-color:#60A5FA}
.sop-tn-item[data-phase="retainer"] .sop-tn-dot{background:linear-gradient(135deg,#F3E8FF,#E9D5FF);border-color:#D8B4FE}
.sop-tn-item[data-phase="portfolio"] .sop-tn-dot{background:linear-gradient(135deg,#FEF9C3,#FDE68A);border-color:#FCD34D}
.sop-tn-item[data-phase="rules"] .sop-tn-dot{background:linear-gradient(135deg,#FEE2E2,#FECACA);border-color:#FCA5A5}

/* ── PHASE CARD ── */
.sop4-phase{
  margin:0 0 16px;border-radius:0;overflow:hidden;
  border:1.5px solid var(--br);background:var(--bg2);
  box-shadow:0 1px 4px rgba(0,0,0,.05);
  transition:box-shadow .3s,border-color .3s,transform .35s,opacity .45s ease;
  opacity:1;transform:translateY(0);
}
/* Entrance animation: JS adds will-animate first, then visible to trigger */
.sop4-phase.will-animate{opacity:0;transform:translateY(14px)}
.sop4-phase.visible{opacity:1 !important;transform:translateY(0) !important}


/* Phase header */
.sop4-head{
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:1.3rem 1.6rem;cursor:pointer;user-select:none;
  border-bottom:1.5px solid var(--br);
  position:relative;overflow:hidden;transition:background .18s;
}
/* left accent bar */
.sop4-head::before{
  content:'';position:absolute;top:0;left:0;bottom:0;width:4px;border-radius:0;
}
.sop4-head.green{background:linear-gradient(135deg,rgba(16,185,129,.05),transparent 70%)}
.sop4-head.green::before{background:linear-gradient(to bottom,#10B981,#34D399)}
.sop4-head.blue{background:linear-gradient(135deg,rgba(59,130,246,.05),transparent 70%)}
.sop4-head.blue::before{background:linear-gradient(to bottom,#3B82F6,#60A5FA)}
.sop4-head.amber{background:linear-gradient(135deg,rgba(245,158,11,.05),transparent 70%)}
.sop4-head.amber::before{background:linear-gradient(to bottom,#F59E0B,#FBBF24)}
.sop4-head.purple{background:linear-gradient(135deg,rgba(139,92,246,.05),transparent 70%)}
.sop4-head.purple::before{background:linear-gradient(to bottom,#8B5CF6,#A78BFA)}
.sop4-head.teal{background:linear-gradient(135deg,rgba(20,184,166,.05),transparent 70%)}
.sop4-head.teal::before{background:linear-gradient(to bottom,#14B8A6,#5EEAD4)}
.sop4-head.red{background:linear-gradient(135deg,rgba(239,68,68,.05),transparent 70%)}
.sop4-head.red::before{background:linear-gradient(to bottom,#EF4444,#F87171)}

.sop4-head-left{display:flex;align-items:center;gap:14px;flex:1;padding-left:12px;min-width:0}

/* Phase bubble icon */
.sop4-phase-bubble{
  width:48px;height:48px;border-radius:0;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:24px;
  position:relative;overflow:hidden;
}
.sop4-phase-bubble::after{content:'';position:absolute;inset:0;border-radius:0;background:linear-gradient(135deg,rgba(255,255,255,.35),transparent)}
.sop4-head.green .sop4-phase-bubble{background:linear-gradient(135deg,#D1FAE5,#6EE7B7)}
.sop4-head.blue .sop4-phase-bubble{background:linear-gradient(135deg,#DBEAFE,#93C5FD)}
.sop4-head.amber .sop4-phase-bubble{background:linear-gradient(135deg,#FEF9C3,#FCD34D)}
.sop4-head.purple .sop4-phase-bubble{background:linear-gradient(135deg,#EDE9FE,#C4B5FD)}
.sop4-head.teal .sop4-phase-bubble{background:linear-gradient(135deg,#CCFBF1,#5EEAD4)}
.sop4-head.red .sop4-phase-bubble{background:linear-gradient(135deg,#FEE2E2,#FCA5A5)}

.sop4-phase-info{min-width:0;flex:1}
.sop4-phase-eyebrow{font-size:10px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--t3);margin-bottom:2px}
.sop4-phase-title{font-size:16px;font-weight:700;color:var(--navy);letter-spacing:-.02em;line-height:1.2}
.sop4-phase-sub{font-size:12px;color:var(--t2);margin-top:3px;line-height:1.5;max-width:480px}
.sop4-phase-meta{display:flex;align-items:center;gap:8px;flex-shrink:0}
.sop4-step-count{font-size:10px;font-weight:600;padding:3px 11px;border-radius:0;background:var(--bg3);border:1px solid var(--br);color:var(--t3);white-space:nowrap}
.sop4-toggle{width:30px;height:30px;border-radius:0;background:var(--bg3);border:1px solid var(--br);display:flex;align-items:center;justify-content:center;color:var(--t3);transition:all .2s;flex-shrink:0}
.sop4-toggle svg{transition:transform .3s ease}
.sop4-phase.collapsed .sop4-toggle svg{transform:rotate(-90deg)}
.sop4-toggle:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.sop4-phase.collapsed .sop4-body{display:none}
.sop4-body{background:var(--bg2)}

/* ── STEP ROW ── */
.sop4-step{
  display:grid;grid-template-columns:176px 1fr;
  border-top:1px solid var(--br);
  transition:background .14s;
}


/* Step sidebar */
.sop4-step-side{
  padding:1.6rem 1.2rem 1.6rem 1.6rem;
  border-right:1px solid var(--br);
  background:var(--bg3);
  display:flex;flex-direction:column;gap:10px;
  position:relative;
}
/* colour accent pip on sidebar matching phase */
.sop4-step-side::before{
  content:'';position:absolute;top:0;left:0;bottom:0;width:3px;
  background:var(--br);transition:background .2s;
}
/* Attach colour via data or parent phase colour — use JS-assigned class */
.sop4-phase[data-color="green"] .sop4-step-side::before{background:linear-gradient(to bottom,#10B981,#34D399)}
.sop4-phase[data-color="blue"] .sop4-step-side::before{background:linear-gradient(to bottom,#3B82F6,#60A5FA)}
.sop4-phase[data-color="amber"] .sop4-step-side::before{background:linear-gradient(to bottom,#F59E0B,#FBBF24)}
.sop4-phase[data-color="purple"] .sop4-step-side::before{background:linear-gradient(to bottom,#8B5CF6,#A78BFA)}
.sop4-phase[data-color="teal"] .sop4-step-side::before{background:linear-gradient(to bottom,#14B8A6,#5EEAD4)}
.sop4-phase[data-color="red"] .sop4-step-side::before{background:linear-gradient(to bottom,#EF4444,#F87171)}

.sop4-step-icon-wrap{
  width:36px;height:36px;border-radius:0;
  display:flex;align-items:center;justify-content:center;
  font-size:19px;background:var(--bg2);border:1.5px solid var(--br);
  transition:transform .22s,box-shadow .22s;flex-shrink:0;
}

.sop4-step-num{
  font-size:34px;font-weight:700;color:var(--navy);line-height:1;
  letter-spacing:-.04em;opacity:.18;
}
.sop4-step:hover .sop4-step-num{opacity:1}
.sop4-timing{
  display:inline-flex;align-items:center;gap:5px;
  font-size:10px;font-weight:600;letter-spacing:.03em;
  color:var(--t2);background:var(--bg2);border:1px solid var(--br);
  border-radius:0;padding:3px 9px;width:fit-content;
}
.sop4-timing svg{opacity:.5;flex-shrink:0}

/* Step content */
.sop4-step-content{padding:1.6rem 1.8rem}
.sop4-step-title{font-size:15px;font-weight:700;color:var(--navy);margin-bottom:6px;letter-spacing:-.02em;line-height:1.3}
.sop4-step-desc{font-size:13px;color:var(--t2);line-height:1.75;margin-bottom:1rem;font-weight:400}

/* ── SCRIPT TERMINAL BLOCK ── */
.sop4-script{
  background:#0D1117;border-radius:0;overflow:hidden;
  margin-bottom:12px;
  border:1px solid rgba(255,255,255,.07);
  box-shadow:0 4px 20px rgba(0,0,0,.15),inset 0 1px 0 rgba(255,255,255,.05);
  transition:box-shadow .2s;
}

.sop4-script-bar{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:.55rem 1rem;
  background:rgba(255,255,255,.04);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.sop4-script-dots{display:flex;gap:5px;align-items:center;flex-shrink:0}
.sop4-script-dot{width:10px;height:10px;border-radius:0}
.sop4-script-dot.red{background:#FF5F57}
.sop4-script-dot.amber{background:#FEBC2E}
.sop4-script-dot.green{background:#28C840}
.sop4-script-label{
  font-size:10px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;
  color:rgba(255,255,255,.45);flex:1;
}
.sop4-copy-btn{
  display:inline-flex;align-items:center;gap:5px;
  font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;
  padding:4px 12px;border-radius:0!important;
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);
  color:rgba(255,255,255,.45);cursor:pointer;
  font-family:'Inter',sans-serif;
  transition:all .15s;flex-shrink:0;
}
.sop4-copy-btn::before{content:"📋 "}
.sop4-copy-btn:hover{background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.45)}
.sop4-copy-btn.copied{background:rgba(16,185,129,.18);border-color:rgba(16,185,129,.38);color:#34D399}
.sop4-copy-btn.copied::before{content:"✓ "}
.sop4-script-body{
  padding:1rem 1.2rem 1.1rem;
  font-size:13px;color:rgba(255,255,255,.82);line-height:1.9;
  white-space:pre-line;font-weight:400;letter-spacing:.008em;
}

/* ── ALERT RULES ── */
.sop4-alert{
  display:flex;align-items:flex-start;gap:10px;
  font-size:13px;padding:.8rem 1rem;border-radius:0;
  margin-top:10px;line-height:1.7;font-weight:500;
}
.sop4-alert.green{background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0}
.sop4-alert.amber{background:#FFFBEB;color:#78350F;border:1px solid #FDE68A}
.sop4-alert.red{background:#FEF2F2;color:#991B1B;border:1px solid #FECACA}
.sop4-alert.blue{background:#EFF6FF;color:#1D4ED8;border:1px solid #BFDBFE}
.sop4-alert-icon{font-size:15px;flex-shrink:0;margin-top:1px}

/* ── CHECKLIST ── */
.sop4-checklist{display:flex;flex-direction:column;gap:6px;margin:10px 0}
.sop4-ci{display:flex;align-items:flex-start;gap:9px;font-size:13px;color:var(--t2);line-height:1.6}
.sop4-ci-badge{width:20px;height:20px;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;margin-top:1px}
.sop4-ci.green .sop4-ci-badge{background:#D1FAE5;color:#065F46}
.sop4-ci.amber .sop4-ci-badge{background:#FEF9C3;color:#92400E}
.sop4-ci.red .sop4-ci-badge{background:#FEE2E2;color:#991B1B}
.sop4-ci.blue .sop4-ci-badge{background:#DBEAFE;color:#1E40AF}

/* ── OBJECTION ACCORDION ── */
.sop4-objections{display:flex;flex-direction:column;gap:8px}
.sop4-obj{border-radius:0;overflow:hidden;border:1.5px solid var(--br);transition:all .2s}

.sop4-obj-q{
  display:flex;align-items:center;justify-content:space-between;gap:8px;
  padding:.8rem 1rem;background:linear-gradient(to right,#FEF2F2,#fff7f7);
  font-size:13px;font-weight:600;color:#991B1B;cursor:pointer;user-select:none;transition:background .14s;
}
.sop4-obj-q:hover{background:linear-gradient(to right,#FEE2E2,#FEF2F2)}
.sop4-obj-q-inner{display:flex;align-items:center;gap:8px}
.sop4-obj-icon{width:22px;height:22px;border-radius:0;background:#FEE2E2;border:1px solid #FECACA;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#DC2626;flex-shrink:0}
.sop4-obj-arr{font-size:10px;transition:transform .22s;color:#DC2626;flex-shrink:0}
.sop4-obj.open .sop4-obj-arr{transform:rotate(180deg)}
.sop4-obj-a{display:none;padding:.85rem 1rem;font-size:13px;color:var(--t1);line-height:1.75;background:var(--bg2);border-top:1px solid #FEE2E2}
.sop4-obj.open .sop4-obj-a{display:block;animation:sop4FadeIn .2s ease}
@keyframes sop4FadeIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}

/* ── UPSELL PATHS ── */
.sop4-upsell-path{border-radius:0;overflow:hidden;border:1.5px solid #BFDBFE;background:var(--bg2);transition:all .2s;margin-bottom:10px}

.sop4-upsell-from{background:linear-gradient(to right,#EFF6FF,#F0F9FF);border-bottom:1px solid #BFDBFE;padding:.6rem 1rem;font-size:11px;font-weight:600;color:#1D4ED8;display:flex;align-items:center;gap:6px}
.sop4-upsell-arrow{width:20px;height:20px;border-radius:0;background:#DBEAFE;border:1px solid #93C5FD;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}

/* ── REPORT STRUCTURE ── */
.sop4-report-list{display:flex;flex-direction:column;gap:7px;margin:12px 0}
.sop4-report-item{display:flex;align-items:flex-start;gap:12px;padding:.75rem 1rem;border-radius:0;background:var(--bg3);border:1px solid var(--br);font-size:13px;color:var(--t1);line-height:1.55;transition:all .15s}

.sop4-report-n{font-size:11px;font-weight:700;color:var(--t4);min-width:22px;flex-shrink:0;padding-top:1px}

/* ── INTERACTIVE CHECKLIST BLOCK ── */
.sop4-checklist-block{background:linear-gradient(135deg,#F8FAFF,#F1F5FF);border-top:1px solid var(--br);padding:1.6rem 1.8rem}
.sop4-checklist-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
.sop4-checklist-title{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--t3);display:flex;align-items:center;gap:8px}
.sop4-checklist-title::before{content:'';width:18px;height:2px;background:linear-gradient(to right,#10B981,#34D399);border-radius:0}
.sop4-progress-row{display:flex;align-items:center;gap:8px}
.sop4-prog-bar-bg{width:90px;height:4px;background:var(--br);border-radius:0;overflow:hidden}
.sop4-prog-bar{height:4px;background:linear-gradient(to right,#10B981,#34D399);border-radius:0;transition:width .4s cubic-bezier(.34,1.56,.64,1);width:0%}
.sop4-prog-label{font-size:11px;font-weight:700;color:var(--green);min-width:28px}
.sop4-check-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.sop4-check-item{display:flex;align-items:flex-start;gap:9px;font-size:13px;color:var(--t2);cursor:pointer;padding:8px 11px;border-radius:0;border:1.5px solid var(--br);background:var(--bg2);transition:all .16s}
.sop4-check-item:hover{border-color:#93C5FD;background:#EFF6FF}
.sop4-check-item.done{background:#ECFDF5;border-color:#6EE7B7}
.sop4-check-item.done span{text-decoration:line-through;color:var(--t3)}
.sop4-check-item input[type=checkbox]{margin-top:2px;flex-shrink:0;accent-color:#10B981;width:14px;height:14px;cursor:pointer}

/* ── STANDING RULES ── */
.sop4-rules-area{background:var(--bg2);border-top:1px solid var(--br);padding:1.8rem}
.sop4-rules-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.sop4-rule-card{
  background:var(--bg3);border:1px solid var(--br);border-radius:0;
  padding:1.2rem 1.1rem;cursor:default;position:relative;overflow:hidden;
}
.sop4-rule-card::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(to right,var(--blue),var(--teal));
  transform:scaleX(0);transform-origin:left;transition:transform .3s ease;
}


.sop4-rule-icon-wrap{width:42px;height:42px;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:21px;margin-bottom:11px;border:1px solid var(--br);background:var(--bg3);transition:transform .24s}

.sop4-rule-title{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:5px}
.sop4-rule-body{font-size:11.5px;color:var(--t2);line-height:1.7}

/* ── CONNECTOR ── */
.sop4-connector{height:20px;width:2px;margin:0 auto;background:linear-gradient(to bottom,var(--br),transparent)}

/* ── PHASE WRAPPER PADDING ── */
#p6-phases{padding:0 0 4rem;max-width:1080px;margin:0 auto}

/* ── RESPONSIVE ── */
@media(max-width:900px){.sop4-rules-grid{grid-template-columns:repeat(2,1fr)}.sop4-check-grid{grid-template-columns:1fr}}
@media(max-width:700px){
  .sop4-step{grid-template-columns:1fr}
  .sop4-step-side{border-right:none;border-bottom:1px solid var(--br);flex-direction:row;align-items:center;padding:1rem 1.2rem;gap:10px}
  .sop4-step-side::before{display:none}
  .sop4-step-num{font-size:22px;margin-bottom:0}
  .sop4-phase-title{font-size:15px}
  .sop4-head{padding:1rem 1.2rem}
  .sop4-rules-grid{grid-template-columns:1fr 1fr;gap:10px}
  .sop4-checklist-block,.sop4-step-content{padding:1.2rem}
  .sop-hero{padding:2.2rem 1.2rem 1.8rem;border-radius:0}
  .sop-timeline-nav{padding:0 1rem}
  .sop-timeline-nav::before{left:1rem;right:1rem}
  .sop4-rules-area{padding:1.2rem}
  #p6-phases{padding:0 0 3rem}
}
