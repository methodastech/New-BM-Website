}
.bj2-c.bj2-active .bj2-c-title { color: var(--cc); opacity: 1; }
.bj2-c-time { font-size: 9px; font-weight:600; color: #94A3B8; text-transform: uppercase; letter-spacing: .12em; margin-bottom: .65rem; }
.bj2-c-addon-note { font-size: 9px; color: #94A3B8; font-style: italic; margin-top: 5px; }
.bj2-c-tags { display: flex; flex-wrap: wrap; gap: 4px; }
