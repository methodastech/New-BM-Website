</style>

<style id="bm-round-font-fix">
/* USER FIX: round icon containers (not square), overriding the global sharp-edges rule */
.svc-header .mos-chip, .svc-header .svc-icon{ border-radius:16px !important; }
.svc-block.mos .mos-head .mos-chip{ border-radius:22px !important; }
#bmpd-panel .fd-trig-ic, #bmpd-panel .fd-sol-ic, #bmpd-panel .fd-result-ic{ border-radius:12px !important; }
#bmpd-panel .bj2-step-dot, #bmpd-panel .bj2-step-ic, #bmpd-panel .bj2-node-ic, #bmpd-panel [class*="bj2"][class*="-ic"]{ border-radius:15px !important; }
/* USER FIX: bump the too-small text in the process / trigger panel */
#bmpd-panel .bj2-why-desc, #bmpd-panel .bj2-step-desc, #bmpd-panel .fd-prob-sub, #bmpd-panel .fd-trig-sub{ font-size:12.5px !important; line-height:1.5 !important; }
#bmpd-panel .bj2-why-num, #bmpd-panel .bj2-c-tag, #bmpd-panel .bj2-grp-title, #bmpd-panel .fd-trig-label, #bmpd-panel .fd-result-top{ font-size:11.5px !important; letter-spacing:.04em !important; }
#bmpd-panel .bj2-why-badge{ font-size:11px !important; }

/* USER: graceful-layered header icons (top 3 sections) — ref .svc-acc-ico / .emb */
.svc-header.svcc.gfx-head .svc-icon, .gfx-head .mos-chip{
  position:relative !important; width:60px !important; height:60px !important; display:grid !important; place-items:center !important;
  border-radius:17px !important; overflow:visible !important;
  background:color-mix(in srgb, var(--sa) 10%, #fff) !important;
  border:1px solid color-mix(in srgb, var(--sa) 26%, transparent) !important;
}
.svc-header.svcc.gfx-head .svc-icon::before, .gfx-head .mos-chip::before{
  content:'' !important; position:absolute; inset:0; border-radius:17px; overflow:hidden;
  background-image:linear-gradient(color-mix(in srgb,var(--sa) 14%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--sa) 14%,transparent) 1px,transparent 1px);
  background-size:11px 11px; opacity:.6; z-index:0;
}
/* offset depth layer behind the chip = the "graceful layer" */
.svc-header.svcc.gfx-head .svc-icon::after, .gfx-head .mos-chip::after{
  content:'' !important; position:absolute; inset:0; border-radius:17px; z-index:-1;
  transform:translate(7px,7px); background:color-mix(in srgb,var(--sa) 12%,#fff); border:1px solid color-mix(in srgb,var(--sa) 20%,transparent);
}
/* icon floats with a coloured glow + gentle sway */
.svc-header.svcc.gfx-head .svc-icon svg, .gfx-head .mos-chip svg{
  position:relative !important; z-index:2 !important; width:33px !important; height:33px !important;
  filter:drop-shadow(0 5px 10px color-mix(in srgb,var(--sa) 46%,transparent)) !important;
  animation:gfxSway 5.6s ease-in-out infinite !important;
}
/* Brand solid banner variant: translucent-white chip + white glow (icon is white on blue) */
.gfx-head.mos-head .mos-chip{ background:transparent !important; border:none !important; width:auto !important; height:auto !important; }
.gfx-head.mos-head .mos-chip::before{ display:none !important; }
.gfx-head.mos-head .mos-chip::after{ display:none !important; }
.gfx-head.mos-head .mos-chip svg{ width:58px !important; height:58px !important; filter:drop-shadow(0 6px 15px rgba(255,255,255,.5)); }
@keyframes gfxSway{ 0%,100%{ transform:translateY(0) rotate(-1.4deg); } 50%{ transform:translateY(-3px) rotate(1.6deg); } }
@media(prefers-reduced-motion:reduce){ .svc-header.svcc.gfx-head .svc-icon svg, .gfx-head .mos-chip svg{ animation:none; } }
</style>

<style id="bmph-phv-css">
