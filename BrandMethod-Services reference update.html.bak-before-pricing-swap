/* P1 Hero */
.p1-hero {
  padding: 3.5rem 2rem 2.8rem;
  margin: 0 0 2.6rem;
  background: linear-gradient(-45deg, #020810, #050E1C, #070F1F, #030A14, #050E1C);
  background-size: 400% 400%;
  animation: p1GradLoop 14s ease infinite;
  position: relative; overflow: hidden;
}
/* flowing dot grid */
.p1-hero::before {
  content:'';
  position:absolute; inset:0;
  background-image: radial-gradient(circle, rgba(37,99,235,.09) 1px, transparent 1px);
  background-size: 32px 32px;
  animation: bmGridDrift 8s linear infinite;
  pointer-events:none;
}
/* diagonal light sweep */
.p1-hero::after {
  content:'';
  position:absolute; inset:0;
  background: linear-gradient(105deg, transparent 25%, rgba(99,102,241,.10) 45%, rgba(37,99,235,.07) 52%, transparent 65%);
  animation: bmLineScan 5s ease-in-out infinite;
  pointer-events:none;
}
.p1-orb {
  position: absolute; border-radius:0; filter: blur(80px);
  pointer-events: none;
}
.p1-orb-1 {
  width: 580px; height: 580px;
  background: radial-gradient(circle, rgba(37,99,235,.38) 0%, transparent 60%);
  top: -180px; left: -140px;
  animation: p1Orb1 9s ease-in-out infinite alternate;
}
.p1-orb-2 {
  width: 460px; height: 460px;
  background: radial-gradient(circle, rgba(99,102,241,.28) 0%, transparent 60%);
  top: -100px; right: -80px;
  animation: p1Orb1 12s ease-in-out infinite alternate-reverse;
}
.p1-orb-3 {
  width: 380px; height: 380px;
  background: radial-gradient(circle, rgba(52,211,153,.16) 0%, transparent 60%);
  bottom: -80px; left: 42%;
  animation: p1Orb1 8s ease-in-out infinite alternate;
  animation-delay: -3s;
}
@keyframes p1Orb1 {
  0%  { transform: translate(0,0) scale(.9); opacity:.65; }
  40% { transform: translate(28px,-30px) scale(1.15); opacity:1; }
  70% { transform: translate(-16px,20px) scale(.95); opacity:.8; }
  100%{ transform: translate(10px,-12px) scale(1.05); opacity:.75; }
}
.p1-hero-inner { position:relative; z-index:2; }
.p1-hero-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight:600; letter-spacing: .18em;
  text-transform: uppercase; color: rgba(251,191,36,.9);
  background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.25);
  padding: 5px 14px; border-radius:0; margin-bottom: 1.2rem;
}
.p1-hero-badge::before {
  content:''; width:6px; height:6px; border-radius:0;
  background:#FCD34D; flex-shrink:0;
  animation: bmBlink 2s ease-in-out infinite;
}
.p1-hero-h {
  font-size: clamp(26px, 3.5vw, 44px); font-weight:700; letter-spacing: -.04em;
  color: #fff; margin-bottom: .8rem; line-height: 1.05;
  animation: bmTextReveal .7s cubic-bezier(.22,.61,.36,1) both;
}
.p1-hero-accent {
  background: linear-gradient(135deg,#60A5FA,#818CF8);
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
}
.p1-hero-sub {
  font-size: 14px; color: rgba(148,163,184,.8); max-width: 580px; line-height: 1.75;
  animation: bmTextReveal .7s .15s cubic-bezier(.22,.61,.36,1) both;
}
/* stat pills row */
.p1-hero-stats {
  display:flex; gap:1.5rem; margin-top:1.8rem; flex-wrap:wrap;
  animation: bmTextReveal .7s .3s cubic-bezier(.22,.61,.36,1) both;
}
.p1-hero-stat {
  display:flex; flex-direction:column; gap:3px;
}
.p1-hero-stat-num {
  font-size:22px; font-weight:700; color:#fff;
