  /* Track sits behind dots, positioned inside the dots row */
  .bj2-mprog-dots-wrap {
    position: relative;
  }
  .bj2-mprog-track {
    position: absolute;
    left: 16px; right: 16px; top: 50%;
    transform: translateY(-50%);
    height: 3px; border-radius:0;
    background: #E2E8F0;
    z-index: 0;
  }
  .bj2-mprog-fill {
    position: absolute; left: 0; top: 0; height: 100%;
    width: 0%;
    border-radius:0;
    background: linear-gradient(90deg, #3B82F6, var(--mpf, #3B82F6));
    box-shadow: 0 0 8px color-mix(in srgb, var(--mpf,#3B82F6) 55%, transparent);
    transition: width .45s cubic-bezier(.22,.61,.36,1), background .45s ease;
  }
  .bj2-mprog-dots {
    position: relative; z-index: 1;
    display: flex; justify-content: space-between; align-items: center;
  }
  .bj2-mprog-dot {
    width: 32px; height: 32px; border-radius:0;
    border: 2px solid #CBD5E1; background: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: inherit; cursor: pointer; padding: 0;
    transition: all .35s cubic-bezier(.22,.61,.36,1);
    flex-shrink: 0;
  }
  .bj2-mprog-dot span {
    font-size: 12px; font-weight:700; color: #94A3B8;
    transition: color .35s ease;
  }
  .bj2-mprog-dot.done {
    background: var(--dc); border-color: var(--dc);
  }
  .bj2-mprog-dot.done span { color: #fff; }
  .bj2-mprog-dot.active {
    background: var(--dc); border-color: var(--dc);
    transform: scale(1.18);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--dc) 22%, transparent),
                0 4px 12px color-mix(in srgb, var(--dc) 40%, transparent);
  }
  .bj2-mprog-dot.active span { color: #fff; }
}
@media (max-width: 1080px) {
  #p7 .bj2-wrap { padding: 0 1rem 5rem; }
  .bj2-hero { margin: 0 -1rem 1.5rem; padding: 2.5rem 1rem 2rem; border-radius:0; }
  .bj2-hero-phases { display:none; }
  .bj2-hero-stats { gap:1.5rem; margin-top:1.5rem; }
  .bj2-hero-phases { display:none; }
  .bj2-hero-stats { gap:1.5rem; }
  .bj2-why-toggle { padding: 1rem 1.1rem; }
  .bj2-why-sub { display: none; }

  /* Horizontal scroll-snap board on mobile */
  .bj2-mobile-hint {
    display: flex; align-items: center; justify-content: space-between;
    margin: 0 0 .75rem; padding: 0 0 0 2px;
  }
  .bj2-mobile-hint-text {
    font-size: 11px; color: #94A3B8; font-weight: 600;
    display: flex; align-items: center; gap: 5px;
  }
  .bj2-mob-arrow-btn {
    display: flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight:600; color: var(--blue);
    background: var(--bl); border: 1px solid var(--bb);
    border-radius:0; padding: 5px 12px; cursor: pointer;
    transition: background .15s, transform .15s;
    font-family: inherit;
  }
  .bj2-mob-arrow-btn:active { transform: scale(.96); background: #DBEAFE; }
  .bj2-mob-arrow-btn svg { flex-shrink: 0; }
  .bj2-board { border-radius:0; overflow: visible; box-shadow: none; border: none; background: transparent; position: relative;
    margin-left: -1rem; margin-right: -1rem; }
  .bj2-cols {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 10px;
    padding: 0 1rem 8px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* Right-only fade — signals more content, doesn't wash out active card */
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
