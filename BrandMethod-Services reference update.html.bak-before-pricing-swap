@keyframes bjBubbleFloat { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(-4px)} }
/* spinning star — centred ON the colour line, spins on its own axis */
.bj2-traveller-star {
  position: absolute;
  left: 0; top: 0;
  width: 34px; height: 34px;
  /* box centred exactly on the anchor point (the rail line) */
  margin-left: -17px; margin-top: -17px;
