/* ── COLUMNS BOARD ── */


.bj2-board {
  background: #fff;
  border: 1px solid #E2E8F0;
  border-radius:0;
  border-top: none;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 12px 40px rgba(15,23,42,.06);
}
.bj2-cols {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  grid-template-rows: auto 1fr;
}
.bj2-c {
  border-right: 1px solid #EEF1F7;
  display: grid;
  grid-template-rows: subgrid;
  grid-row: span 2;
  min-width: 0;
}
.bj2-c:last-child { border-right: none; }

/* ── Column header: color bar ON top border, no wasted space ── */
.bj2-c-head {
  padding: 2.2rem 1.1rem 1rem;
  background: color-mix(in srgb, var(--cc) 6%, #F3F5FA);
  border-bottom: 1px solid #F1F5F9;
  position: relative; z-index: 5;
  transition: background .3s ease;
}

/* Progress fill — the bar that fills across columns as you click */
.bj2-c-head::before {
  content: '';
  position: absolute;
  top: -4px; left: 0; right: 0;
  height: 4px;
  background: var(--cc);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .5s cubic-bezier(.22,.61,.36,1);
  z-index: 6;
}

/* Active column: light tint, lift feel */
.bj2-c.bj2-active {
  background: color-mix(in srgb, var(--cc) 6%, #fff);
  box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--cc) 32%, transparent);
}
.bj2-c.bj2-active .bj2-c-head {
  background: linear-gradient(180deg, color-mix(in srgb, var(--cc) 16%, #fff) 0%, color-mix(in srgb, var(--cc) 8%, #fff) 100%);
}
/* subtle top glow line on active */
.bj2-c.bj2-active::before {
  content:'';
  position:absolute; top:0; left:0; right:0; height:3px;
  background: linear-gradient(90deg, transparent, var(--cc), transparent);
  opacity:.6;
  z-index:4;
  pointer-events:none;
}
/* All columns UP TO AND INCLUDING active get progress fill */
.bj2-c.bj2-done .bj2-c-head::before,
.bj2-c.bj2-active .bj2-c-head::before {
  transform: scaleX(1);
}
/* done columns: number stays as visible as other non-selected ones */
.bj2-c.bj2-done .bj2-c-num {
  opacity: .96;
}
.bj2-c.bj2-done .bj2-c-title {
  opacity: .6;
}

/* Star removed from phase head — now lives below the traveller bubble */
.bj2-c-star { display: none; }

/* Whole-column alive pulse when newly activated */
@keyframes bjColAlive {
  0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--cc) 35%, transparent); }
  60%  { box-shadow: 0 0 0 8px color-mix(in srgb, var(--cc) 0%, transparent); }
  100% { box-shadow: none; }
}
.bj2-c.bj2-pulse { animation: bjColAlive .55s ease-out forwards; }

/* Number: huge, thin, zero padding above */
.bj2-c-num-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: .85rem;
}
.bj2-c-num-right {
  display: flex; flex-direction: column; align-items: flex-end; gap: 6px;
  padding-top: 2px;
}
.bj2-c-num {
  font-size: 130px; font-weight: 300; line-height: .78;
  letter-spacing: -.07em;
  font-family: 'Fraunces', sans-serif;
  color: color-mix(in srgb, var(--cc) 80%, #94A3B8);
  opacity: .96;
  transition: color .35s, opacity .35s, transform .3s cubic-bezier(.34,1.56,.64,1);
  margin-left: -4px;
  user-select: none;
}
.bj2-c.bj2-active .bj2-c-num {
  color: var(--cc);
  opacity: 1;
  transform: scale(1.03) translateY(-1px);
}
.bj2-c:hover:not(.bj2-active) .bj2-c-num { transform: translateY(-2px); }
/* hover: float the whole column up slightly + shine sweep */
.bj2-c:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 32px rgba(15,23,42,.09);
  z-index: 2;
  transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease;
}
.bj2-c:hover::before {
  content:'';
  position:absolute; inset:0; z-index:10; pointer-events:none;
  background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.45) 50%, transparent 70%);
  background-size: 200% 100%;
  animation: bjCardShine .6s ease-out forwards;
  border-radius:0;
}
@keyframes bjCardShine {
  0%  { background-position: -100% 0; opacity:0; }
  20% { opacity:1; }
  100%{ background-position: 150% 0; opacity:0; }
}

/* Icon: raw emoji, no box */
.bj2-c-icon {
  font-size: 20px; flex-shrink: 0;
  line-height: 1;
  transition: transform .3s cubic-bezier(.34,1.56,.64,1);
  filter: grayscale(.2);
}
.bj2-c.bj2-active .bj2-c-icon { filter: grayscale(0); transform: scale(1.15); }
.bj2-c:hover .bj2-c-icon { transform: scale(1.1) rotate(-5deg); filter: grayscale(0); }

.bj2-c-title {
