/* Column body */
.bj2-c-body { padding: 1rem 1.1rem 1.5rem; flex: 1; }
.bj2-grp { margin-bottom: 1.1rem; }
.bj2-grp:last-child { margin-bottom: 0; }
.bj2-grp-title {
  font-size: 8px; font-weight:700; letter-spacing: .14em; text-transform: uppercase;
  color: var(--cc,#0F172A);
  margin-bottom: .55rem; padding-bottom: .4rem;
  border-bottom: 1px solid color-mix(in srgb, var(--cc) 14%, transparent);
