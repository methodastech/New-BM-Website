/* ═══ FLOW DIAGRAM ═══ */
/* ── CLIENT JOURNEY TRACK ── */
.cj-wrap{background:var(--navy);border-radius:0;padding:1.6rem 2rem 0;position:relative;overflow:visible;margin-bottom:0}
.cj-wrap::before{content:'';position:absolute;top:-60px;left:-60px;width:280px;height:280px;background:radial-gradient(circle,rgba(37,99,235,.18),transparent 70%);pointer-events:none;border-radius:0}
.cj-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:1.6rem;position:relative;z-index:1}
.cj-title{font-size:17px;font-weight:700;color:#fff;letter-spacing:-.02em}
.cj-sub{font-size:11px;color:rgba(255,255,255,.4);margin-top:3px}
.cj-step-badge{font-size:11px;font-weight:600;color:rgba(255,255,255,.5);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);padding:5px 14px;border-radius:0;white-space:nowrap}
.cj-step-badge span{color:#fff;font-weight:700}

/* The track container */
.cj-track-wrap{position:relative;height:48px;margin-bottom:0;z-index:1}
.cj-road{position:absolute;top:21px;left:0;right:0;height:6px;background:rgba(255,255,255,.08);border-radius:0}
.cj-fill{position:absolute;top:21px;left:0;height:6px;width:0%;border-radius:0;background:linear-gradient(90deg,#2563EB,#60A5FA);box-shadow:0 0 16px rgba(96,165,250,.8),0 0 4px rgba(96,165,250,1);transition:width .8s cubic-bezier(.22,.61,.36,1),background .4s,box-shadow .4s;z-index:1}

/* Step nodes on the track — 7 steps, evenly spaced: 0,16.6,33.3,50,66.6,83.3,100% */
.cj-node{position:absolute;top:24px;transform:translate(-50%,-50%);margin-top:0;width:22px;height:22px;border-radius:0;background:rgba(255,255,255,.06);border:1.5px solid rgba(255,255,255,.15);z-index:3;cursor:pointer;transition:all .3s cubic-bezier(.22,.61,.36,1);display:flex;align-items:center;justify-content:center}
.cj-node-inner{font-size:10px;font-weight:700;color:rgba(255,255,255,.5);letter-spacing:.04em;pointer-events:none;transition:color .3s}
.cj-node.done{background:#1D4ED8;border-color:#3B82F6;box-shadow:0 0 0 2px rgba(37,99,235,.2)}
.cj-node.done .cj-node-inner{color:rgba(255,255,255,.6)}
.cj-node.done::after{content:'✓';position:absolute;font-size:10px;color:#93C5FD;font-weight:700}
.cj-node.done .cj-node-inner{display:none}
.cj-node.current{width:28px;height:28px;top:22px;background:#2563EB;border-color:#60A5FA;border-width:2px;box-shadow:0 0 0 4px rgba(96,165,250,.2),0 0 16px rgba(96,165,250,.6)}
.cj-node.current .cj-node-inner{color:#fff;font-size:10px}

/* Node label/icon removed — cards row handles this */

/* Stem from active node down */
.cj-stem{position:absolute;top:34px;width:2px;height:12px;transform:translateX(-50%);z-index:2;background:rgba(96,165,250,.6);box-shadow:0 0 8px rgba(96,165,250,.5);display:none}
.cj-stem.show{display:block}

/* Step cards row — 7 cards equal width */
.cj-cards{display:grid;grid-template-columns:repeat(7,1fr);gap:0;margin-top:22px}
.cj-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:0;padding:.9rem .5rem 1rem;cursor:pointer;transition:all .22s cubic-bezier(.22,.61,.36,1);text-align:center;position:relative;border-bottom:none}
.cj-card:first-child{border-radius:0}
.cj-card:last-child{border-radius:0}
.cj-card + .cj-card{border-left:none}
.cj-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:transparent;transition:background .25s,box-shadow .25s}
.cj-card:hover{background:rgba(255,255,255,.08);transform:translateY(-2px)}
.cj-card:hover::before{background:rgba(96,165,250,.5);box-shadow:0 0 8px rgba(96,165,250,.4)}
.cj-card:hover .cj-card-icon{opacity:.85;transform:scale(1.15) translateY(-2px)}
.cj-card:hover .cj-card-num{color:rgba(96,165,250,.8)}
.cj-card:hover .cj-card-label{color:rgba(255,255,255,.8)}

.cj-card.active{background:rgba(255,255,255,.11);border-color:rgba(255,255,255,.2);border-bottom-color:transparent}
.cj-card.active::before{background:#60A5FA;box-shadow:0 0 10px rgba(96,165,250,.6)}
.cj-card.done::before{background:rgba(37,99,235,.5)}
.cj-card-icon{font-size:24px;display:block;margin-bottom:8px;opacity:.45;transition:opacity .22s,transform .28s cubic-bezier(.34,1.56,.64,1)}
.cj-card.active .cj-card-icon{opacity:1}
.cj-card.done .cj-card-icon{opacity:.75}
.cj-card-num{font-size:10px;font-weight:700;letter-spacing:.1em;color:rgba(255,255,255,.2);margin-bottom:4px;text-transform:uppercase}
.cj-card.active .cj-card-num{color:rgba(255,255,255,.5)}
.cj-card.done .cj-card-num{color:rgba(59,130,246,.7)}
.cj-card-label{font-size:10.5px;font-weight:600;color:rgba(255,255,255,.55);line-height:1.3}
.cj-card.active .cj-card-label{color:#fff;font-size:11px}
.cj-card.done .cj-card-label{color:rgba(255,255,255,.55)}

/* Detail panel — connects flush to active card */
.cj-detail{background:var(--navy);border-radius:0;overflow:hidden;box-shadow:0 8px 32px rgba(15,23,42,.3);position:relative;z-index:1;animation:cj-in .25s ease;margin-bottom:1.5rem}
@keyframes cj-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.cj-detail-inner{padding:1.6rem 2rem}
.cj-detail-step{font-size:10px;font-weight:700;letter-spacing:.12em;color:rgba(255,255,255,.55);text-transform:uppercase;margin-bottom:8px}
.cj-detail-icon{font-size:40px;margin-bottom:10px;display:block}
.cj-detail-title{font-size:22px;font-weight:700;color:#fff;margin-bottom:8px;letter-spacing:-.02em}
.cj-detail-desc{font-size:13.5px;color:rgba(255,255,255,.72);line-height:1.72;margin-bottom:1.2rem;max-width:680px}
.cj-badges{display:flex;flex-wrap:wrap;gap:7px}
.cj-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:0;font-size:11px;font-weight:600;background:rgba(255,255,255,.08);color:rgba(255,255,255,.75);border:1px solid rgba(255,255,255,.12)}
.cj-badge.green{background:rgba(16,185,129,.18);color:#6EE7B7;border-color:rgba(16,185,129,.3)}
.cj-badge.amber{background:rgba(245,158,11,.18);color:#FCD34D;border-color:rgba(245,158,11,.3)}
.cj-badge.blue{background:rgba(59,130,246,.18);color:#93C5FD;border-color:rgba(59,130,246,.3)}
.cj-detail-nav{display:flex;align-items:center;justify-content:space-between;padding:.9rem 2rem;border-top:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.03)}
.cj-nav-btn{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:#fff;padding:6px 16px;border-radius:0;cursor:pointer;font-size:12px;font-weight:600;transition:all .15s;font-family:inherit}
.cj-nav-btn:hover{background:rgba(255,255,255,.14)}
.cj-nav-btn:disabled{opacity:.3;cursor:default}
.cj-nav-dots{display:flex;gap:5px;align-items:center}
.cj-nav-dot{width:6px;height:6px;border-radius:0;background:rgba(255,255,255,.18);cursor:pointer;transition:all .2s}
.cj-nav-dot.active{width:20px;border-radius:0;background:#60A5FA;box-shadow:0 0 6px rgba(96,165,250,.5)}

/* Better stage card header */
.msc-header { background:rgba(0,0,0,.04); }
.mrm-stage-card.green .msc-header { background:rgba(16,185,129,.06); }
.mrm-stage-card.blue .msc-header { background:rgba(37,99,235,.06); }
.mrm-stage-card.purple .msc-header { background:rgba(124,58,237,.06); }
.mrm-stage-card.gold .msc-header { background:rgba(184,151,10,.06); }

/* Agency killers section */
.kills-grid { display:flex; flex-direction:column; gap:10px; margin-top:.5rem; }
.kill-card { display:flex; gap:14px; background:var(--bg2); border:1.5px solid var(--br); border-radius:0; padding:1rem 1.1rem; transition:all .2s; }

.kill-num { width:32px; height:32px; border-radius:0; background:linear-gradient(135deg,#EF4444,#DC2626); color:#fff; font-size:13px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.kill-title { font-size:13.5px; font-weight:700; color:var(--navy); margin-bottom:4px; }
.kill-desc { font-size:12px; color:var(--t2); line-height:1.6; }

/* P1 hero accent — overrides neutralised, main styles in p1-hero block above */
.p1-hero-h { color:#fff !important; -webkit-text-fill-color:#fff; }
.p1-hero-h .p1-hero-accent { -webkit-text-fill-color:transparent; }

@media(max-width:768px) {
  .mrm-journey { padding:1rem; }
