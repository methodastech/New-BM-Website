.cf-num  { font-size: 10px; font-weight:700; letter-spacing: .08em; color: var(--t3); margin-bottom: 6px; }
.cf-icon { font-size: 26px; margin-bottom: 6px; }
.cf-title{ font-size: 12.5px; font-weight:700; color: var(--navy); margin-bottom: 5px; line-height: 1.3; }
.cf-desc { font-size: 11px; color: var(--t2); line-height: 1.5; }
