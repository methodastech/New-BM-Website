/* nodes removed — bar only */

/* ---- The travelling "YOU ARE HERE" marker on the rail ---- */
/* Anchor is a zero-size point sitting ON the colour line.        */
/* Colour line: track bottom:0, height 9px → centre = 4.5px up.   */
/* Star is centred on this point; bubble floats above; the        */
/* connector drops below from the star to the card top.           */
.bj2-traveller {
  position: absolute;
  bottom: 4.5px; left: 8.33%;
  width: 0; height: 0;
  z-index: 7;
  pointer-events: none;
  transition: left .55s cubic-bezier(.22,.61,.36,1);
}
/* connector line dropping from the star down to the card top */
.bj2-traveller::after {
  content: '';
  position: absolute;
  top: 18px;
  left: 0;
  transform: translateX(-50%);
  width: 2px;
  height: 12px;
