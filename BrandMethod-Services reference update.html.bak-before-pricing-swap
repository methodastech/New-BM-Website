/* ══════════════════════════════════════════
   SERVICES HERO BANNER — Two column premium
   ══════════════════════════════════════════ */
.svc-hero {
  position: relative;
  background: #040A16;
  overflow: hidden;
  flex-direction: column;
  display: flex;
}
.svc-hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(-45deg, #040B18, #081322, #0A1730, #050C1A, #081322);
  background-size: 400% 400%;
  animation: svcBgLoop 18s ease infinite;
}
@keyframes svcBgLoop {
  0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%}
}
/* edge vignette: lets the glow orbs melt into the base colour before any boundary */
.svc-hero-bg::after {
  content: "";
  position: absolute; inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(4,10,22,.85) 0%, transparent 140px),
              linear-gradient(0deg, rgba(4,10,22,.6) 0%, transparent 110px);
  box-shadow: inset 0 0 130px 40px rgba(4,10,22,.92);
}
.hero-orb {
  position: absolute;
  border-radius:0;
}
.hero-orb-1 {
  width: 720px; height: 720px;
  background: radial-gradient(circle, rgba(37,99,235,0.30) 0%, rgba(37,99,235,0.14) 30%, rgba(37,99,235,0.05) 52%, transparent 78%);
  top: -230px; left: -190px;
  animation: svcOrb1 8s ease-in-out infinite alternate;
}
@keyframes svcOrb1 {
  0%{transform:translate(0,0) scale(1);opacity:.7}
  50%{transform:translate(24px,-28px) scale(1.08);opacity:1}
  100%{transform:translate(-12px,16px) scale(.95);opacity:.8}
}
.hero-orb-2 {
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(124,58,237,0.34) 0%, rgba(124,58,237,0.13) 34%, transparent 68%);
  top: -160px; right: 1%;
  animation: svcOrb2 9s ease-in-out infinite alternate-reverse;
}
@keyframes svcOrb2 {
  0%{transform:translate(0,0) scale(1)}
  50%{transform:translate(-20px,22px) scale(1.1)}
  100%{transform:translate(14px,-10px) scale(.93)}
}
.hero-orb-3 {
  width: 520px; height: 520px;
  background: radial-gradient(circle, rgba(13,148,136,0.26) 0%, rgba(13,148,136,0.10) 34%, transparent 68%);
  bottom: -150px; left: 36%;
  animation: svcOrb1 7s ease-in-out infinite alternate;
  animation-delay: -4s;
}
@keyframes hero-float {
  0%,100% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-22px) scale(1.04); }
  70% { transform: translateY(14px) scale(0.97); }
}
.hero-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 44px 44px;
  animation: svcGridDrift 5s linear infinite;
  transition: background-position .08s ease-out, transform .15s ease-out;
  will-change: transform;
}
/* secondary finer grid overlay */
.hero-grid::after {
  content: '';
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(99,102,241,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99,102,241,.03) 1px, transparent 1px);
  background-size: 22px 22px;
  animation: svcGridDrift 3s linear infinite reverse;
}
@keyframes svcGridDrift { 0%{background-position:0 0} 100%{background-position:44px 44px} }

.hero-orb-4 {
  position: absolute;
  width: 380px; height: 380px; border-radius:0;
  background: radial-gradient(circle, rgba(245,158,11,.28) 0%, rgba(245,158,11,.10) 32%, transparent 66%);
  bottom: -40px; right: 28%;
  animation: svcOrb2 11s ease-in-out infinite alternate;
  animation-delay: -5s;
}
/* Inner layout: two columns */
.svc-hero-inner {
  position: relative; z-index: 2;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 3rem;
  align-items: start;
  max-width: 1280px;
  margin: 0 auto;
  width: 100%;
  padding: 3rem 2rem 2.5rem;
  animation: hero-in .7s cubic-bezier(.22,.61,.36,1) both;
}
@keyframes hero-in {
  from { opacity:0; transform:translateY(20px); }
  to   { opacity:1; transform:translateY(0); }
}

/* Left */
.hero-left { display:flex; flex-direction:column; gap:0; ;position:relative}

.hero-left::before{content:'';position:absolute;top:-60px;left:-90px;width:560px;height:420px;background:radial-gradient(ellipse at 30% 30%, rgba(99,140,255,.16), transparent 65%);pointer-events:none;z-index:0}
.hero-left > *{position:relative;z-index:1}
.svc-hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11.5px; font-weight:600; letter-spacing: .14em;
  text-transform: uppercase; color: #7CB8FF; margin-bottom: 1.1rem;
}
.hero-dot {
  width: 6px; height: 6px; border-radius:0; background: #60A5FA;
  animation: hero-pulse 2s ease-in-out infinite;
}
@keyframes hero-pulse {
  0%,100% { opacity:1; transform:scale(1); }
  50% { opacity:.45; transform:scale(1.5); }
}

.svc-hero-h {
  font-size: clamp(32px, 3.8vw, 54px);
  font-weight:600; letter-spacing: -.025em; line-height: 1.12;
  color: #fff; margin-bottom: 1rem;
}
.hero-h-accent {
  font-family: 'Fraunces', Georgia, serif;
  font-style: italic; font-weight:600;
  font-size: 1.06em; letter-spacing: -.01em;
  background: linear-gradient(135deg, #7CB8FF 0%, #B9A3FF 55%, #4ADEB8 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; background-size: 200%;
  animation: hero-gradient-shift 5s ease-in-out infinite alternate;
  padding-right: .08em; /* italic overhang: keeps the final period from clipping */
}
@keyframes hero-gradient-shift {
  from { background-position: 0% 50%; }
  to   { background-position: 100% 50%; }
}

.hero-cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:1.7rem;animation:hero-in .7s cubic-bezier(.22,.61,.36,1) .2s both}
.hero-cta{font-family:'Inter',sans-serif;font-size:14px;font-weight:700;border-radius:0;padding:13px 26px;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,background .15s ease;border:none}
.hero-cta:active{transform:translateY(1px)}
.hero-cta-primary{background:linear-gradient(135deg,#2563EB,#4F46E5);color:#fff;box-shadow:0 10px 26px -10px rgba(59,130,246,.75)}
.hero-cta-primary:hover{transform:translateY(-2px);box-shadow:0 14px 32px -10px rgba(59,130,246,.9)}
.hero-cta-ghost{background:rgba(255,255,255,.06);color:#fff;border:1.5px solid rgba(255,255,255,.35)}
.hero-cta-ghost:hover{background:rgba(255,255,255,.14);transform:translateY(-2px)}
.svc-hero-sub {
  font-size: 15.5px; color: #BCC8DC; line-height: 1.8;
  max-width: 560px; margin-bottom: 1.7rem;
}

/* Trust checklist */
.hero-trust-row {
  display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.6rem;
  animation: hero-in .7s cubic-bezier(.22,.61,.36,1) .15s both;
}
.hero-trust-item {
  font-size: 14px !important; color: #E8EEF7 !important; font-weight: 600 !important;
  display: flex; align-items: center; gap: 10px;
  font-size: 13px; color: #CBD5E1; font-weight: 500;
}
.hero-trust-icon { width: 18px; height: 18px; flex-shrink: 0; }

/* Tags */
.svc-hero-tags {
  display: flex; flex-wrap: wrap; gap: 7px;
  animation: hero-in .7s cubic-bezier(.22,.61,.36,1) .28s both;
}
.hero-tag {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11.5px; font-weight: 600; color: #94A3B8;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  padding: 5px 12px; border-radius:0;
  transition: all .2s; cursor: default;
}
.hero-tag:hover {
  background: rgba(255,255,255,0.1); color: #fff;
  border-color: rgba(255,255,255,0.2); transform: translateY(-1px);
