.mem-cta-primary:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(245,158,11,.4)}
.mem-cta-primary.large{padding:16px 32px;font-size:16px}
.mem-cta-ghost{background:var(--bg2);color:var(--navy);border:1.5px solid var(--br);padding:14px 28px;border-radius:0;font-size:15px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:all .2s}
.mem-cta-ghost:hover{background:var(--bg3);border-color:var(--t3)}
.mem-cta-ghost.large{padding:16px 28px;font-size:16px}
.mem-hero-proof{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--t2)}
.mem-proof-item strong{color:var(--navy);font-weight:600}
.mem-proof-divider{color:var(--br);font-size:18px}
.mem-what{margin-bottom:3.5rem}
.mem-what-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--t3);margin-bottom:1.2rem;text-align:center}
.mem-what-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.mem-what-card{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:1.4rem;transition:transform .3s,box-shadow .3s;box-shadow:var(--sh)}

.mem-what-icon{font-size:28px;margin-bottom:10px}
.mem-what-title{font-size:14.5px;font-weight:700;color:var(--navy);margin-bottom:8px;line-height:1.3}
.mem-what-desc{font-size:13px;color:var(--t2);line-height:1.65}
.mem-section-label{font-size:22px;font-weight:700;color:var(--navy);letter-spacing:-.02em;margin-bottom:6px}
.mem-section-sub{font-size:14px;color:var(--t2);line-height:1.55;margin-bottom:1.8rem}
.mem-products-section{margin-bottom:3.5rem}
.mem-products{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-bottom:1.5rem}
.mem-product{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:1.5rem;position:relative;transition:transform .3s,box-shadow .3s;box-shadow:var(--sh)}

.mem-product-badge{position:absolute;top:1rem;right:1rem;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:3px 9px;border-radius:0}
.mem-product-badge.new{background:linear-gradient(135deg,#D1FAE5,#A7F3D0);color:#065F46;border:1px solid var(--green)}
.mem-product-icon{font-size:32px;margin-bottom:12px}
.mem-product-name{font-size:16px;font-weight:700;color:var(--navy);margin-bottom:8px;line-height:1.3}
.mem-product-desc{font-size:13px;color:var(--t2);line-height:1.65;margin-bottom:14px}
.mem-product-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.mem-ptag{font-size:10.5px;font-weight:600;color:var(--blue);background:var(--bl);border:1px solid var(--bb);padding:3px 9px;border-radius:0}
.mem-product-pricing{display:flex;gap:12px;align-items:center}
.mem-pprice-public{font-size:13px;font-weight:600;color:var(--t3);text-decoration:line-through}
.mem-pprice-member{font-size:16px;font-weight:700;color:var(--green);background:var(--gl);border:1px solid var(--gb);padding:4px 12px;border-radius:0}
.mem-pprice-label{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;opacity:.75;display:block}
.mem-products-footer{background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--br);border-radius:0;padding:1.3rem 1.5rem}
.mem-cs-label{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);margin-bottom:12px}
.mem-cs-items{display:flex;flex-wrap:wrap;gap:10px}
.mem-cs-item{font-size:12.5px;font-weight:600;color:var(--t2);background:var(--bg3);border:1px dashed var(--br);padding:5px 12px;border-radius:0}
.mem-live-section{margin-bottom:3.5rem}
.mem-live-hero{background:linear-gradient(135deg,#0F172A,#1E293B);border-radius:0;padding:2.5rem 2rem;color:#fff}
.mem-live-badge{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;background:rgba(239,68,68,.2);color:#FCA5A5;border:1px solid rgba(239,68,68,.3);padding:6px 14px;border-radius:0;margin-bottom:1.2rem}
.mem-live-title{font-size:30px;font-weight:700;letter-spacing:-.02em;line-height:1.25;margin-bottom:1rem;background:linear-gradient(135deg,#fff,#CBD5E1);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.mem-live-desc{font-size:14px;color:#94A3B8;line-height:1.7;margin-bottom:1.8rem;max-width:580px}
.mem-live-features{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.mem-live-feat{display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:start;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:0;padding:.9rem 1rem;font-size:13px;color:#CBD5E1}
.mem-live-feat span{font-size:20px;line-height:1}
.mem-live-feat strong{color:#fff}
.mem-tiers-section{margin-bottom:3.5rem;scroll-margin-top:70px}
.mem-tiers{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-bottom:1.8rem}
.mem-tier{background:var(--bg2);border:1.5px solid var(--br);border-radius:0;padding:2rem;position:relative;transition:transform .3s,box-shadow .3s;box-shadow:var(--sh)}

.mem-tier.paid{border-color:var(--bb);background:linear-gradient(180deg,#FAFBFF,#F0F4FF)}
.mem-tier-popular{position:absolute;top:-13px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:700;color:var(--blue);background:var(--bl);border:1.5px solid var(--bb);padding:4px 16px;border-radius:0;white-space:nowrap;letter-spacing:.04em}
.mem-tier-top{margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--br)}
.mem-tier-name{font-size:22px;font-weight:700;color:var(--navy);margin-bottom:4px;letter-spacing:-.02em}
.mem-tier-tag{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);margin-bottom:12px}
.mem-tier-price{font-size:42px;font-weight:700;color:var(--navy);letter-spacing:-.03em;margin-bottom:8px;line-height:1}
.mem-tier-price span{font-size:16px;font-weight:600;color:var(--t2)}
.mem-tier-desc{font-size:13px;color:var(--t2);line-height:1.6}
.mem-tier-features{display:flex;flex-direction:column;gap:8px;margin-bottom:1.8rem}
.mem-tfeat{font-size:13px;line-height:1.5;padding:4px 0}
.mem-tfeat.yes{color:var(--t1)}
.mem-tfeat.yes strong{color:var(--navy);font-weight:600}
.mem-tfeat.no{color:var(--t3)}
.mem-tier-btn{width:100%;padding:14px;border-radius:0;font-size:14px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;border:none;transition:all .2s;letter-spacing:.01em;margin-bottom:10px}
.free-btn{background:var(--bg3);color:var(--t1);border:1.5px solid var(--br)}
.free-btn:hover{background:var(--bg4);border-color:var(--t3)}
.paid-btn{background:linear-gradient(135deg,#F59E0B,#D97706);color:#fff;box-shadow:0 4px 16px rgba(245,158,11,.3)}
.paid-btn:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(245,158,11,.4)}
.mem-tier-note{font-size:11.5px;color:var(--t3);text-align:center;line-height:1.5}
.mem-value-box{background:linear-gradient(135deg,#FFFBEB,#FEF3C7);border:1.5px solid #F59E0B;border-radius:0;padding:1.8rem 2rem}
.mem-value-head{font-size:16px;font-weight:700;color:#92400E;margin-bottom:1.4rem}
.mem-value-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:1.2rem}
.mem-value-item{text-align:center;background:rgba(255,255,255,.6);border-radius:0;padding:1rem}
.mem-value-num{font-size:24px;font-weight:700;color:#92400E;letter-spacing:-.02em;margin-bottom:4px}
.mem-value-label{font-size:12px;color:#78350F;line-height:1.45}
.mem-value-note{font-size:13px;color:#78350F;line-height:1.65;font-style:italic;border-top:1px solid rgba(245,158,11,.3);padding-top:1rem;margin-top:.2rem}
.mem-for-section{margin-bottom:3.5rem}
.mem-for-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:1.4rem}
.mem-for-card{border-radius:0;padding:1.4rem;border:1.5px solid transparent;transition:transform .3s,box-shadow .3s}

.mem-for-card.green{background:linear-gradient(135deg,#FAFFFE,#F0FDF4);border-color:var(--gb)}
.mem-for-icon{font-size:26px;margin-bottom:10px}
.mem-for-title{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:6px;line-height:1.3}
.mem-for-desc{font-size:13px;color:var(--t2);line-height:1.6}
.mem-for-not{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:1rem 1.3rem;display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.mem-for-not-label{font-size:12px;font-weight:700;color:var(--t2);white-space:nowrap}
.mem-for-not-items{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:12.5px;color:var(--t3)}
.mem-final-cta{text-align:center;padding:4rem 1rem 3rem;border-top:1px solid var(--br);margin-top:2rem}
.mem-final-title{font-size:38px;font-weight:700;letter-spacing:-.03em;color:var(--navy);line-height:1.2;margin-bottom:1rem}
.mem-final-sub{font-size:16px;color:var(--t2);margin-bottom:2rem;line-height:1.6}
.mem-final-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:1.2rem}
.mem-final-note{font-size:12.5px;color:var(--t3);line-height:1.5}
@media(max-width:768px){
  .mem-hero-h{font-size:32px}.mem-live-title{font-size:24px}.mem-final-title{font-size:28px}
  .mem-tier-price{font-size:34px}.mem-tiers{grid-template-columns:1fr}.mem-value-grid{grid-template-columns:repeat(2,1fr)}
}

/* ── COMBINED INTEL BLOCK ── */
.intel-block{background:linear-gradient(180deg,#FAFBFF,#F0F4FF);border:1px solid var(--bb);border-radius:0;margin:0 0 2.5rem;box-shadow:var(--sh);overflow:hidden}
.intel-block summary{cursor:pointer;list-style:none;padding:1.1rem 1.5rem;display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--blue);user-select:none;transition:background .15s}
.intel-block summary:hover{background:rgba(59,130,246,.05)}
.intel-block summary::-webkit-details-marker,.intel-block summary::marker{display:none;content:''}
.intel-block summary::before{content:"📊";font-size:14px;margin-right:4px;flex-shrink:0}
.intel-block summary::after{content:"▼";font-size:10px;color:var(--blue);transition:transform .2s;margin-left:auto;font-weight:600}
.intel-block[open] summary::after{transform:rotate(180deg)}
.intel-block[open] summary{border-bottom:1px solid var(--bb)}
.intel-inner{padding:0}
.intel-mkt{padding:1.2rem 1.5rem;border-bottom:1px solid var(--bb)}
.intel-play{padding:1.2rem 1.5rem 1.4rem}
.intel-sub-head{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--blue);margin-bottom:12px;display:flex;align-items:center;gap:6px}

/* ── UPGRADE LADDER ── */
.ladder-grid{display:flex;flex-direction:column;gap:0;background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh)}
.ladder-row{display:flex;align-items:center;gap:0;padding:1rem 1.4rem;border-bottom:1px solid var(--br);min-height:64px}
.ladder-row:last-of-type{border-bottom:1px solid var(--br)}

.lr-svc{font-size:13px;font-weight:700;color:var(--navy);min-width:100px;flex-shrink:0}
.lr-steps{display:flex;align-items:center;flex-wrap:wrap;gap:4px;flex:1;padding:0 1rem}
.lr-step{font-size:11px;font-weight:600;padding:4px 10px;border-radius:0;white-space:nowrap;line-height:1.3}
.lr-step span{display:block;font-size:10px;font-weight:600;opacity:.7;margin-top:1px}
.ls-entry{background:var(--gl);color:var(--green);border:1px solid var(--gb)}
.ls-mid{background:var(--bl);color:var(--blue);border:1px solid var(--bb)}
.ls-prem{background:var(--pl);color:var(--purple);border:1px solid var(--pb)}
.ls-gold{background:#FEFCE8;color:#92400E;border:1px solid #FDE68A}
.lr-arr{font-size:13px;color:var(--t4);flex-shrink:0;padding:0 2px}
.lr-trigger{font-size:11px;color:var(--t4);flex-shrink:0;transition:transform .2s;width:20px;text-align:center}
.lr-detail{display:block;font-size:12px;color:var(--t2);line-height:1.65;padding:.3rem 1.4rem .7rem calc(1.4rem + 100px);border-bottom:1px solid var(--br);font-style:italic}


/* ══════════════════════════════════════════
   P1 — RITUALS + QA
══════════════════════════════════════════ */
.ritual-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:.5rem}
.ritual-col{background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh)}
.ritual-col-head{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.75rem 1.1rem;border-bottom:1px solid var(--br)}
.ritual-col-head.daily{background:var(--al);color:var(--amber)}
.ritual-col-head.weekly{background:var(--bl);color:var(--blue)}
.ritual-col-head.monthly{background:var(--gl);color:var(--green)}
.ritual-items{display:flex;flex-direction:column}
.ritual-item{display:flex;gap:10px;padding:.6rem 1.1rem;border-bottom:1px solid var(--br);font-size:12.5px;line-height:1.5}
.ritual-item:last-child{border-bottom:none}
.ri-time{font-size:10px;font-weight:700;color:var(--t3);min-width:40px;flex-shrink:0;padding-top:2px;letter-spacing:.04em}
.ri-text{color:var(--t1)}

.qa-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.qa-col{background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh)}
.qa-col-head{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.75rem 1.1rem;border-bottom:1px solid var(--br);background:var(--bg3);color:var(--t2)}
.qa-item{display:flex;align-items:flex-start;gap:10px;padding:.6rem 1.1rem;border-bottom:1px solid var(--br);cursor:pointer;transition:background .12s;font-size:12.5px;line-height:1.5;color:var(--t1)}
.qa-item:last-child{border-bottom:none}

.qa-item input[type=checkbox]{margin-top:3px;flex-shrink:0;accent-color:var(--green);width:14px;height:14px;cursor:pointer}
.qa-item input:checked + span{text-decoration:line-through;color:var(--t3)}

/* ══════════════════════════════════════════
   P4 — FINANCE & NUMBERS
══════════════════════════════════════════ */
.fn-section{margin-bottom:2.5rem}
.fn-head{display:flex;align-items:center;gap:14px;margin-bottom:1.4rem}
.fn-head-icon{width:44px;height:44px;border-radius:0;background:linear-gradient(135deg,#ECFDF5,#D1FAE5);border:1px solid var(--gb);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.fn-head-title{font-size:17px;font-weight:700;color:var(--navy);margin-bottom:3px}
.fn-head-sub{font-size:12px;color:var(--t3)}

/* Revenue targets */
.fn-targets{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.fn-target{background:var(--bg2);border:1.5px solid var(--br);border-radius:0;padding:1.3rem 1.4rem 1.4rem;position:relative;overflow:hidden;box-shadow:var(--sh)}
.fn-target::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.fn-target.s1::before{background:linear-gradient(90deg,#10B981,#34D399)}
.fn-target.s2::before{background:linear-gradient(90deg,#2563EB,#60A5FA)}
.fn-target.s3::before{background:linear-gradient(90deg,#7C3AED,#A78BFA)}
.fn-target.s4::before{background:linear-gradient(90deg,#D97706,#FBBF24)}
.fn-target-stage{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin-bottom:6px}
.fn-target-num{font-size:26px;font-weight:700;color:var(--navy);letter-spacing:-.03em;margin-bottom:3px;line-height:1}
.fn-target-num span{font-size:13px;color:var(--t3);font-weight:500}
.fn-target-label{font-size:11px;color:var(--t2);font-weight:600;margin-bottom:10px}
.fn-target-bar{height:4px;background:var(--bg3);border-radius:0;overflow:hidden;margin-bottom:10px}
.fn-target-fill{height:100%;border-radius:0;background:var(--green);transition:width 1s ease}
.fn-target.s2 .fn-target-fill{background:var(--blue)}
.fn-target.s3 .fn-target-fill{background:var(--purple)}
.fn-target.s4 .fn-target-fill{background:var(--amber)}
.fn-target-detail{font-size:11.5px;color:var(--t2);line-height:1.6}

/* Cost table */
.fn-cost-grid{display:grid;grid-template-columns:1fr 380px;gap:16px;align-items:start}
.fn-cost-table{background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh)}
.fn-cost-row{display:grid;grid-template-columns:1fr 90px 90px 90px;gap:0;padding:.7rem 1rem;border-bottom:1px solid var(--br);font-size:12.5px;align-items:center}
.fn-cost-row:last-child{border-bottom:none}
.fn-cost-row.header{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);background:var(--bg3);padding:.55rem 1rem}
.fn-cost-row.total{background:var(--navy);color:#fff;font-weight:600}
.fn-cost-row.total div{color:#fff}
.fn-tag{display:inline-flex;font-size:10px;font-weight:600;padding:2px 8px;border-radius:0}
.fn-tag.fixed{background:var(--bl);color:var(--blue)}
.fn-tag.var{background:var(--al);color:var(--amber)}
.fn-tag.green{background:var(--gl);color:var(--green)}

/* Cost notes */
.fn-cost-note{display:flex;flex-direction:column;gap:10px}
.fn-note-card{display:flex;align-items:flex-start;gap:12px;padding:1rem 1.1rem;border-radius:0;border:1px solid}
.fn-note-card.green{background:var(--gl);border-color:var(--gb)}
.fn-note-card.amber{background:var(--al);border-color:var(--ab)}
.fn-note-card.blue{background:var(--bl);border-color:var(--bb)}
.fn-note-icon{font-size:20px;flex-shrink:0}
.fn-note-title{font-size:12.5px;font-weight:700;color:var(--navy);margin-bottom:4px}
.fn-note-body{font-size:11.5px;color:var(--t2);line-height:1.6}

/* Math cards */
.fn-math-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.fn-math-card{border-radius:0;padding:1.4rem 1.4rem 1.5rem;border:1.5px solid;position:relative;overflow:hidden}
.fn-math-card.green{background:linear-gradient(160deg,#ECFDF5,#F0FDF9);border-color:var(--gb)}
.fn-math-card.blue{background:linear-gradient(160deg,#EFF6FF,#DBEAFE);border-color:var(--bb)}
.fn-math-card.purple{background:linear-gradient(160deg,#F5F3FF,#EDE9FE);border-color:var(--pb)}
.fn-math-icon{font-size:32px;margin-bottom:10px;display:block}
.fn-math-title{font-size:15px;font-weight:700;color:var(--navy);margin-bottom:8px}
.fn-math-eq{font-size:13px;font-weight:600;color:var(--t1);background:rgba(0,0,0,.04);padding:.5rem .8rem;border-radius:0;margin-bottom:10px;font-family:monospace;letter-spacing:-.02em}
.fn-math-note{font-size:12px;color:var(--t2);line-height:1.65;margin-bottom:12px}
.fn-math-verdict{display:inline-flex;font-size:10.5px;font-weight:600;padding:4px 12px;border-radius:0}
.fn-math-verdict.impossible{background:var(--rl);color:var(--red)}
.fn-math-verdict.possible{background:var(--al);color:var(--amber)}
.fn-math-verdict.ideal{background:var(--gl);color:var(--green)}
/* Cashflow rules */
.fn-rules{display:flex;flex-direction:column;gap:0;background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh)}
.fn-rule{display:flex;align-items:flex-start;gap:16px;padding:1.1rem 1.4rem;border-bottom:1px solid var(--br)}
.fn-rule:last-child{border-bottom:none}
.fn-rule-num{font-size:20px;font-weight:700;color:var(--t4);min-width:32px;letter-spacing:-.02em;flex-shrink:0}
.fn-rule-text{font-size:13px;color:var(--t1);line-height:1.7}

/* ══ ADDED FILL SECTIONS: shared utilities (finance / roadmap / team) ══ */
.gx-table{background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh);margin-bottom:14px}
.gx-row{display:grid;gap:0 16px;padding:.7rem 1rem;border-bottom:1px solid var(--br);font-size:12.5px;align-items:center}
.gx-row:last-child{border-bottom:none}
.gx-row.head{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--t3);background:var(--bg3);padding:.55rem 1rem}
.gx-row.total{background:var(--navy);color:#fff;font-weight:600}
.gx-row.total *{color:#fff}
.gx-row strong{font-weight:600;color:var(--navy)}
.gx-r{text-align:right}
.gx-pos{color:var(--green);font-weight:600}
.gx-neg{color:var(--red);font-weight:600}
.gx-sub{font-size:11px;color:var(--t3);display:block;margin-top:2px}
.gx-4{grid-template-columns:1.5fr 1fr 1fr 1fr}
.gx-pnl{grid-template-columns:1.7fr 1fr .7fr}
.gx-kpi{grid-template-columns:1.6fr 1.1fr 1.1fr 1.1fr}
.gx-stat{grid-template-columns:1.3fr 1.1fr 1.9fr}
.assume{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--amber);background:var(--al);border:1px solid var(--ab);padding:2px 8px;border-radius:0;margin-left:7px;vertical-align:middle;white-space:nowrap}
.assume-note{font-size:11.5px;color:var(--t3);font-style:italic;margin-top:10px;display:flex;gap:7px;align-items:flex-start;line-height:1.55}
.assume-note::before{content:'✎';font-style:normal;color:var(--amber);flex-shrink:0}
/* roadmap quarters */
.rmq-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.rmq-card{background:var(--bg2);border:1.5px solid var(--br);border-radius:0;padding:1.1rem 1.2rem;box-shadow:var(--sh);position:relative;overflow:hidden}
.rmq-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--bb)}
.rmq-card.now{border-color:var(--gb)}
.rmq-card.now::before{background:linear-gradient(90deg,#10B981,#34D399)}
.rmq-q{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin-bottom:5px}
.rmq-now-badge{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#fff;background:var(--green);padding:2px 8px;border-radius:0;margin-bottom:7px}
.rmq-focus{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:9px;line-height:1.2}
.rmq-li{font-size:11.5px;color:var(--t2);line-height:1.45;padding-left:14px;position:relative;margin-bottom:6px}
.rmq-li::before{content:'';position:absolute;left:0;top:6px;width:5px;height:5px;border-radius:0;background:var(--bb)}
.rmq-card.now .rmq-li::before{background:var(--gb)}
/* 90-day sprint */
.sprint{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:4px}
.sprint-col{background:var(--bg3);border:1px solid var(--br);border-radius:0;padding:1rem 1.1rem}
.sprint-h{font-size:12px;font-weight:700;color:var(--navy);margin-bottom:9px;display:flex;align-items:center;gap:7px}
.sprint-li{font-size:11.5px;color:var(--t2);line-height:1.5;margin-bottom:7px;padding-left:17px;position:relative}
.sprint-li::before{content:'→';position:absolute;left:0;color:var(--t4);font-weight:700}
/* KPI dashboard reuses gx-table */
.kpi-tag{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:2px 7px;border-radius:0}
.kpi-tag.s1{background:var(--gl);color:var(--green)} .kpi-tag.s2{background:var(--bl);color:var(--blue)}
.kpi-tag.s3{background:var(--pl);color:var(--purple)} .kpi-tag.s4{background:var(--al);color:var(--amber)}
/* org chart */
.org-stage{margin-bottom:16px;padding:1.1rem 1.2rem;background:var(--bg2);border:1px solid var(--br);border-radius:0;box-shadow:var(--sh)}
.org-stage-h{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:2px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.org-stage-sub{font-size:11.5px;color:var(--t3);margin-bottom:11px;line-height:1.5}
.org-tier-label{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--t4);margin:10px 0 6px}
.org-row{display:flex;flex-wrap:wrap;gap:8px;align-items:stretch}
.org-node{display:flex;flex-direction:column;gap:1px;background:var(--bg3);border:1.5px solid var(--br);border-radius:0;padding:.55rem .85rem;min-width:118px}
.org-node.lead{border-color:var(--bb);background:linear-gradient(160deg,#fff,#EFF4FF)}
.org-node.found{border-color:var(--gb);background:linear-gradient(160deg,#fff,#ECFDF5)}
.org-node-role{font-size:12px;font-weight:700;color:var(--navy)}
.org-node-meta{font-size:10px;color:var(--t3)}
/* hiring process steps */
.proc{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:8px}
.proc-step{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:.9rem 1rem;box-shadow:var(--sh)}
.proc-n{width:24px;height:24px;border-radius:0;background:var(--bl);border:1px solid var(--bb);color:var(--blue);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-bottom:8px}
.proc-t{font-size:12px;font-weight:700;color:var(--navy);margin-bottom:4px;line-height:1.2}
.proc-d{font-size:11px;color:var(--t2);line-height:1.5}
@media(max-width:880px){.rmq-grid{grid-template-columns:1fr 1fr}.sprint{grid-template-columns:1fr}.proc{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.rmq-grid,.proc{grid-template-columns:1fr}}

/* ══════════════════════════════════════════
   P5 — TEAM & HIRING
══════════════════════════════════════════ */
.tm-section{margin-bottom:2.5rem}
.tm-head{display:flex;align-items:center;gap:14px;margin-bottom:1.4rem}
.tm-head-icon{width:44px;height:44px;border-radius:0;background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border:1px solid var(--bb);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.tm-head-title{font-size:17px;font-weight:700;color:var(--navy);margin-bottom:3px}
.tm-head-sub{font-size:12px;color:var(--t3)}

/* Hiring timeline */
.tm-timeline{display:flex;flex-direction:column;gap:12px}
.tm-hire{display:grid;grid-template-columns:90px 1fr;gap:16px;align-items:start}
.tm-hire-when{font-size:11px;font-weight:700;color:var(--t3);text-align:right;padding-top:1.1rem;letter-spacing:.03em;white-space:nowrap}
.tm-hire-card{background:var(--bg2);border:1.5px solid var(--br);border-radius:0;padding:1.2rem 1.4rem;box-shadow:var(--sh);position:relative;overflow:hidden;transition:box-shadow .2s}

.tm-hire-role{font-size:15px;font-weight:700;color:var(--navy);margin-bottom:6px}
.tm-hire-trigger{font-size:12px;color:var(--blue);background:var(--bl);border:1px solid var(--bb);padding:.4rem .8rem;border-radius:0;margin-bottom:8px;line-height:1.5}
.tm-hire-comp{font-size:12.5px;font-weight:600;color:var(--green);margin-bottom:8px}
.tm-hire-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.tm-tag{font-size:10px;font-weight:600;padding:3px 10px;border-radius:0}
.tm-tag.green{background:var(--gl);color:var(--green);border:1px solid var(--gb)}
.tm-tag.blue{background:var(--bl);color:var(--blue);border:1px solid var(--bb)}
.tm-tag.amber{background:var(--al);color:var(--amber);border:1px solid var(--ab)}
.tm-tag.purple{background:var(--pl);color:var(--purple);border:1px solid var(--pb)}
.tm-hire-notes{font-size:12px;color:var(--t2);line-height:1.65;border-top:1px solid var(--br);padding-top:.7rem;margin-top:.2rem}

/* Onboarding checklist */
.tm-onboard-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.tm-onboard-phase{background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh)}
.tm-onboard-week{font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:.75rem 1.1rem;border-bottom:1px solid var(--br);background:var(--navy);color:#fff}
.tm-check{display:flex;align-items:flex-start;gap:10px;padding:.65rem 1.1rem;border-bottom:1px solid var(--br);cursor:pointer;transition:background .12s;font-size:12.5px;line-height:1.5;color:var(--t1)}
.tm-check:last-child{border-bottom:none}

.tm-check input[type=checkbox]{margin-top:3px;flex-shrink:0;accent-color:var(--navy);width:14px;height:14px;cursor:pointer}
.tm-check input:checked + span{text-decoration:line-through;color:var(--t3)}

/* Culture rules */
.tm-rules{display:flex;flex-direction:column;gap:0;background:var(--bg2);border:1px solid var(--br);border-radius:0;overflow:hidden;box-shadow:var(--sh)}
.tm-rule{display:flex;align-items:flex-start;gap:16px;padding:1.1rem 1.4rem;border-bottom:1px solid var(--br)}
.tm-rule:last-child{border-bottom:none}
.tm-rule-num{font-size:20px;font-weight:700;color:var(--t4);min-width:32px;flex-shrink:0;letter-spacing:-.02em}
.tm-rule-body{font-size:13px;color:var(--t1);line-height:1.7}

/* ══════════════════════════════════════════
   RESPONSIVE — P4 + P5
══════════════════════════════════════════ */
@media(max-width:960px){
  .fn-targets{grid-template-columns:repeat(2,1fr)}
  .fn-cost-grid{grid-template-columns:1fr}
  .fn-math-grid{grid-template-columns:1fr}
  .ritual-grid,.qa-grid,.tm-onboard-grid{grid-template-columns:1fr}
}
@media(max-width:640px){
  .fn-targets{grid-template-columns:1fr}
  .tm-hire{grid-template-columns:1fr}
  .tm-hire-when{text-align:left;padding-top:0}
  .fn-cost-row{grid-template-columns:1fr 80px 80px 70px;font-size:11px}
}


/* ══════════════════════════════════════════
   BURGER MENU + MOBILE NAV
══════════════════════════════════════════ */
.burger-btn{display:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:38px;height:38px;border:1px solid var(--br);background:var(--bg2);border-radius:0;cursor:pointer;flex-shrink:0;padding:0;transition:all .15s}
.burger-btn:hover{background:var(--bg3);border-color:var(--t4)}
.burger-btn span{display:block;width:16px;height:2px;background:var(--t2);border-radius:0;transition:all .25s}
.burger-btn.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.burger-btn.open span:nth-child(2){opacity:0;transform:scaleX(0)}
.burger-btn.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* Mobile nav overlay */
.mobile-nav-overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:998;opacity:0;pointer-events:none;transition:opacity .25s;backdrop-filter:blur(4px)}
.mobile-nav-overlay.show{opacity:1;pointer-events:all}

/* Mobile nav drawer */
.mobile-nav{position:fixed;top:0;right:-320px;width:300px;max-width:85vw;height:100vh;background:var(--bg2);z-index:999;box-shadow:-8px 0 32px rgba(0,0,0,.15);transition:right .28s cubic-bezier(.22,.61,.36,1);display:flex;flex-direction:column;overflow:hidden}
.mobile-nav.show{right:0}
.mobile-nav-head{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.2rem;border-bottom:1px solid var(--br);flex-shrink:0}
.mobile-nav-close{width:32px;height:32px;border:1px solid var(--br);background:var(--bg3);border-radius:0;cursor:pointer;font-size:14px;color:var(--t3);display:flex;align-items:center;justify-content:center;transition:all .15s}
.mobile-nav-close:hover{background:var(--rl);color:var(--red);border-color:var(--rb)}
.mobile-nav-body{flex:1;overflow-y:auto;padding:.6rem .8rem}
.mobile-tab{display:flex;align-items:center;gap:12px;width:100%;padding:.85rem 1rem;border-radius:0;border:1px solid transparent;background:none;cursor:pointer;font-family:inherit;text-align:left;transition:all .15s;margin-bottom:4px}
.mobile-tab:hover{background:var(--bg3);border-color:var(--br)}
.mobile-tab.active{background:var(--navy);border-color:var(--navy)}
.mobile-tab-icon{font-size:22px;flex-shrink:0;width:32px;text-align:center}
.mobile-tab-name{font-size:14px;font-weight:600;color:var(--navy);margin-bottom:2px}
.mobile-tab.active .mobile-tab-name{color:#fff}
.mobile-tab-sub{font-size:11px;color:var(--t3);font-weight:400}
.mobile-tab.active .mobile-tab-sub{color:rgba(255,255,255,.5)}
.mobile-nav-footer{padding:.9rem 1.2rem;border-top:1px solid var(--br);flex-shrink:0}
.mobile-nav-brand{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:4px;letter-spacing:-.01em}
.mobile-nav-version{font-size:11px;color:var(--t3)}

/* Show burger on mobile, hide desktop tabs */
@media(max-width:768px){
  .burger-btn{display:flex}
  nav .tabs{display:none}
  nav{justify-content:space-between;padding:0 1rem}
}

/* ══════════════════════════════════════════
   COMPREHENSIVE MOBILE RESPONSIVE
══════════════════════════════════════════ */
@media(max-width:768px){
  /* Global */
  body{background:#F7F8FC!important}
  .wrap{padding:1.2rem .9rem 2rem}
  .ph-h{font-size:22px}
  .ph{margin:-1rem -1rem 1.5rem;padding:2rem 1rem 1.8rem;}
  
  /* Page 1 */
  .ritual-grid{grid-template-columns:1fr}
  .qa-grid{grid-template-columns:1fr}
  .ladder-row{flex-wrap:wrap;gap:8px}
  .lr-svc{min-width:unset;width:100%;font-size:14px;padding-bottom:4px}
  .lr-steps{flex-wrap:wrap;gap:6px;padding:0}
  .lr-arr{display:none}
  .lr-detail{padding-left:1rem}

  /* Client Journey */
  .cj-wrap{padding:1.2rem 1rem 0; overflow:visible}
  .cj-cards{display:flex;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;gap:0;
    /* dual-side fade: left=past cards, right=peek signal */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 14%, black calc(100% - 28px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 14%, black calc(100% - 28px), transparent 100%);
  }
  .cj-cards::-webkit-scrollbar{display:none}
  /* 2.8 cards visible = current + prev + next peek */
  .cj-card{flex:0 0 calc(100% / 2.8);min-width:82px;padding:.6rem .4rem .7rem;
    transition: transform .35s cubic-bezier(.22,.61,.36,1), filter .35s ease, opacity .35s ease;
  }
  /* cards that are "behind" (not active, not next) — depth blur */
  .cj-card.done { filter: blur(1.5px); opacity:.55; transform: scale(.94); }
  .cj-card:first-child{border-radius:0}
  .cj-card:last-child{border-radius:0;margin-right:0}
  .cj-card-icon{font-size:18px;margin-bottom:4px}
  .cj-card-label{font-size:10px;word-break:break-word;hyphens:auto;line-height:1.25}
  .cj-card.active .cj-card-label{font-size:10px}
  .cj-detail-inner{padding:1.2rem 1.2rem}
  .cj-detail-title{font-size:18px}
  .cj-detail-desc{font-size:13px}

  /* Page 3 — progress tracker */
  .pt-wrap{padding:1.2rem 1rem 0;border-radius:0}
  .pt-title{font-size:16px}
  .pt-cards{grid-template-columns:repeat(2,1fr);gap:8px}
  .pt-card{border-radius:0;padding:.8rem .9rem .9rem}
  .pt-card-name{font-size:12px}
  .pt-road-track{height:80px}
  .pt-car{font-size:24px}
  .pt-car-bubble{font-size:10px;padding:4px 10px}
  .sd-body{grid-template-columns:1fr}
  .sd-col.dont{border-left:none;border-top:1px solid rgba(0,0,0,.06)}
  .sd-title{font-size:20px}
  .sd-header-icon{font-size:36px}

  /* Page 3 — launch sequence */
  .ls-row-top{flex-wrap:nowrap}
  .ls-row-meta{flex-direction:column;align-items:flex-end;gap:4px}
  .ls-pill{font-size:10px;padding:3px 8px}

  /* Page 3 — principles grid */
  .op2-grid{grid-template-columns:1fr 1fr}

  /* Page 4 — finance */
  .fn-targets{grid-template-columns:1fr}
  .fn-cost-grid{grid-template-columns:1fr}
  .fn-cost-row{grid-template-columns:1fr;gap:4px;padding:.6rem .8rem}
  .fn-cost-row.header{display:none}
  .fn-cost-row > div:not(:first-child){font-size:11px;color:var(--t3)}
  .fn-math-grid{grid-template-columns:1fr}
  .fn-rules{border-radius:0}

  /* Page 5 — team */
  .tm-timeline{gap:0}
  .tm-hire{grid-template-columns:1fr;gap:0}
  .tm-hire-when{text-align:left;padding:.8rem 0 .2rem;font-size:12px;font-weight:700;color:var(--blue)}
  .tm-hire-card{border-radius:0;margin-bottom:12px}
  .tm-onboard-grid{grid-template-columns:1fr}
  .tm-rules{border-radius:0}

  /* Upsell trigger / refund sections */
  .rule{padding:.75rem .9rem}
  
  /* ak2 rows */
  .ak2-num{font-size:16px;min-width:26px}
  .ak2-detail{padding-left:calc(26px + .8rem + 16px)}
}

@media(max-width:480px){
  .cj-cards{grid-template-columns:repeat(4,1fr)}
  .pt-cards{grid-template-columns:1fr 1fr}
  .op2-grid{grid-template-columns:1fr}
  .fn-targets{grid-template-columns:1fr}
  .ph-h{font-size:20px}
  .ph{margin:-1rem -1rem 1.5rem;padding:2rem 1rem 1.8rem;}
}


/* ══════════════════════════════════════════
   PAGE 6 — CLIENT COMMUNICATION SOP
══════════════════════════════════════════ */

/* Phase navigator */
.sop-nav{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:1rem 1.4rem;margin-bottom:2rem;box-shadow:var(--sh)}
.sop-nav-label{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin-bottom:10px}
.sop-nav-pills{display:flex;flex-wrap:wrap;gap:7px}
.sop-pill{font-size:12px;font-weight:600;padding:5px 14px;border-radius:0;background:var(--bg3);border:1px solid var(--br);color:var(--t2);text-decoration:none;transition:all .15s;white-space:nowrap}
.sop-pill:hover{background:var(--bl);border-color:var(--bb);color:var(--blue)}

/* Phase container */
.sop-phase{margin-bottom:2rem;border-radius:0;overflow:hidden;box-shadow:var(--sh2)}

/* Phase header variants */
.sop-phase-header{padding:1.4rem 1.8rem;position:relative;overflow:hidden}
.sop-phase-header.green{background:linear-gradient(135deg,#F0FDF9,#DCFCE7);border-bottom:1px solid var(--gb)}
.sop-phase-header.blue{background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border-bottom:1px solid var(--bb)}
.sop-phase-header.amber{background:linear-gradient(135deg,#FFFBEB,#FEF3C7);border-bottom:1px solid var(--ab)}
.sop-phase-header.purple{background:linear-gradient(135deg,#FAF5FF,#EDE9FE);border-bottom:1px solid var(--pb)}
.sop-phase-header.red{background:linear-gradient(135deg,#FFF1F2,#FFE4E6);border-bottom:1px solid var(--rb)}
.sop-phase-badge{display:inline-flex;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;border-radius:0;background:rgba(0,0,0,.06);color:var(--navy);margin-bottom:7px}
.sop-phase-title{font-size:20px;font-weight:700;color:var(--navy);margin-bottom:5px;letter-spacing:-.02em}
.sop-phase-sub{font-size:13px;color:var(--t2);line-height:1.65;max-width:680px}

/* Steps */
.sop-steps{background:var(--bg2);display:flex;flex-direction:column}
.sop-step{display:grid;grid-template-columns:140px 1fr;border-bottom:1px solid var(--br)}
.sop-step:last-child{border-bottom:none}
.sop-step-meta{padding:1.4rem 1.2rem 1.4rem 1.8rem;border-right:1px solid var(--br);background:var(--bg3)}
.sop-step-num{font-size:22px;font-weight:700;color:var(--t4);letter-spacing:-.02em;margin-bottom:4px}
.sop-step-time{font-size:10px;font-weight:600;color:var(--t3);line-height:1.4;letter-spacing:.02em}
.sop-step-body{padding:1.4rem 1.8rem}
.sop-step-title{font-size:15px;font-weight:700;color:var(--navy);margin-bottom:8px}
.sop-step-desc{font-size:13px;color:var(--t2);line-height:1.7;margin-bottom:12px}

/* Script blocks */
.sop-script{background:var(--navy);border-radius:0;padding:1rem 1.2rem;margin-bottom:10px}
.sop-script-label{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:8px}
.sop-script-text{font-size:12.5px;color:rgba(255,255,255,.82);line-height:1.75;white-space:pre-line}

/* Inline rule alerts */
.sop-rule{display:flex;align-items:flex-start;gap:8px;font-size:12.5px;padding:.7rem 1rem;border-radius:0;margin-top:8px;line-height:1.6}
.sop-rule.green{background:var(--gl);color:#065F46;border:1px solid var(--gb)}
.sop-rule.amber{background:var(--al);color:#78350F;border:1px solid var(--ab)}
.sop-rule.red{background:var(--rl);color:#991B1B;border:1px solid var(--rb)}
.sop-rule.blue{background:var(--bl);color:#1D4ED8;border:1px solid var(--bb)}

/* Checklist inside steps */
.sop-checklist{display:flex;flex-direction:column;gap:6px;margin:10px 0}
.sop-check-item{display:flex;align-items:flex-start;gap:9px;font-size:12.5px;padding:5px 0;color:var(--t1)}
.sop-check-item span{font-size:14px;font-weight:700;flex-shrink:0;margin-top:1px}
.sop-check-item.green span{color:var(--green)}
.sop-check-item.amber span{color:var(--amber)}
.sop-check-item.red span{color:var(--red)}
.sop-check-item.blue span{color:var(--blue)}

/* Onboarding checklist block */
.sop-checklist-block{background:var(--bg3);border-top:1px solid var(--br);padding:1.4rem 1.8rem}
.sop-checklist-title{font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--t2);margin-bottom:12px}
.sop-check-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sop-check-label{display:flex;align-items:flex-start;gap:9px;font-size:13px;color:var(--t1);cursor:pointer;padding:5px 0;line-height:1.5}
.sop-check-label input[type=checkbox]{margin-top:3px;flex-shrink:0;accent-color:var(--navy);width:14px;height:14px;cursor:pointer}
.sop-check-label input:checked + span{text-decoration:line-through;color:var(--t3)}

/* Objection handling */
.sop-objections{display:flex;flex-direction:column;gap:12px}
.sop-obj{border-radius:0;overflow:hidden;border:1px solid var(--br)}
.sop-obj-q{background:var(--rl);border-bottom:1px solid var(--rb);padding:.7rem 1rem;font-size:13px;font-weight:600;color:#991B1B}
.sop-obj-a{background:var(--bg2);padding:.8rem 1rem;font-size:13px;color:var(--t1);line-height:1.65}

/* Upsell paths */
.sop-upsell-paths{display:flex;flex-direction:column;gap:12px;margin-bottom:12px}
.sop-upsell-path{border-radius:0;overflow:hidden;border:1px solid var(--bb);background:var(--bg2)}
.sop-upsell-from{background:var(--bl);border-bottom:1px solid var(--bb);padding:.6rem 1rem;font-size:12px;font-weight:600;color:var(--blue)}

/* Monthly report structure */
.sop-report-structure{display:flex;flex-direction:column;gap:8px;margin:12px 0}
.sop-report-item{display:flex;align-items:flex-start;gap:12px;padding:.65rem .9rem;background:var(--bg3);border-radius:0;font-size:13px;color:var(--t1);line-height:1.5}
.sop-report-num{font-size:11px;font-weight:700;color:var(--t4);min-width:22px;flex-shrink:0;padding-top:1px}

/* Standing rules grid */
.sop-rules-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;background:var(--bg2);padding:1.6rem;border-top:none}
.sop-rule-card{background:var(--bg3);border:1px solid var(--br);border-radius:0;padding:1.1rem 1.1rem 1.2rem;transition:all .2s}

.sop-rule-icon{font-size:26px;margin-bottom:10px;display:block}
.sop-rule-title{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:6px}
.sop-rule-body{font-size:12px;color:var(--t2);line-height:1.65}

/* Mobile responsive P6 */
@media(max-width:900px){
  .sop-rules-grid{grid-template-columns:repeat(2,1fr)}
  .sop-check-grid{grid-template-columns:1fr}
}
@media(max-width:768px){
  .sop-step{grid-template-columns:1fr}
  .sop-step-meta{border-right:none;border-bottom:1px solid var(--br);padding:1rem 1.2rem .8rem;display:flex;align-items:center;gap:12px;background:var(--bg3)}
  .sop-step-num{font-size:18px;margin-bottom:0}
  .sop-step-time{font-size:10px}
  .sop-step-body{padding:1rem 1.2rem 1.2rem}
  .sop-phase-title{font-size:17px}
  .sop-phase-header{padding:1.1rem 1.2rem}
  .sop-rules-grid{grid-template-columns:1fr 1fr;padding:1.2rem}
  .sop-nav-pills{gap:5px}
  .sop-pill{font-size:11px;padding:4px 11px}
  .sop-script-text{font-size:12px}
  .sop-checklist-block{padding:1.1rem 1.2rem}
}
@media(max-width:480px){
  .sop-rules-grid{grid-template-columns:1fr}
  .sop-objections .sop-script{margin:0}
}

