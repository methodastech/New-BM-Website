/* ══════════════════════════════════════════════════════════════
   BRAND JOURNEY — "ALIVE" UPGRADE (v15)
   Living rail + travelling "you are here" marker + ambient motion.
   Light theme preserved. All column content untouched.
══════════════════════════════════════════════════════════════ */

/* ---- The journey rail that threads across the 6 phases ---- */
/* Sits right on top of the board's colored card borders (no floating gap). */
.bj2-rail {
  position: relative;
  height: 64px;
  margin: 0;
  padding: 0 0 6px;
  z-index: 6;
  background: #fff;
  border: 1px solid #E2E8F0;
  border-bottom: none;
  border-radius:0;
}
/* base track — double bar: two parallel lines */
.bj2-rail-track {
  position: absolute;
  left: 0; right: 0;
  bottom: 0; height: 9px;
  border-radius:0;
  background: transparent;
  overflow: visible;
}
/* two parallel lines via pseudo elements */
.bj2-rail-track::before,
.bj2-rail-track::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  height: 3px;
  border-radius:0;
  background: #E2E8F0;
}
.bj2-rail-track::before { top: 0; }
.bj2-rail-track::after  { top: 6px; }
/* the glowing progress fill — covers both bars */
.bj2-rail-fill {
  position: absolute;
  left: 0; top: 0; height: 100%;
