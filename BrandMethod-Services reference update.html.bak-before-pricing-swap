  }
  .bj2-c-head { position: static; top: auto; }
  .bj2-c-num { font-size: 52px; }
  .bj2-c-title { font-size: 17px; }
  .bj2-li > li { font-size: 12.5px; }
  .bj2-sub > li { font-size: 11.5px; }
