<script>
(function(){
  var hd=document.getElementById('bmref-hd'); if(!hd) return;
  /* SERVICES dropdown: faithful hover-intent + click-pin (adds/removes .open) */
  var dd=hd.querySelector('.nav-dd');
  if(dd){
    var trg=dd.querySelector('.nav-dd-trigger'), panel=dd.querySelector('.nav-dd-panel'), t=null, pinned=false;
    function op(){dd.classList.add('open');trg.setAttribute('aria-expanded','true');}
    function hardClose(){pinned=false;dd.classList.remove('open');trg.setAttribute('aria-expanded','false');}
    function softClose(){if(!pinned){dd.classList.remove('open');trg.setAttribute('aria-expanded','false');}}
    function keep(){clearTimeout(t);op();}
    function leave(){clearTimeout(t);t=setTimeout(softClose,320);}
    trg.addEventListener('mouseenter',keep);
    trg.addEventListener('mouseleave',leave);
    panel.addEventListener('mouseenter',keep);
    panel.addEventListener('mouseleave',leave);
    trg.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();clearTimeout(t);if(pinned){hardClose();}else{pinned=true;op();}});
    trg.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();clearTimeout(t);if(pinned){hardClose();}else{pinned=true;op();}}});
    document.addEventListener('click',function(e){if(!dd.contains(e.target))hardClose();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')hardClose();});
    /* dd-dismiss: force-close when a panel link is chosen even while still hovering */
    dd.querySelectorAll('.nav-dd-panel a').forEach(function(a){a.addEventListener('click',function(){hardClose();dd.classList.add('dd-dismiss');if(document.activeElement&&document.activeElement.blur)document.activeElement.blur();});});
    dd.addEventListener('mouseleave',function(){dd.classList.remove('dd-dismiss');});
    trg.addEventListener('mouseenter',function(){dd.classList.remove('dd-dismiss');});
  }
  /* mobile burger toggle */
  var burger=document.getElementById('burger'), navMobile=document.getElementById('navMobile');
  if(burger&&navMobile){
    burger.addEventListener('click',function(){var o=navMobile.classList.toggle('open');burger.classList.toggle('open',o);burger.setAttribute('aria-expanded',o?'true':'false');});
  }
  /* per-service accent on mobile submenu (faithful colour) */
  var MOB={'svc-brand-strategy':'#d63a7e','svc-systems':'#3a55e8','svc-marketing':'#c8890d','svc-content':'#7a4ee8','svc-web':'#0fa67a'};
  hd.querySelectorAll('.m-sub a[data-svc]').forEach(function(a){var c=MOB[a.getAttribute('data-svc')];if(c)a.style.setProperty('--dc',c);});
  /* neutralise SPA data-page links (no SPA router in this doc) */
  hd.querySelectorAll('a[data-page]').forEach(function(a){
    a.addEventListener('click',function(e){
      e.preventDefault();
      var pg=a.getAttribute('data-page');
      if(a.classList.contains('nav-logo')||pg==='home'){window.scrollTo({top:0,behavior:'smooth'});}
      if(navMobile)navMobile.classList.remove('open');
      if(burger){burger.classList.remove('open');burger.setAttribute('aria-expanded','false');}
    });
  });
})();
</script>
