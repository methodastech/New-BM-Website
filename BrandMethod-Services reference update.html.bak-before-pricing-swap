/* funnel-at-a-glance */
.gf-viz-wrap{background:radial-gradient(1100px 380px at 50% -12%,rgba(37,99,235,.18),transparent 60%),linear-gradient(180deg,#0D1320,#080C16);border:1px solid rgba(96,165,250,.16);border-radius:0;padding:1.5rem 1.1rem 1.3rem;margin-bottom:1.8rem;position:relative;overflow:hidden}
.gf-viz-title{text-align:center;color:#E2E8F0;font-size:10.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin-bottom:.7rem;opacity:.78}
.gf-viz{display:flex;justify-content:center}
.gf-viz svg{width:100%;max-width:560px;height:auto;display:block}
.gf-band-label{font-weight:700;fill:#fff}
.gf-band-sub{font-weight:600;fill:rgba(255,255,255,.88)}
.gf-legend{display:flex;flex-wrap:wrap;gap:8px 16px;justify-content:center;margin-top:.9rem}
.gf-legend span{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:600;color:rgba(226,232,240,.8)}
.gf-legend i{width:11px;height:11px;border-radius:0;display:inline-block}
/* stage cards */
.gf-stages{display:flex;flex-direction:column;gap:13px}
.gf-stage{position:relative;background:var(--bg2);border:1px solid var(--br);border-left:4px solid var(--c);border-radius:0;padding:1.15rem 1.25rem 1.3rem;box-shadow:var(--sh)}
.gf-stage-head{display:flex;align-items:flex-start;gap:13px;flex-wrap:wrap}
.gf-stage-ico{width:42px;height:42px;flex-shrink:0;border-radius:0;background:var(--cl);border:1px solid var(--cb);display:flex;align-items:center;justify-content:center;font-size:21px}
.gf-stage-tag{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--c)}
.gf-stage-title{font-size:18px;font-weight:700;color:var(--t1);letter-spacing:-.02em;line-height:1.2;margin-top:1px}
.gf-mind{margin-left:auto;align-self:center;display:inline-flex;align-items:center;gap:7px;background:var(--cl);border:1px solid var(--cb);color:var(--c);font-size:11.5px;font-weight:600;padding:6px 12px;border-radius:0;white-space:nowrap}
.gf-body{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:1rem}
.gf-block-label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--t4);margin-bottom:7px}
.gf-chips{display:flex;flex-wrap:wrap;gap:6px}
.gf-chip{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:var(--t2);background:var(--bg3);border:1px solid var(--br);border-radius:0;padding:5px 10px}
.gf-chip.p{background:var(--cl);border-color:var(--cb);color:var(--c)}
.gf-goal{font-size:12.7px;color:var(--t2);line-height:1.6}
.gf-goal b{color:var(--t1)}
.gf-rule{grid-column:1/-1;display:flex;gap:10px;align-items:flex-start;background:var(--cl);border:1px dashed var(--cb);border-radius:0;padding:10px 13px}
.gf-rule-ic{font-size:15px;line-height:1.4;flex-shrink:0}
.gf-rule-tx{font-size:12.3px;color:var(--t2);line-height:1.58}
.gf-rule-tx b{color:var(--c)}
.gf-exit{grid-column:1/-1;display:flex;align-items:center;gap:9px;font-size:12px;font-weight:600;color:var(--t3);flex-wrap:wrap}
.gf-exit .ar{color:var(--c);font-weight:700}
.gf-exit em{font-style:normal;color:var(--t1)}
.gf-conn{display:flex;justify-content:center;color:var(--t4);font-size:17px;line-height:1;margin:-3px 0}
/* CRM / retention loop */
.gf-crm{margin-top:0;background:linear-gradient(160deg,#1B1036,#120A26 60%,#0E0820);border:1px solid rgba(196,181,253,.28);border-radius:0;padding:1.35rem 1.25rem 1.45rem;color:#E9E5F7}
.gf-crm-title{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:700;color:#fff;letter-spacing:-.01em;flex-wrap:wrap}
.gf-crm-title .t{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#C4B5FD;background:rgba(196,181,253,.14);border:1px solid rgba(196,181,253,.3);padding:3px 9px;border-radius:0}
.gf-crm-sub{font-size:12.3px;color:rgba(233,229,247,.74);line-height:1.65;margin:.55rem 0 1.05rem;max-width:780px}
.gf-ws-label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(196,181,253,.82);margin-bottom:8px}
.gf-crm-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}
.gf-ws{background:rgba(255,255,255,.05);border:1px solid rgba(196,181,253,.22);border-radius:0;padding:11px 11px 12px}
.gf-ws-n{font-size:10px;font-weight:700;color:#C4B5FD;letter-spacing:.05em}
.gf-ws-t{font-size:11.7px;font-weight:600;color:#fff;margin-top:3px;line-height:1.35}
.gf-crm-row{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-top:1.05rem}
.gf-crm-row .lbl{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(196,181,253,.82);width:100%;margin-bottom:1px}
.gf-pill{font-size:11.5px;font-weight:600;color:#E9E5F7;background:rgba(255,255,255,.06);border:1px solid rgba(196,181,253,.22);border-radius:0;padding:5px 11px}
.gf-ar{color:rgba(196,181,253,.55);font-weight:700;font-size:13px}
.gf-seg{margin-top:1.05rem;display:flex;gap:10px;align-items:flex-start;background:rgba(196,181,253,.08);border:1px dashed rgba(196,181,253,.34);border-radius:0;padding:10px 13px}
.gf-seg .ic{font-size:15px;flex-shrink:0}
.gf-seg .tx{font-size:12px;color:rgba(233,229,247,.86);line-height:1.6}
.gf-seg .tx b{color:#fff}
/* production pipeline */
.gf-pipe{margin-top:1.5rem}
.gf-pipe-title{font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--t4);margin-bottom:9px}
.gf-pipe-row{display:flex;align-items:stretch;gap:0}
.gf-pstep{flex:1;background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:11px 13px}
.gf-pstep .n{font-size:10px;font-weight:700;color:var(--t4);letter-spacing:.1em}
.gf-pstep .t{font-size:12.5px;font-weight:700;color:var(--t1);margin-top:2px;letter-spacing:-.01em}
.gf-pstep .d{font-size:11px;color:var(--t3);margin-top:2px;line-height:1.5}
.gf-pstep-ar{display:flex;align-items:center;color:var(--t4);font-size:16px;font-weight:700;padding:0 7px;flex-shrink:0}
.gf-pstep.done{border-color:var(--gb);background:var(--gl)}
.gf-pstep.done .t{color:var(--green)}
@media (max-width:780px){
  .gf-body{grid-template-columns:1fr}
  .gf-mind{margin-left:0;width:100%;justify-content:center;order:3;margin-top:9px;white-space:normal;text-align:center}
  .gf-crm-grid{grid-template-columns:1fr 1fr}
  .gf-pipe-row{flex-direction:column;gap:8px}
  .gf-pstep-ar{transform:rotate(90deg);padding:3px 0;justify-content:center}
}
@media (max-width:460px){.gf-crm-grid{grid-template-columns:1fr}.gf-stage-title{font-size:16px}}
@media (prefers-reduced-motion:no-preference){
  .gf-stages .gf-stage{opacity:0;transform:translateY(14px);animation:gfIn .55s cubic-bezier(.22,.61,.36,1) forwards}
  .gf-stages .gf-stage:nth-of-type(2){animation-delay:.06s}
  .gf-stages .gf-stage:nth-of-type(4){animation-delay:.12s}
  .gf-stages .gf-stage:nth-of-type(6){animation-delay:.18s}
  .gf-stages .gf-stage:nth-of-type(8){animation-delay:.24s}
}
@keyframes gfIn{to{opacity:1;transform:none}}

/* interactive funnel explorer */
.gf-explorer{margin-top:.2rem}
.gf-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:13px}
.gf-tab{display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:0;border:1.5px solid var(--br);background:var(--bg2);cursor:pointer;text-align:left;font-family:inherit;transition:border-color .2s,background .2s,box-shadow .2s}
.gf-tab:hover{border-color:var(--cb);background:var(--cl)}
.gf-tab-dot{width:32px;height:32px;border-radius:0;flex-shrink:0;background:var(--cl);border:1px solid var(--cb);display:flex;align-items:center;justify-content:center;font-size:15px}
.gf-tab .num{font-size:10px;font-weight:700;color:var(--t4);letter-spacing:.1em;display:block}
.gf-tab .nm{font-size:13px;font-weight:700;color:var(--t1);letter-spacing:-.01em;line-height:1.15}
.gf-tab[aria-selected="true"]{border-color:var(--c);background:var(--cl);box-shadow:0 7px 16px -7px var(--c)}
.gf-tab[aria-selected="true"] .num{color:var(--c)}
.gf-panel{display:none}
.gf-panel.active{display:block}
.gf-panel.active>.gf-pcard>*{animation:gfRise .5s cubic-bezier(.22,.61,.36,1) both}
.gf-panel.active>.gf-pcard>.gf-pthink{animation-delay:.05s}
.gf-panel.active>.gf-pcard>.gf-pblocks{animation-delay:.11s}
.gf-panel.active>.gf-pcard>.gf-prule{animation-delay:.18s}
.gf-panel.active>.gf-pcard>.gf-pgoal{animation-delay:.25s}
.gf-panel.active>.gf-pcard>.gf-foot{animation-delay:.32s}
@keyframes gfRise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes gfFade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.gf-pcard{background:transparent;border:none;border-radius:0;padding:0;box-shadow:none}
.gf-pthink{font-size:12.7px;color:var(--t2);line-height:1.65;background:var(--cl);border-left:3px solid var(--c);border-radius:0;padding:9px 13px;margin:2px 0 1.1rem}
.gf-pthink b{color:var(--t1)}
.gf-pgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px 20px}
.gf-kpi{margin-top:13px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--bg3);border:1px dashed var(--br);border-radius:0;padding:9px 13px}
.gf-kpi .lbl{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t4)}
.gf-kpi .m{font-size:11.5px;font-weight:600;color:var(--t2);background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:4px 10px}
.gf-recap-hint{text-align:center;font-size:11px;color:rgba(226,232,240,.6);margin-top:.4rem}
.gf-viz [data-band]{cursor:pointer;transition:opacity .18s}
.gf-viz [data-band]:hover{opacity:.85}
@media(max-width:780px){.gf-tabs{grid-template-columns:1fr 1fr}.gf-pgrid{grid-template-columns:1fr}}
@media(max-width:430px){.gf-tabs{grid-template-columns:1fr}}
/* ── Funnel explorer: ONE unified light panel (funnel + detail share a surface) ── */
.gf-explorer-split{display:grid;grid-template-columns:300px 1fr;gap:0;align-items:stretch;background:linear-gradient(180deg,#FFFFFF,#FAFBFE);border:1px solid var(--br);border-radius:0;box-shadow:0 20px 54px -22px rgba(15,23,42,.24),0 2px 8px rgba(15,23,42,.05);overflow:hidden;margin-top:.4rem}
.gf-rail{position:relative;overflow:hidden;background:linear-gradient(180deg,#F6F8FD,#EDF1FB);border-right:1px solid var(--br);padding:1.7rem 1.2rem;display:flex;flex-direction:column;justify-content:center}
.fn3-glow{position:absolute;left:50%;top:46%;width:330px;height:330px;transform:translate(-50%,-50%);border-radius:0;background:#2563EB;opacity:.1;filter:blur(64px);transition:background .4s ease,opacity .4s ease;pointer-events:none}
.fn3{position:relative;z-index:1;animation:fn3In .6s cubic-bezier(.22,.61,.36,1) both}
@keyframes fn3In{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.gf-detail{min-width:0;padding:1.5rem 1.55rem 1.55rem}
.gf-detail .gf-tabs{display:none}
@media(max-width:880px){
  .gf-explorer-split{grid-template-columns:1fr;border-radius:0}
  .gf-rail{display:none}
  .gf-detail{padding:1.2rem 1.1rem}
  .gf-detail .gf-tabs{display:grid}
}
/* ── True funnel: angled sides flow into one continuous inverted triangle ── */
.fn3-title{text-align:center;color:var(--t3);font-size:10.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin-bottom:1rem}
.fn3-stack{position:relative;width:100%}
.fn3-seg{position:relative;width:100%;height:82px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border:none;cursor:pointer;color:#fff;font-family:inherit;transition:opacity .28s,filter .28s}
.fn3-seg::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.24),rgba(255,255,255,0) 52%);pointer-events:none}
.fn3-seg[data-band="tofu"]{background:linear-gradient(135deg,#FB7185,#E11D48);clip-path:polygon(2% 0,98% 0,89% 100%,11% 100%)}
.fn3-seg[data-band="mofu"]{background:linear-gradient(135deg,#60A5FA,#2563EB);clip-path:polygon(11% 0,89% 0,80% 100%,20% 100%)}
.fn3-seg[data-band="bofu"]{background:linear-gradient(135deg,#FBBF24,#D97706);clip-path:polygon(20% 0,80% 0,72% 100%,28% 100%)}
.fn3-seg[data-band="ret"]{background:linear-gradient(135deg,#A78BFA,#7C3AED);clip-path:polygon(28% 0,72% 0,68% 100%,32% 100%)}
.fn3-seg:not(.on){opacity:.46}
.fn3-seg:hover{opacity:.78}
.fn3-seg.on{opacity:1;filter:drop-shadow(0 7px 14px rgba(15,23,42,.32)) brightness(1.05)}
.fn3-l{font-size:14.5px;font-weight:700;letter-spacing:.03em;line-height:1.05;text-shadow:0 1px 2px rgba(0,0,0,.18)}
.fn3-s{font-size:10px;font-weight:600;color:rgba(255,255,255,.92);margin-top:3px;letter-spacing:.12em;text-transform:uppercase}
/* connector: a colored arrow that glides to the selected stage and points into the detail */
.fn3-link{position:absolute;right:-13px;top:36px;width:0;height:0;border-top:9px solid transparent;border-bottom:9px solid transparent;border-left:13px solid currentColor;transform:translateY(-50%);transition:top .38s cubic-bezier(.34,1.2,.4,1),border-left-color .25s;pointer-events:none;z-index:6;color:#E11D48;filter:drop-shadow(0 2px 5px rgba(15,23,42,.3))}
.fn3-loop{display:flex;gap:9px;align-items:flex-start;margin-top:20px;font-size:10.5px;color:var(--t3);background:rgba(124,58,237,.06);border:1px dashed rgba(124,58,237,.3);border-radius:0;padding:9px 11px;line-height:1.5}
.fn3-loop-ic{font-size:13px;flex-shrink:0;color:var(--purple);font-weight:700}
.fn3-legend{display:grid;grid-template-columns:1fr 1fr;gap:7px 10px;margin-top:15px}
.fn3-legend span{display:inline-flex;align-items:center;gap:7px;font-size:10.5px;font-weight:600;color:var(--t3)}
.fn3-legend i{width:10px;height:10px;border-radius:0;flex-shrink:0}
.fn3-hint{text-align:center;font-size:10px;color:var(--t4);margin-top:14px}
@media(max-width:880px){.fn3-link{display:none}}
/* ── Systematic detail panel: same anatomy for every stage ── */
.gf-pblocks{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:1rem;align-items:start}
.gf-pb{background:linear-gradient(180deg,#FFFFFF,var(--bg3));border:1px solid var(--br);border-radius:0;padding:13px 14px 14px;box-shadow:0 1px 3px rgba(15,23,42,.04)}
.gf-pb-h{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.gf-pb-n{width:20px;height:20px;border-radius:0;background:var(--c);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.gf-pb-t{font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--c)}
.gf-sub{font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--t4);margin:11px 0 6px}
.gf-pb .gf-sub:first-of-type{margin-top:0}
.gf-prule{display:flex;gap:11px;align-items:flex-start;margin-top:12px;background:var(--cl);border:1px dashed var(--cb);border-radius:0;padding:11px 14px}
.gf-prule .gf-pb-n{background:var(--c)}
.gf-prule-tx{font-size:12.3px;color:var(--t2);line-height:1.58}
.gf-prule-tx b{color:var(--c)}
.gf-pgoal{display:flex;gap:11px;align-items:flex-start;margin-top:12px;background:linear-gradient(120deg,var(--cl),transparent);border:1px solid var(--cb);border-radius:0;padding:12px 14px}
.gf-pgoal .gf-pb-n{background:var(--c)}
.gf-pgoal-tx{font-size:12.7px;color:var(--t2);line-height:1.6}
.gf-pgoal-tx b{color:var(--t1)}
.gf-foot{display:grid;grid-template-columns:1.05fr 1fr;gap:12px;margin-top:12px}
.gf-foot-box{background:var(--bg2);border:1px solid var(--br);border-radius:0;padding:11px 13px}
.gf-foot-l{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t4);margin-bottom:8px}
.gf-foot-m{display:flex;flex-wrap:wrap;gap:6px}
.gf-foot-m span{font-size:11px;font-weight:600;color:var(--t2);background:var(--bg3);border:1px solid var(--br);border-radius:0;padding:3px 9px}
.gf-foot-exit{font-size:12px;font-weight:600;color:var(--t2);line-height:1.5}
.gf-foot-exit b{color:var(--c);font-weight:700;display:block;font-size:10px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:3px}
@media(max-width:620px){.gf-pblocks,.gf-foot{grid-template-columns:1fr}}



/* ── FAQ ── */
.bm-faq-wrap {
  position: relative; overflow: hidden;
  background: linear-gradient(140deg, #0F172A 0%, #1E1B4B 60%, #0F1624 100%);
  border-radius:0; padding: 3rem 2.5rem 3.5rem; margin-top: 3rem;
}
.bm-faq-wrap::before {
  content:""; position:absolute; top:-90px; right:-60px; width:340px; height:340px;
  border-radius:0; background:radial-gradient(circle,rgba(99,102,241,.22) 0%,transparent 70%);
  pointer-events:none; z-index:0;
}
.bm-faq-wrap::after {
  content:""; position:absolute; bottom:-70px; left:-50px; width:280px; height:280px;
  border-radius:0; background:radial-gradient(circle,rgba(139,92,246,.16) 0%,transparent 70%);
  pointer-events:none; z-index:0;
}
.bm-faq-wrap .bm-eyebrow { color:rgba(255,255,255,.5); position:relative; z-index:1; }
.bm-faq-wrap .bm-eyebrow::before { display:none; }
.bm-faq-icon-hero { width:62px; height:62px; margin-bottom:1.4rem; position:relative; z-index:1; }
.bm-faq-icon-hero svg { width:62px; height:62px; display:block; }
.bm-faq-wrap .bm-section-title { color:#fff; position:relative; z-index:1; }
.bm-faq-wrap .bm-section-sub { color:rgba(255,255,255,.58); position:relative; z-index:1; }
.bm-faq-cols { display:flex; flex-direction:column; gap:10px; margin-top:2rem; position:relative; z-index:1; }
@media(max-width: 768px) {
  .bm-faq-cols { grid-template-columns: 1fr; }
  .bm-comp-hcell.bm-hcell-free,
  .bm-comp-cell:last-child { display: none; }
  .bm-comp-grid,
  .bm-comp-headers { grid-template-columns: 1.6fr 1fr 1fr; }
  .bm-comp-row { grid-template-columns: 1.6fr 1fr 1fr; }
  .bm-section-title { font-size: 24px; }
}
.bm-faq-card {
  background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1);
  border-radius:0; cursor:pointer; overflow:hidden;
  transition:background .2s ease, border-color .25s ease, box-shadow .3s ease;
}
.bm-faq-card:hover { background:rgba(255,255,255,.09); border-color:rgba(255,255,255,.2); }
.bm-faq-card.open { background:rgba(255,255,255,.09); border-color:rgba(99,102,241,.55); box-shadow:0 0 0 1px rgba(99,102,241,.2), 0 16px 40px rgba(0,0,0,.28); }
.bm-faq-head { display:flex; align-items:center; gap:14px; padding:18px 20px; font-size:14px; font-weight:600; color:#fff; line-height:1.4; user-select:none; }
.faq-emoji { font-size:18px; flex-shrink:0; }
.bm-faq-head > span:not(.faq-emoji) { flex:1; }
.bm-faq-icon {
  width:30px; height:30px; border-radius:0; flex-shrink:0;
  background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2);
  display:flex; align-items:center; justify-content:center;
  transition:transform .4s cubic-bezier(.34,1.2,.64,1), background .3s ease, border-color .3s ease;
}
.bm-faq-icon svg { width:14px; height:14px; stroke:rgba(255,255,255,.8); transition:stroke .3s ease; }
.bm-faq-card.open .bm-faq-icon { transform:rotate(45deg); background:linear-gradient(135deg,#6366F1,#8B5CF6); border-color:transparent; }
.bm-faq-card.open .bm-faq-icon svg { stroke:#fff; }
/* smooth height via CSS grid trick */
.bm-faq-body { display:grid; grid-template-rows:0fr; overflow:hidden; transition:grid-template-rows .45s cubic-bezier(.4,0,.2,1); }
.bm-faq-card.open .bm-faq-body { grid-template-rows:1fr; }
.bm-faq-body-inner { min-height:0; overflow:hidden; }
