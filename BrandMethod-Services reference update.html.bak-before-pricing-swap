<script id="slick-polish-js">
(function(){
  // progress bar
  var bar = document.getElementById('bm-progress');
  // scroll-spy setup: map each section to its accent colour
  var sections = [];
  for (var i = 1; i <= 13; i++) {
    var el = document.getElementById('svc-' + i);
    if (!el) continue;
    var hdr = el.nextElementSibling ? el.nextElementSibling.querySelector('.svc-header.svcc') : null;
    var accent = hdr ? getComputedStyle(hdr).getPropertyValue('--sa').trim() : '#2563EB';
    var pill = document.querySelector('.bm-mpill[onclick*="svc-' + i + '\'"]');
    sections.push({el: el, pill: pill, accent: accent});
  }
  var activePill = null, ticking = false;
  function update(){
    ticking = false;
    var doc = document.documentElement;
    var max = doc.scrollHeight - window.innerHeight;
    bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
    // current section = last divider above the 1/3 viewport line
    var line = window.scrollY + window.innerHeight * 0.33;
    var current = null;
    for (var i = 0; i < sections.length; i++) {
      var top = sections[i].el.getBoundingClientRect().top + window.scrollY;
      if (top <= line) current = sections[i]; else break;
    }
    var pill = current ? current.pill : null;
    if (pill !== activePill) {
      if (activePill) activePill.classList.remove('active');
      activePill = pill;
      if (pill) {
        pill.classList.add('active');
        pill.style.setProperty('--ap', current.accent);
        // keep active pill in view inside the row (desktop only)
        if (window.innerWidth > 860) {
          var row = document.getElementById('bm-menubar-row');
          var target = pill.offsetLeft - row.clientWidth * 0.35;
