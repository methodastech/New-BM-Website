/* ══ WHO WE SERVE: audience personas (added) ══ */
@keyframes audReveal{0%{opacity:0;transform:translateY(26px) scale(.97)}100%{opacity:1;transform:translateY(0) scale(1)}}
@keyframes audOrb{0%,100%{transform:translate(0,0) scale(1);opacity:.45}50%{transform:translate(16px,-18px) scale(1.18);opacity:.8}}
@keyframes audIcon{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-5px) rotate(-4deg)}}
@keyframes audPulse{0%{box-shadow:0 0 0 0 rgba(37,99,235,.55)}70%{box-shadow:0 0 0 8px rgba(37,99,235,0)}100%{box-shadow:0 0 0 0 rgba(37,99,235,0)}}
@keyframes audShine{0%{background-position:-150% 0}60%,100%{background-position:250% 0}}

/* intro badge echoing the public site */
.aud-badge{display:inline-flex;align-items:center;gap:7px;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--blue);background:var(--bl);border:1px solid var(--bb);padding:5px 13px;border-radius:0;margin-bottom:14px}
.aud-badge::before{content:'';width:6px;height:6px;border-radius:0;background:var(--blue);animation:bmBlink 2s ease-in-out infinite}

.aud-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:1.4rem}
@media(max-width:880px){.aud-grid{grid-template-columns:1fr}}

.aud-card{position:relative;background:var(--bg2);border:1.5px solid var(--br);border-radius:0;padding:1.4rem 1.4rem 1.5rem;overflow:hidden;box-shadow:var(--sh);display:flex;flex-direction:column;opacity:0;animation:audReveal .7s cubic-bezier(.22,.61,.36,1) forwards;transition:transform .32s cubic-bezier(.22,.61,.36,1),box-shadow .32s ease,border-color .32s ease}
.aud-card:nth-child(1){animation-delay:.05s}
.aud-card:nth-child(2){animation-delay:.17s}
.aud-card:nth-child(3){animation-delay:.29s}
.aud-card:hover{transform:translateY(-7px);box-shadow:var(--sh3)}
.aud-card.g:hover{border-color:var(--gb)}
.aud-card.b:hover{border-color:var(--bb)}
.aud-card.p:hover{border-color:var(--pb)}
.aud-card>*{position:relative;z-index:1}
.aud-orb{position:absolute;top:-70px;right:-55px;width:210px;height:210px;border-radius:0;filter:blur(48px);pointer-events:none;z-index:0;animation:audOrb 9s ease-in-out infinite}
.aud-card.g .aud-orb{background:radial-gradient(circle,rgba(16,185,129,.42),transparent 65%)}
.aud-card.b .aud-orb{background:radial-gradient(circle,rgba(37,99,235,.4),transparent 65%);animation-delay:-3s}
.aud-card.p .aud-orb{background:radial-gradient(circle,rgba(124,58,237,.42),transparent 65%);animation-delay:-6s}
.aud-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;z-index:2;transition:box-shadow .32s ease}
.aud-card.g::before{background:linear-gradient(90deg,#10B981,#34D399)}
.aud-card.b::before{background:linear-gradient(90deg,#2563EB,#60A5FA)}
.aud-card.p::before{background:linear-gradient(90deg,#7C3AED,#A78BFA)}
.aud-card.g:hover::before{box-shadow:0 0 18px rgba(16,185,129,.65)}
.aud-card.b:hover::before{box-shadow:0 0 18px rgba(37,99,235,.65)}
.aud-card.p:hover::before{box-shadow:0 0 18px rgba(124,58,237,.65)}

.aud-ico{width:58px;height:58px;border-radius:0;display:flex;align-items:center;justify-content:center;margin-bottom:14px;overflow:hidden;border:none;box-shadow:0 5px 14px rgba(15,23,42,.16),0 0 0 3px var(--bg2),0 0 0 4px var(--br);transition:transform .3s}
.aud-ico svg{width:100%;height:100%;display:block}
.aud-card.g .aud-ico{background:var(--gl);border-color:var(--gb)}
.aud-card.b .aud-ico{background:var(--bl);border-color:var(--bb)}
.aud-card.p .aud-ico{background:var(--pl);border-color:var(--pb)}
.aud-card:hover .aud-ico{animation:audIcon 1.7s ease-in-out infinite}

.aud-eyebrow{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-bottom:7px}
.aud-card.g .aud-eyebrow{color:var(--green)}
.aud-card.b .aud-eyebrow{color:var(--blue)}
.aud-card.p .aud-eyebrow{color:var(--purple)}
.aud-name{font-size:19px;font-weight:700;color:var(--navy);letter-spacing:-.025em;margin-bottom:8px;line-height:1.15;display:flex;align-items:center;flex-wrap:wrap;gap:7px}
.aud-who{font-size:12.5px;color:var(--t2);line-height:1.6;margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--br)}

/* labelled blocks */
.aud-block{margin-bottom:13px}
.aud-block-k{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t4);display:flex;align-items:center;gap:6px;margin-bottom:5px}
.aud-block-k .ai{font-size:12px;line-height:1}
.aud-block-v{font-size:12.5px;color:var(--t1);line-height:1.55}

/* their path → visual chip flow */
.aud-flow{display:flex;flex-wrap:wrap;align-items:center;gap:5px}
.aud-flow-step{font-size:10.5px;font-weight:600;color:var(--t2);background:var(--bg3);border:1px solid var(--br);border-radius:0;padding:3px 8px;line-height:1.3;transition:all .25s}
.aud-flow-arr{font-size:11px;font-weight:700;color:var(--t4)}
.aud-card.g .aud-flow-end{background:var(--gl);border-color:var(--gb);color:var(--green)}
.aud-card.b .aud-flow-end{background:var(--bl);border-color:var(--bb);color:var(--blue)}
.aud-card.p .aud-flow-end{background:var(--pl);border-color:var(--pb);color:var(--purple)}
.aud-card:hover .aud-flow-end{transform:scale(1.05)}

/* objection callout */
.aud-obj{position:relative;font-size:12px;line-height:1.55;color:var(--t1);border-radius:0;padding:11px 13px;margin:2px 0 14px;border:1px solid transparent}
.aud-card.g .aud-obj{background:var(--gl);border-color:var(--gb)}
.aud-card.b .aud-obj{background:var(--bl);border-color:var(--bb)}
.aud-card.p .aud-obj{background:var(--pl);border-color:var(--pb)}
.aud-obj b{display:block;color:var(--navy);font-weight:700;font-size:10px;letter-spacing:.07em;text-transform:uppercase;margin-bottom:4px}

/* becomes pill with shine */
.aud-becomes{position:relative;margin-top:auto;font-size:12.5px;font-weight:700;border-radius:0;padding:11px 13px;display:flex;align-items:center;gap:8px;line-height:1.35;overflow:hidden}
.aud-card.g .aud-becomes{background:linear-gradient(135deg,var(--gl),#fff);color:var(--green);border:1px solid var(--gb)}
.aud-card.b .aud-becomes{background:linear-gradient(135deg,var(--bl),#fff);color:var(--blue);border:1px solid var(--bb)}
.aud-card.p .aud-becomes{background:linear-gradient(135deg,var(--pl),#fff);color:var(--purple);border:1px solid var(--pb)}
.aud-becomes::after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 35%,rgba(255,255,255,.55) 50%,transparent 65%);background-size:200% 100%;animation:audShine 5s ease-in-out infinite;pointer-events:none}

.aud-icp-flag{display:inline-flex;align-items:center;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:3px 9px;border-radius:0;background:var(--blue);color:#fff;white-space:nowrap;animation:audPulse 2.6s ease-in-out infinite}

/* bottom strategy notes */
.aud-notes{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:880px){.aud-notes{grid-template-columns:1fr}}
.aud-note{position:relative;border-radius:0;padding:1.1rem 1.2rem;border:1px solid var(--br);overflow:hidden}
.aud-note.icp{background:linear-gradient(125deg,var(--navy),#1E3A8A 70%,#3730A3);background-size:160% 160%;border-color:transparent;animation:bmGradientShift 9s ease infinite}
.aud-note.icp .aud-note-title{color:#fff}
.aud-note.icp .aud-note-body{color:rgba(255,255,255,.68)}
.aud-note.icp .aud-note-body strong{color:#fff;font-weight:600}
.aud-note.warm{background:var(--al);border-color:var(--ab)}
.aud-note.warm .aud-note-title{color:var(--amber)}
.aud-note.warm .aud-note-body{color:var(--t2)}
.aud-note-title{font-size:13px;font-weight:700;letter-spacing:.01em;margin-bottom:7px;display:flex;align-items:center;gap:8px}
.aud-note-body{font-size:12px;line-height:1.65}
.aud-note-body strong{font-weight:600;color:var(--navy)}

@media(prefers-reduced-motion:reduce){
  .aud-card{opacity:1;animation:none}
  .aud-orb,.aud-becomes::after,.aud-note.icp,.aud-icp-flag,.aud-badge::before{animation:none}
  .aud-card:hover .aud-ico{animation:none}
}

