.play-num{width:32px;height:32px;border-radius:0;background:var(--blue);color:#fff;font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.play-content{display:flex;flex-direction:column;gap:4px}
.play-title{font-size:13.5px;font-weight:600;color:var(--navy);line-height:1.3}
.play-channel{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--t3);background:var(--bg3);border:1px solid var(--br);padding:2px 7px;border-radius:0;width:fit-content;margin-top:2px}
.play-desc{font-size:12.5px;color:var(--t1);line-height:1.6;margin-top:5px}
