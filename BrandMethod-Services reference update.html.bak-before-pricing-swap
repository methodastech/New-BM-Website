  left: 0; right: 0;
  height: 3px;
  border-radius:0;
  background: linear-gradient(90deg, var(--rf-start, #3B82F6), var(--rf, #3B82F6));
  transition: background .55s ease;
}
.bj2-rail-fill::before {
  top: 0;
  box-shadow: 0 0 10px color-mix(in srgb,var(--rf,#3B82F6) 70%,transparent);
}
.bj2-rail-fill::after  {
  top: 6px;
  opacity: .6;
}
