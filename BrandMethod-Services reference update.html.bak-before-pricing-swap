<section class="ebs-strip" aria-label="How we build it and who it is built for">
  <style>
    .ebs-strip{
      --ebs-navy:var(--navy,#0F172A);
      --ebs-t2:var(--t2,#334155);
      --ebs-t3:var(--t3,#475569);
      --ebs-br:var(--br,#E2E8F0);
      --ebs-bg2:var(--bg2,#fff);
      --ebs-sh:var(--sh,0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05));
      --ebs-sh2:var(--sh2,0 4px 16px rgba(0,0,0,.09),0 2px 4px rgba(0,0,0,.06));
      --ebs-teal:#0F766E;
      --ebs-teal-d:#134E4A;
      --ebs-teal-l:#F0FDFA;
      --ebs-teal-b:#5EEAD4;
      --ebs-teal-bd:#99F6E4;
      font-family:'Inter',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;
      max-width:1216px;margin:2.75rem auto 0;color:var(--ebs-t2);
    }
    .ebs-strip *{box-sizing:border-box}

    .ebs-block{margin-top:3.25rem}
    .ebs-block:first-child{margin-top:0}

    .ebs-head{max-width:680px;margin:0 auto;text-align:center}
    .ebs-eyebrow{
      display:inline-flex;align-items:center;gap:9px;
      font-family:'JetBrains Mono',ui-monospace,monospace;
      font-size:10.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
      color:var(--ebs-teal);margin-bottom:11px;
    }
    .ebs-eyebrow::before,.ebs-eyebrow::after{
      content:"";width:22px;height:1px;background:var(--ebs-teal-b);display:inline-block;
    }
    .ebs-title{
      font-family:'Fraunces',Georgia,'Times New Roman',serif;font-weight:600;
      font-size:1.65rem;line-height:1.18;letter-spacing:-.02em;
      color:var(--ebs-navy);margin:0 0 .5rem;
    }
    .ebs-title .ebs-q{color:var(--ebs-teal-d)}
    .ebs-sub{
      font-size:13.5px;line-height:1.6;color:var(--ebs-t3);margin:0 auto;max-width:560px;
    }

    /* PROCESS FLOW: 5 numbered nodes on a connector line */
    .ebs-flow{
      position:relative;margin-top:2.75rem;
      display:flex;justify-content:space-between;gap:14px;
    }
    .ebs-flow::before{
      content:"";position:absolute;left:9%;right:9%;top:26px;height:2px;border-radius:0;
      background:linear-gradient(90deg,var(--ebs-teal-b),var(--ebs-teal));opacity:.65;
    }
    .ebs-step{
      position:relative;z-index:1;flex:1 1 0;
      display:flex;flex-direction:column;align-items:center;text-align:center;
      opacity:0;transform:translateY(16px);
      animation:ebsStepIn .6s cubic-bezier(.22,1,.36,1) forwards;
    }
    .ebs-step:nth-child(1){animation-delay:.08s}
    .ebs-step:nth-child(2){animation-delay:.2s}
    .ebs-step:nth-child(3){animation-delay:.32s}
    .ebs-step:nth-child(4){animation-delay:.44s}
