# The git deployment path is public_html/, so the repo root IS the web root —
# every file here is downloadable unless blocked. These rules hide the things
# that should never have been servable.

# --- dev/server files that are not part of the public site ---
<FilesMatch "^(server\.js|package\.json|package-lock\.json|\.env.*|.*\.bak.*|CONFIG-TEMPLATE\.php)$">
  Require all denied
</FilesMatch>

# --- editor/backup leftovers anywhere in the tree ---
<FilesMatch "\.(bak|bak-[^.]*|orig|save|swp|tmp|log|jsonl)$">
  Require all denied
</FilesMatch>

# --- dotfiles and VCS metadata ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# --- the shared PHP include is not an endpoint; only its callers are ---
<Files "_config.php">
  Require all denied
</Files>

# --- payment endpoints must never be cached ---
<IfModule mod_headers.c>
  <FilesMatch "^(create-bill|callback|return)\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- the homepage lives at https://brandmethod.co/, never /index.html ---
# THE_REQUEST checks what the browser asked for, so Apache serving index.html
# for "/" internally does not trigger a redirect loop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # --- the 2 sales pages' forms (16 Nov 2026): the addresses the pages post to, handled by api/sales/lead.php ---
  RewriteRule ^api/premium-leads/?$ api/sales/lead.php?kind=premium [L,QSA]
  RewriteRule ^api/launch-brief/?$ api/sales/lead.php?kind=launch [L,QSA]
</IfModule>

# --- old outreach demo links (folder removed 16 Nov 2026) go to the current builds ---
# Prospects may still have these links; each lands on that client's site in the tech portfolio.
RedirectMatch 301 ^/outreach/demos/akk(/.*)?$ /website/akk/
RedirectMatch 301 ^/outreach/demos/avisenna-bioscan\.html$ /website/avisenna/
RedirectMatch 301 ^/outreach/demos/eskayvie(/.*)?$ /website/eskayvie/
RedirectMatch 301 ^/outreach/demos/rubex(/.*)?$ /website/rubexpay/
RedirectMatch 301 ^/outreach/demos/tenthpin\.html$ /website/tenthpin/
RedirectMatch 301 ^/outreach/demos(/.*)?$ /portfolio.html
# the same 2 demos were also under the sales page folder (removed 16 Nov 2026); demos/brand-deck.html there stays
RedirectMatch 301 ^/nobodywantsawebsite/demos/avisenna-bioscan\.html$ /website/avisenna/
RedirectMatch 301 ^/nobodywantsawebsite/demos/tenthpin\.html$ /website/tenthpin/
